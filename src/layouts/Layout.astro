---
interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  type?: 'website' | 'article';
  keywords?: string;
  canonicalUrl?: string;
  robots?: string;
  publishedTime?: string;
  modifiedTime?: string;
  breadcrumbItems?: { name: string; url: string }[];
  structuredData?: Record<string, any> | Record<string, any>[];
}

const {
  title,
  description,
  image = "/cosy_canvas_hero_coastal_pitch.jpg",
  imageAlt = "The Cosy Canvas Co. - Luxury Bell Tent Hire Scotland",
  type = "website",
  keywords = "bell tent hire scotland, glamping hire scotland, luxury camping scotland, bell tent rental edinburgh, bell tent rental glasgow, loch lomond glamping, nc500 bell tent hire, camping gear rental scotland, event bell tents scotland, wedding glamping village",
  canonicalUrl,
  robots = "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1",
  publishedTime,
  modifiedTime,
  breadcrumbItems,
  structuredData,
} = Astro.props;

import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';
import { DEPOT, depotWhat3Words } from '../lib/depot';
import { COMPANY } from '../lib/company';
import { cosyConciergeMailto } from '../lib/campsites';

const conciergeMailto = cosyConciergeMailto('Quality Guarantee');

const siteUrl = Astro.site ? Astro.site.origin : "https://cosycanvasco.com";
const pathCanonical = `${siteUrl}${Astro.url.pathname === "/" ? "/" : Astro.url.pathname.replace(/\/$/, "")}`;
const fullImageUrl = image.startsWith("http") ? image : `${siteUrl}${image.startsWith("/") ? "" : "/"}${image}`;
const cleanCanonical = (canonicalUrl || pathCanonical).split("?")[0];

// Default Organization & LocalBusiness JSON-LD Schema
const defaultLocalBusinessSchema = {
  "@context": "https://schema.org",
  "@type": ["LocalBusiness", "Campground", "TravelAgency"],
  "name": "The Cosy Canvas Co.",
  "alternateName": "The Cosy Canvas Company",
  "url": siteUrl,
  "logo": `${siteUrl}/TCCC%20Horizontal%20Logo.png`,
  "image": fullImageUrl,
  "description": "Hassle-free luxury bell tent hire, glamping setups, and camping gear rental delivered and pitched across Scotland.",
  "telephone": COMPANY.phone,
  "email": "hello@cosycanvasco.com",
  "priceRange": "££",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": DEPOT.label,
    "addressLocality": DEPOT.locality,
    "addressRegion": DEPOT.region,
    "postalCode": "FK1",
    "addressCountry": "GB"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": DEPOT.latitude,
    "longitude": DEPOT.longitude
  },
  "openingHoursSpecification": {
    "@type": "OpeningHoursSpecification",
    "dayOfWeek": [
      "Monday",
      "Tuesday",
      "Wednesday",
      "Thursday",
      "Friday",
      "Saturday",
      "Sunday"
    ],
    "opens": DEPOT.opens,
    "closes": DEPOT.closes
  },
  "areaServed": [
    { "@type": "AdministrativeArea", "name": "Scotland" },
    { "@type": "Place", "name": "Loch Lomond and The Trossachs National Park" },
    { "@type": "Place", "name": "Cairngorms National Park" },
    { "@type": "AdministrativeArea", "name": "Stirlingshire" },
    { "@type": "AdministrativeArea", "name": "East Lothian" },
    { "@type": "AdministrativeArea", "name": "Fife" },
    { "@type": "AdministrativeArea", "name": "Perthshire" },
    { "@type": "AdministrativeArea", "name": "Scottish Highlands" },
    { "@type": "Place", "name": "North Coast 500" }
  ],
  "sameAs": [
    "https://www.facebook.com/profile.php?id=61574022630011",
    "https://www.instagram.com/thecosycanvasco",
    "https://www.tiktok.com/@thecosycanvasco"
  ],
  "currenciesAccepted": "GBP",
  "paymentAccepted": "Credit Card, Apple Pay, Google Pay, Stripe, Debit Card"
};

// BreadcrumbList Schema
const crumbTrail = breadcrumbItems ?? [
  { name: "Home", url: siteUrl },
  ...(Astro.url.pathname !== "/"
    ? [{ name: title.split("|")[0].trim(), url: cleanCanonical }]
    : []),
];

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": crumbTrail.map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": item.name,
    "item": item.url
  }))
};
---

<!DOCTYPE html>
<html lang="en-GB" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  
  <!-- Primary Meta Tags -->
  <title>{title}</title>
  <meta name="title" content={title} />
  <meta name="description" content={description} />
  <meta name="keywords" content={keywords} />
  <meta name="author" content="The Cosy Canvas Co." />
  <link rel="canonical" href={cleanCanonical} />
  {Astro.url.pathname.startsWith('/journal') && (
    <link rel="alternate" type="application/rss+xml" title="The Cosy Journal RSS" href={`${siteUrl}/journal/rss.xml`} />
  )}
  <meta name="robots" content={robots} />

  <!-- Google Search Console Site Verification -->
  <meta name="google-site-verification" content="H0sYGrnXG4TZuZjwpMr9uy-2JWKcXEP-qdxE3MzIUJc" />

  <!-- Local Scotland & UK SEO Geo-Tags -->
  <meta name="geo.region" content="GB-STG" />
  <meta name="geo.placename" content="Falkirk, Stirlingshire, Scotland" />
  <meta name="geo.position" content={`${DEPOT.latitude};${DEPOT.longitude}`} />
  <meta name="ICBM" content={`${DEPOT.latitude}, ${DEPOT.longitude}`} />

  <!-- Open Graph / Facebook / WhatsApp / iMessage -->
  <meta property="og:type" content={type} />
  <meta property="og:url" content={cleanCanonical} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={fullImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta property="og:site_name" content="The Cosy Canvas Co." />
  <meta property="og:locale" content="en_GB" />
  {type === "article" && publishedTime && (
    <meta property="article:published_time" content={publishedTime} />
  )}
  {type === "article" && modifiedTime && (
    <meta property="article:modified_time" content={modifiedTime} />
  )}
  {type === "article" && (
    <meta property="article:publisher" content="The Cosy Canvas Co." />
  )}

  <!-- Twitter / X Cards -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={cleanCanonical} />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={fullImageUrl} />
  <meta name="twitter:site" content="@thecosycanvasco" />
  <meta name="twitter:creator" content="@thecosycanvasco" />

  <!-- Favicon -->
  <link rel="icon" type="image/png" href="/favicon.png" />
  <link rel="apple-touch-icon" href="/favicon.png" />

  <!-- JSON-LD Structured Data for Google Rich Snippets -->
  <script type="application/ld+json" set:html={JSON.stringify(defaultLocalBusinessSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />
  {structuredData && (
    <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  )}

  <!-- Google Fonts & FontAwesome Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@700;800;900&family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body class="bg-[#FDFBF7] text-[#111111] font-sans antialiased flex flex-col min-h-screen relative">

  <!-- Fixed Contour Lines Background Layer -->
  <div 
    class="fixed inset-0 pointer-events-none z-0 opacity-25"
    style="background-image: url('/cosy_canvas_contour_bg.png'); background-size: 750px 750px; background-repeat: repeat;"
  ></div>

  <!-- Content Layer (z-10 Keeps Everything Above Background) -->
  <div class="relative z-10 flex flex-col min-h-screen">

    <!-- Seasonal Promotional Banner -->
    <div class="bg-[#7D6E23] text-white text-xs md:text-sm py-2.5 px-4 text-center font-medium flex items-center justify-center gap-2">
      <span class="inline-block w-2 h-2 rounded-full bg-[#F7BA1E] animate-pulse"></span>
      <span>2026/2027 Scottish Camping Season • 🌿 15% Early Bird Offer for 2027 (Book by 31 Oct 2026) • 4M, 5M & 6M Tents from £50/n</span>
      <a href="/booking" class="underline font-semibold hover:text-[#F7BA1E] ml-2 hidden md:inline">Begin your booking &rarr;</a>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-40 bg-white/90 backdrop-blur-md border-b border-stone-200/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20 gap-3">
          <a href="/" class="flex items-center min-w-0 shrink" aria-label="The Cosy Canvas Co. Homepage">
            <img src="/TCCC Horizontal Logo.png" alt="The Cosy Canvas Co. - Luxury Bell Tent Hire Scotland" class="h-9 sm:h-10 md:h-12 w-auto max-w-[42vw] object-contain" onerror="this.src='https://placehold.co/200x60/FAF7EE/7D6E23?text=The+Cosy+Canvas+Co.'">
          </a>
          <nav class="hidden lg:flex items-center space-x-7 text-sm font-medium text-stone-700" aria-label="Main Navigation">
            <a href="/camping-hire" class="hover:text-[#7D6E23] transition-colors">Camping Hire</a>
            <a href="/campsites" class="hover:text-[#7D6E23] transition-colors">Cosy Campsites</a>
            <a href="/parties" class="hover:text-[#7D6E23] transition-colors">Parties & Sleepovers</a>
            <div class="relative group">
              <a href="/events" class="inline-flex items-center gap-1.5 hover:text-[#7D6E23] transition-colors py-6">
                Events
                <i class="fa-solid fa-chevron-down text-[9px] opacity-70"></i>
              </a>
              <div class="absolute left-0 top-full hidden group-hover:block pt-0 z-50">
                <div class="w-72 rounded-2xl border border-stone-200 bg-white shadow-xl py-2 mt-0">
                  <a href="/events" class="block px-4 py-2.5 text-sm text-stone-700 hover:bg-[#FAF7EE] hover:text-[#7D6E23]">Villages &amp; weddings</a>
                  <a href="/events/rat-race" class="block px-4 py-2.5 text-sm text-stone-700 hover:bg-[#FAF7EE] hover:text-[#7D6E23]">
                    <span class="block font-semibold">Rat Race Coast to Coast</span>
                    <span class="block text-[11px] text-stone-500">Sat 11 Sep 2027 · Cosy or Deluxe</span>
                  </a>
                  <a href="/events/loch-fyne-musical-festival" class="block px-4 py-2.5 text-sm text-stone-700 hover:bg-[#FAF7EE] hover:text-[#7D6E23]">Loch Fyne Musical Festival</a>
                </div>
              </div>
            </div>
            <a href="/journal" class="hover:text-[#7D6E23] transition-colors">Journal</a>
            <a href="/faqs" class="hover:text-[#7D6E23] transition-colors">FAQs</a>
            <a href="/about" class="hover:text-[#7D6E23] transition-colors">About Us</a>
          </nav>
          <div class="flex items-center gap-2 shrink-0">
            <a href="/booking" class="bg-[#F7BA1E] hover:bg-[#D4A51E] text-[#111111] font-display font-bold text-[10px] sm:text-xs uppercase tracking-wider py-2.5 px-3.5 sm:px-6 rounded-full shadow-md transition-all flex items-center gap-1.5 sm:gap-2">
              <img src="/favicon.svg" alt="" width="18" height="18" class="h-[16px] w-[16px] sm:h-[18px] sm:w-[18px] rounded-[4px] shrink-0" /> Book Now
            </a>
            <button
              type="button"
              id="mobile-nav-toggle"
              class="lg:hidden w-11 h-11 rounded-full border border-stone-200 bg-white text-[#111111] flex items-center justify-center hover:border-[#F7BA1E] transition"
              aria-controls="mobile-nav"
              aria-expanded="false"
              aria-label="Open site menu"
            >
              <i class="fa-solid fa-bars text-base" data-icon="open"></i>
              <i class="fa-solid fa-xmark text-base hidden" data-icon="close"></i>
            </button>
          </div>
        </div>
      </div>

      <div id="mobile-nav" class="lg:hidden hidden border-t border-stone-200 bg-white max-h-[min(70dvh,calc(100dvh-5rem))] overflow-y-auto overscroll-contain">
        <nav class="max-w-7xl mx-auto px-4 sm:px-6 py-3 flex flex-col text-sm font-medium text-stone-800" aria-label="Mobile Navigation">
          <a href="/camping-hire" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">Camping Hire</a>
          <a href="/campsites" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">Cosy Campsites</a>
          <a href="/parties" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">Parties &amp; Sleepovers</a>
          <a href="/events" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">Events &amp; Weddings</a>
          <a href="/events/rat-race" class="py-3 pl-4 border-b border-stone-100 text-stone-600 hover:text-[#7D6E23]">
            <span class="block font-semibold text-stone-800">Rat Race Coast to Coast</span>
            <span class="block text-[11px] text-stone-500">Sat 11 Sep 2027 · Cosy or Deluxe</span>
          </a>
          <a href="/events/loch-fyne-musical-festival" class="py-3 pl-4 border-b border-stone-100 text-stone-600 hover:text-[#7D6E23]">Loch Fyne Musical Festival</a>
          <a href="/journal" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">Journal</a>
          <a href="/gear" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">Gear we use</a>
          <a href="/faqs" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">FAQs</a>
          <a href="/about" class="py-3.5 border-b border-stone-100 hover:text-[#7D6E23]">About Us</a>
          <a href="/booking" class="mt-3 mb-2 inline-flex items-center justify-center gap-2 rounded-full bg-[#111111] text-[#F7BA1E] font-display font-extrabold text-xs uppercase tracking-wider py-3.5">
            <i class="fa-solid fa-campground text-[11px]"></i> Begin your booking
          </a>
        </nav>
      </div>
    </header>

    <script is:inline>
      (function () {
        const toggle = document.getElementById('mobile-nav-toggle');
        const panel = document.getElementById('mobile-nav');
        if (!toggle || !panel) return;
        const openIcon = toggle.querySelector('[data-icon="open"]');
        const closeIcon = toggle.querySelector('[data-icon="close"]');
        function setOpen(open) {
          panel.classList.toggle('hidden', !open);
          toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
          toggle.setAttribute('aria-label', open ? 'Close site menu' : 'Open site menu');
          openIcon?.classList.toggle('hidden', open);
          closeIcon?.classList.toggle('hidden', !open);
          document.body.classList.toggle('overflow-hidden', open);
        }
        toggle.addEventListener('click', () => {
          setOpen(panel.classList.contains('hidden'));
        });
        panel.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => setOpen(false));
        });
        window.addEventListener('resize', () => {
          if (window.matchMedia('(min-width: 1024px)').matches) setOpen(false);
        });
      })();
    </script>

    <!-- Dynamic Content Slot -->
    <main class="flex-grow">
      <slot />
    </main>

    <!-- 4-Column Footer -->
    <footer class="bg-stone-900 text-stone-400 pt-16 pb-12 border-t border-stone-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10 pb-12 border-b border-stone-800">
          <div>
            <div class="flex items-center gap-3 mb-4">
              <img src="/TCCC Horizontal Logo.png" alt="The Cosy Canvas Co." class="h-10 w-auto object-contain bg-white/95 px-3 py-1.5 rounded-lg" onerror="this.src='https://placehold.co/180x50/FFFFFF/111111?text=Cosy+Canvas+Co.'">
            </div>
            <p class="text-xs text-stone-400 leading-relaxed mb-4">
              Done-for-you luxury bell tent hire and camping stays delivered and pitched across Scotland.
            </p>
            <div class="os-grid-badge text-[#F7BA1E] text-[11px] px-2.5 py-1 rounded inline-block bg-stone-800 border-[#F7BA1E]/40 font-mono">
              {depotWhat3Words() ? `W3W: ${depotWhat3Words()}` : DEPOT.badge}
            </div>
          </div>

          <div>
            <h4 class="font-display font-bold text-white text-xs uppercase tracking-widest mb-4">Site Pages</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/" class="hover:text-[#F7BA1E] transition-colors">Home</a></li>
              <li><a href="/camping-hire" class="hover:text-[#F7BA1E] transition-colors">Camping Hire</a></li>
              <li><a href="/campsites" class="hover:text-[#F7BA1E] transition-colors">Scottish Campsites Guide</a></li>
              <li><a href="/parties" class="hover:text-[#F7BA1E] transition-colors">Parties & Sleepovers</a></li>
              <li><a href="/events" class="hover:text-[#F7BA1E] transition-colors">Events & Weddings</a></li>
              <li><a href="/events/rat-race" class="hover:text-[#F7BA1E] transition-colors">Rat Race Coast to Coast 2027</a></li>
              <li><a href="/events/loch-fyne-musical-festival" class="hover:text-[#F7BA1E] transition-colors">Loch Fyne Musical Festival</a></li>
              <li><a href="/journal" class="hover:text-[#F7BA1E] transition-colors">The Cosy Journal</a></li>
              <li><a href="/gear" class="hover:text-[#F7BA1E] transition-colors">Gear we use</a></li>
              <li><a href="/faqs" class="hover:text-[#F7BA1E] transition-colors">FAQs & Policies</a></li>
              <li><a href="/about" class="hover:text-[#F7BA1E] transition-colors">About Us & Base</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-display font-bold text-white text-xs uppercase tracking-widest mb-4">Get In Touch</h4>
            <ul class="space-y-3 text-xs">
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-envelope text-[#F7BA1E]"></i>
                <a href="mailto:hello@cosycanvasco.com" class="hover:text-white">hello@cosycanvasco.com</a>
              </li>
              <li class="flex items-center gap-2">
                <i class="fa-solid fa-location-dot text-[#7D6E23]"></i>
                <span>Falkirk container · {DEPOT.hoursShort}</span>
              </li>
              <li class="flex items-center gap-2 pt-2">
                <a href="https://www.facebook.com/profile.php?id=61574022630011" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-stone-800 hover:bg-[#F7BA1E] hover:text-[#111111] flex items-center justify-center transition" aria-label="Facebook">
                  <i class="fa-brands fa-facebook-f text-xs"></i>
                </a>
                <a href="https://www.instagram.com/thecosycanvasco" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-stone-800 hover:bg-[#F7BA1E] hover:text-[#111111] flex items-center justify-center transition" aria-label="Instagram">
                  <i class="fa-brands fa-instagram text-xs"></i>
                </a>
                <a href="https://www.tiktok.com/@thecosycanvasco" target="_blank" rel="noopener noreferrer" class="w-8 h-8 rounded-full bg-stone-800 hover:bg-[#F7BA1E] hover:text-[#111111] flex items-center justify-center transition" aria-label="TikTok">
                  <i class="fa-brands fa-tiktok text-xs"></i>
                </a>
              </li>
            </ul>
          </div>

          <div>
            <h4 class="font-display font-bold text-white text-xs uppercase tracking-widest mb-4">Quality Guarantee</h4>
            <p class="text-xs text-stone-400 leading-relaxed mb-4">
              Every stay is covered by our Fix-It-Fast Support & Full Refund Weather Guarantee.
            </p>
            <a
              href={conciergeMailto}
              class="inline-flex items-center gap-2 rounded-full bg-[#F7BA1E] hover:bg-[#D4A51E] text-[#111111] font-display font-extrabold text-[10px] uppercase tracking-wider px-4 py-2.5 transition-colors mb-4"
            >
              <i class="fa-solid fa-comments text-[10px]"></i>
              Talk to Trystan
            </a>
            <p class="text-[10px] text-stone-500 leading-snug mb-4">
              Cosy Concierge — help with bookings, stays, and our guarantee.
            </p>
            <div class="text-[11px] text-stone-500 space-x-2">
              <a href="/terms" class="hover:text-stone-300">Terms</a>
              <span>•</span>
              <a href="/privacy" class="hover:text-stone-300">Privacy</a>
              <span>•</span>
              <button type="button" class="open-cookie-settings-btn hover:text-[#F7BA1E] underline cursor-pointer">Cookie Settings</button>
            </div>
          </div>
        </div>

        <div class="pt-8 flex flex-col sm:flex-row items-center justify-between text-xs text-stone-500 gap-4">
          <div>© 2026 The Cosy Canvas Company. All rights reserved.</div>
          <div class="flex items-center gap-4">
            <a href="/sitemap-index.xml" class="hover:text-stone-400">Sitemap</a>
            <span>•</span>
            <span>Registered in Scotland</span>
          </div>
        </div>
      </div>
    </footer>

  </div>

  <!-- GDPR Cookie Consent Manager -->
  <CookieConsent />

</body>
</html>