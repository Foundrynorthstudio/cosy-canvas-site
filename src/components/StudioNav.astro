---
import { parseStudioSession, STUDIO_COOKIE } from '../lib/journal-auth';

interface Props {
  active: 'home' | 'journal' | 'bookings' | 'emails';
}
const { active } = Astro.props;
const session = parseStudioSession(Astro.cookies.get(STUDIO_COOKIE)?.value);
---

<header class="border-b border-white/10">
  <div class="max-w-6xl mx-auto px-4 py-4 flex flex-wrap items-center justify-between gap-4">
    <a href="/studio" class="font-display font-black text-sm tracking-wide">Cosy Studio</a>
    <nav class="flex items-center gap-5 text-xs uppercase tracking-wider font-bold">
      <a href="/studio/bookings" class={active === 'bookings' ? 'text-[#F7BA1E]' : 'text-stone-400 hover:text-white'}>Bookings</a>
      <a href="/studio/emails" class={active === 'emails' ? 'text-[#F7BA1E]' : 'text-stone-400 hover:text-white'}>Emails</a>
      <a href="/studio" class={active === 'journal' ? 'text-[#F7BA1E]' : 'text-stone-400 hover:text-white'}>Journal</a>
      <a href="/journal" class="text-stone-500 hover:text-white" target="_blank">View site</a>
      {session && (
        <a href="/studio/account" class="text-stone-500 hover:text-[#F7BA1E] normal-case tracking-normal font-semibold">
          {session.name}
        </a>
      )}
      <form method="POST" action="/api/studio/logout">
        <button class="text-stone-500 hover:text-white uppercase tracking-wider">Sign out</button>
      </form>
    </nav>
  </div>
</header>
