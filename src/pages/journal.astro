---
import Layout from '../layouts/Layout.astro';
import { CATEGORY_LABELS, SEED_POSTS, type JournalCategory, type JournalPost } from '../lib/journal';
import { getAllPosts } from '../lib/journal-store';

export const prerender = false;

let posts: JournalPost[] = [];
try {
  posts = await getAllPosts();
} catch (error) {
  console.error('Journal listing failed', error);
  posts = SEED_POSTS.filter((post) => post.status === 'published');
}
const featuredArticle = posts.find((article) => article.featured) || posts[0];
const regularArticles = featuredArticle
  ? posts.filter((article) => article.slug !== featuredArticle.slug)
  : posts;

const siteUrl = Astro.site ? Astro.site.origin : 'https://cosycanvas.co.uk';
const requestedCategory = Astro.url.searchParams.get('category') || 'all';

const collectionSchema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: 'The Cosy Journal',
  description:
    'Guides to Scottish campsites, bell tent weddings, garden sleepovers, and seasonal glamping from The Cosy Canvas Co.',
  url: `${siteUrl}/journal`,
  publisher: {
    '@type': 'Organization',
    name: 'The Cosy Canvas Co.',
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/TCCC%20Horizontal%20Logo.png`,
    },
  },
  blogPost: posts.slice(0, 12).map((post) => ({
    '@type': 'BlogPosting',
    headline: post.title,
    url: `${siteUrl}/journal/${post.slug}`,
    datePublished: post.isoDate,
    image: post.image.startsWith('http') ? post.image : `${siteUrl}${post.image}`,
  })),
};

const filters: { id: 'all' | JournalCategory; label: string }[] = [
  { id: 'all', label: 'All Articles' },
  { id: 'guides', label: CATEGORY_LABELS.guides },
  { id: 'weddings', label: CATEGORY_LABELS.weddings },
  { id: 'tips', label: CATEGORY_LABELS.tips },
  { id: 'seasonal', label: CATEGORY_LABELS.seasonal },
  { id: 'gear', label: CATEGORY_LABELS.gear },
];
---

<Layout
  title="The Cosy Journal | Scottish Camping, Event Guides & Stories | The Cosy Canvas Co."
  description="Explore expert guides on Scottish campsites, garden sleepovers, wedding village planning, and outdoor camping tips from The Cosy Canvas Co."
  keywords="scottish camping blog, glamping guides scotland, bell tent wedding scotland, garden sleepover ideas, nc500 camping guide"
  structuredData={collectionSchema}
  breadcrumbItems={[
    { name: 'Home', url: siteUrl },
    { name: 'The Cosy Journal', url: `${siteUrl}/journal` },
  ]}
>
  <div class="bg-[#111111] text-white py-12 md:py-20 border-b border-stone-800 relative z-30 overflow-hidden">
    <div class="absolute inset-0 opacity-30" style="background-image: url('/cosy_canvas_scotland_wilderness_banner.jpg'); background-size: cover; background-position: center;"></div>
    <div class="absolute inset-0 bg-gradient-to-r from-[#111111] via-[#111111]/90 to-[#111111]/60"></div>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative">
      <span class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest block mb-3 font-bold">
        Stories, guides & field notes
      </span>
      <h1 class="font-display text-4xl md:text-6xl font-black text-white max-w-3xl leading-tight">
        The Cosy Journal
      </h1>
      <p class="text-stone-300 text-base md:text-lg mt-4 max-w-2xl font-light leading-relaxed">
        Quiet pitch notes from Scotland: hidden campsites, wedding villages under canvas, packing lists, and the rituals that make a bell tent stay feel like home.
      </p>
    </div>
  </div>

  <section class="py-12 md:py-16 border-b border-stone-200/80 relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-wrap items-center gap-3 mb-12">
        {
          filters.map((filter) => (
            <a
              href={filter.id === 'all' ? '/journal' : `/journal?category=${filter.id}`}
              data-filter={filter.id}
              class:list={[
                'journal-filter-btn px-4 py-2.5 rounded-full text-xs transition-all',
                requestedCategory === filter.id
                  ? 'bg-[#111111] text-[#F7BA1E] font-display font-extrabold shadow-sm'
                  : 'bg-white text-stone-700 border border-stone-200 hover:bg-stone-50 font-bold shadow-xs',
              ]}
            >
              {filter.label}
            </a>
          ))
        }
      </div>

      {
        !featuredArticle ? (
          <div class="rounded-3xl border border-dashed border-stone-300 bg-white p-12 text-center">
            <p class="font-display text-xl font-bold text-[#111111]">The journal is warming up</p>
            <p class="text-stone-500 text-sm mt-2">Published stories will appear here.</p>
          </div>
        ) : (
          <>
            <article
              class="article-card mb-12 rounded-3xl overflow-hidden shadow-xl border border-stone-200 bg-white"
              data-category={featuredArticle.category}
            >
              <a href={`/journal/${featuredArticle.slug}`} class="grid md:grid-cols-12 items-stretch group">
                <div class="md:col-span-7 h-72 md:h-[28rem] relative overflow-hidden bg-stone-100">
                  <img
                    src={featuredArticle.image}
                    alt={featuredArticle.imageAlt}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    width="1200"
                    height="800"
                  />
                  <span class="absolute top-4 left-4 bg-[#111111] text-[#F7BA1E] text-[10px] font-mono font-bold px-3 py-1 rounded-full uppercase tracking-wider shadow-md">
                    Featured story
                  </span>
                </div>
                <div class="md:col-span-5 p-6 sm:p-8 md:p-10 flex flex-col justify-between bg-white">
                  <div>
                    <div class="flex flex-wrap items-center gap-3 text-xs text-stone-500 font-medium mb-3">
                      <span class="text-[#7D6E23] font-bold uppercase tracking-wider text-[11px] bg-[#7D6E23]/10 px-2.5 py-0.5 rounded-full">
                        {featuredArticle.categoryName}
                      </span>
                      <span>{featuredArticle.date}</span>
                      <span>{featuredArticle.readTime}</span>
                    </div>
                    <h2 class="font-display font-black text-2xl sm:text-3xl text-[#111111] mb-4 leading-tight group-hover:text-[#7D6E23] transition-colors">
                      {featuredArticle.title}
                    </h2>
                    <p class="text-stone-600 text-sm leading-relaxed mb-6">
                      {featuredArticle.excerpt}
                    </p>
                  </div>
                  <div class="inline-flex items-center gap-2 text-xs font-display font-extrabold uppercase tracking-wider text-[#111111]">
                    <span>Read full story</span>
                    <i class="fa-solid fa-arrow-right text-[#F7BA1E]"></i>
                  </div>
                </div>
              </a>
            </article>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {
                regularArticles.map((article) => (
                  <article
                    class="article-card rounded-2xl overflow-hidden border border-stone-200 shadow-md flex flex-col bg-white transition-all hover:shadow-xl hover:-translate-y-1"
                    data-category={article.category}
                  >
                    <a href={`/journal/${article.slug}`} class="flex flex-col h-full">
                      <div class="relative h-52 overflow-hidden bg-stone-100">
                        <img
                          src={article.image}
                          alt={article.imageAlt}
                          class="w-full h-full object-cover transition-transform duration-500 hover:scale-105"
                          width="800"
                          height="520"
                        />
                        <span class="absolute top-3 left-3 bg-white/90 backdrop-blur-sm text-[#7D6E23] text-[10px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-xs border border-stone-200">
                          {article.categoryName}
                        </span>
                      </div>
                      <div class="p-6 flex-grow">
                        <div class="flex items-center gap-2 text-[11px] text-stone-400 font-medium mb-2">
                          <time datetime={article.isoDate}>{article.date}</time>
                          <span>•</span>
                          <span>{article.readTime}</span>
                        </div>
                        <h3 class="font-display font-black text-[#111111] text-xl mb-3 leading-snug">
                          {article.title}
                        </h3>
                        <p class="text-stone-600 text-sm leading-relaxed">
                          {article.excerpt}
                        </p>
                      </div>
                      <div class="px-6 pb-6 pt-2 border-t border-stone-100 flex items-center justify-between">
                        <span class="text-[11px] font-bold text-stone-400 uppercase tracking-wider">
                          {article.author.name}
                        </span>
                        <span class="text-xs font-display font-extrabold text-[#7D6E23] flex items-center gap-1.5">
                          Read story
                          <i class="fa-solid fa-arrow-right text-[10px]" />
                        </span>
                      </div>
                    </a>
                  </article>
                ))
              }
            </div>
          </>
        )
      }
    </div>
  </section>

  <section class="py-12 bg-[#111111] text-white border-t border-stone-800 relative z-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 text-center">
      <div class="w-12 h-12 rounded-2xl bg-[#F7BA1E]/20 text-[#F7BA1E] flex items-center justify-center text-xl mx-auto mb-4">
        <i class="fa-solid fa-envelope-open-text"></i>
      </div>
      <h2 class="font-display font-black text-2xl sm:text-3xl mb-2">Subscribe to The Cosy Journal</h2>
      <p class="text-stone-400 text-sm max-w-lg mx-auto mb-6">
        Seasonal campsite notes, early-bird festival dates, and packing guides — sent quietly, never noisily.
      </p>
      <form id="newsletterForm" class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
        <input
          type="email"
          id="newsletter-email"
          placeholder="Enter your email address"
          required
          class="w-full bg-stone-900 border border-stone-700 rounded-full px-5 py-3.5 text-xs text-white placeholder-stone-500 focus:border-[#F7BA1E] focus:outline-none"
        />
        <button
          type="submit"
          class="w-full sm:w-auto shrink-0 bg-[#F7BA1E] hover:bg-[#D4A51E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3.5 rounded-full transition-all shadow-md"
        >
          Subscribe
        </button>
      </form>
    </div>
  </section>
</Layout>

<script define:vars={{ requestedCategory }}>
  document.addEventListener('DOMContentLoaded', () => {
    const articleCards = document.querySelectorAll('.article-card');
    if (requestedCategory && requestedCategory !== 'all') {
      articleCards.forEach((card) => {
        const category = card.getAttribute('data-category');
        card.style.display = category === requestedCategory ? '' : 'none';
      });
    }

    document.getElementById('newsletterForm')?.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = document.getElementById('newsletter-email')?.value;
      alert(`Thank you for subscribing! A welcome note is on its way to ${email}.`);
      e.target.reset();
    });
  });
</script>
