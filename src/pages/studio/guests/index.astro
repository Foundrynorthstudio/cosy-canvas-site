---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import StudioNav from '../../../components/StudioNav.astro';
import { buildGuestDirectory, guestProfileHref } from '../../../lib/guest-crm';
import { getAllBookings } from '../../../lib/booking-store';

const bookings = await getAllBookings();
const guests = await buildGuestDirectory(bookings);
const returning = guests.filter((guest) => guest.stayCount > 1).length;
const withBalance = guests.filter((guest) => guest.balanceDue > 0.01).length;
const tagged = guests.filter((guest) => guest.tags.length > 0).length;
---

<StudioLayout title="Guests · Cosy Studio">
  <StudioNav active="guests" />
  <div class="max-w-7xl mx-auto px-4 py-10 space-y-8">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
      <div>
        <p class="text-[#7D6E23] font-mono text-xs uppercase tracking-[0.25em]">Relationships</p>
        <h1 class="font-display text-3xl md:text-4xl font-black mt-1 text-[#111111]">Guests</h1>
        <p class="text-stone-500 text-sm mt-2 max-w-2xl">
          One place for the people behind the stays — discounts, recommendations, personal notes, and email history kept with the guest, not lost in a booking thread.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 text-[11px] uppercase tracking-wider font-bold text-stone-600">
        <span class="rounded-full bg-white/80 border border-[#7D6E23]/20 px-3 py-2">{guests.length} guests</span>
        <span class="rounded-full bg-white/80 border border-[#7D6E23]/20 px-3 py-2">{returning} returning</span>
        <span class="rounded-full bg-white/80 border border-[#7D6E23]/20 px-3 py-2">{withBalance} balance due</span>
        <span class="rounded-full bg-white/80 border border-[#7D6E23]/20 px-3 py-2">{tagged} tagged</span>
      </div>
    </div>

    <div class="studio-panel rounded-[1.75rem] p-2 sm:p-2.5 border-[#F7BA1E]/35">
      <div class="flex items-center gap-3 px-3 sm:px-4">
        <span class="w-10 h-10 rounded-2xl bg-[#F7BA1E] text-[#111111] flex items-center justify-center shrink-0">
          <i class="fa-solid fa-magnifying-glass"></i>
        </span>
        <input
          id="guest-search"
          type="search"
          autocomplete="off"
          placeholder="Search name, email, phone, tags, tents…"
          class="flex-1 min-w-0 bg-transparent border-0 py-3.5 text-base text-[#111111] placeholder:text-stone-400 focus:outline-none focus:ring-0"
        />
      </div>
    </div>

    {
      guests.length === 0 ? (
        <div class="studio-panel rounded-3xl border-dashed p-12 text-center text-stone-500">
          <p class="font-display text-xl font-black text-[#111111] mb-2">No guests yet</p>
          <p class="text-sm">Guests appear here automatically from bookings.</p>
        </div>
      ) : (
        <div id="guest-grid" class="grid md:grid-cols-2 xl:grid-cols-3 gap-4">
          {guests.map((guest) => (
            <a
              href={guestProfileHref(guest.email)}
              class="guest-card studio-panel rounded-3xl p-5 hover:border-[#F7BA1E]/50 transition-colors block"
              data-search={[guest.name, guest.email, guest.phone, guest.tags.join(' '), guest.tents.join(' ')].join(' ').toLowerCase()}
            >
              <div class="flex items-start justify-between gap-3">
                <div class="min-w-0">
                  <p class="font-display font-black text-lg text-[#111111] truncate">{guest.name}</p>
                  <p class="text-stone-500 text-xs mt-1 truncate">{guest.email}</p>
                </div>
                <span class="text-[10px] uppercase tracking-wider font-bold px-2.5 py-1 rounded-full shrink-0 bg-[#F7BA1E]/15 text-[#7D6E23]">
                  {guest.stayCount} stay{guest.stayCount === 1 ? '' : 's'}
                </span>
              </div>

              {guest.phone && <p class="text-xs text-stone-500 mt-3">{guest.phone}</p>}

              <div class="flex flex-wrap gap-1.5 mt-4">
                {guest.tents.map((tent) => (
                  <span class="rounded-full bg-[#F7BA1E]/15 border border-[#F7BA1E]/30 px-2.5 py-1 text-[10px] text-stone-700">{tent}</span>
                ))}
                {guest.tags.map((tag) => (
                  <span class="rounded-full bg-stone-100 border border-stone-200 px-2.5 py-1 text-[10px] text-stone-600">{tag}</span>
                ))}
              </div>

              <div class="flex flex-wrap items-center gap-3 mt-4 text-[11px] text-stone-500">
                {guest.nextCheckin ? (
                  <span>Next {guest.nextCheckin}</span>
                ) : guest.lastCheckin ? (
                  <span>Last {guest.lastCheckin}</span>
                ) : null}
                <span>£{guest.totalSpend.toFixed(0)} lifetime</span>
                {guest.balanceDue > 0.01 && (
                  <span class="text-amber-700 font-bold">£{guest.balanceDue.toFixed(2)} due</span>
                )}
              </div>

              <div class="flex flex-wrap gap-2 mt-3 text-[10px] uppercase tracking-wider font-bold text-stone-400">
                {guest.hasNotes && <span>Notes</span>}
                {guest.hasDiscounts && <span>Discount</span>}
                {guest.recommendationCount > 0 && <span>Recs {guest.recommendationCount}</span>}
                {guest.hasComms && <span>Comms</span>}
              </div>
            </a>
          ))}
        </div>
      )
    }
    <p id="guest-empty" class="hidden text-sm text-stone-500 py-8 text-center">No guests match that search.</p>
  </div>
</StudioLayout>

<script>
  const input = document.getElementById('guest-search');
  const grid = document.getElementById('guest-grid');
  const empty = document.getElementById('guest-empty');

  input?.addEventListener('input', () => {
    const q = String(input.value || '').toLowerCase().trim();
    const cards = Array.from(grid?.querySelectorAll('.guest-card') || []);
    let shown = 0;
    cards.forEach((card) => {
      const hay = card.getAttribute('data-search') || '';
      const on = !q || hay.includes(q);
      card.classList.toggle('hidden', !on);
      if (on) shown += 1;
    });
    empty?.classList.toggle('hidden', shown > 0 || cards.length === 0);
  });
</script>
