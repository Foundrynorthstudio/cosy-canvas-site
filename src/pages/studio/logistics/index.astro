---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import StudioNav from '../../../components/StudioNav.astro';
import { isDiyFulfillment } from '../../../lib/booking';
import { getAllBookings } from '../../../lib/booking-store';

const bookings = await getAllBookings();
const deluxe = bookings
  .filter((booking) => !isDiyFulfillment(booking.fulfillment))
  .sort((a, b) => a.checkinDate.localeCompare(b.checkinDate));

const upcomingDeluxe = deluxe.filter((booking) => booking.checkinDate >= new Date().toISOString().slice(0, 10));
const sampleStops = upcomingDeluxe.slice(0, 5);
---

<StudioLayout title="Logistics · Cosy Studio">
  <StudioNav active="logistics" />
  <div class="max-w-7xl mx-auto px-4 py-10 space-y-8">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
      <div>
        <p class="text-[#7D6E23] font-mono text-xs uppercase tracking-[0.25em]">Deluxe runs</p>
        <h1 class="font-display text-3xl md:text-4xl font-black mt-1 text-[#111111]">Logistics</h1>
        <p class="text-stone-500 text-sm mt-2 max-w-2xl">
          Route optimiser for delivery and pickup on deluxe setup stays — build the day’s runs, see how many vehicles you need, and keep the Falkirk container ↔ pitch loop efficient.
        </p>
      </div>
      <div class="flex flex-wrap gap-3 text-[11px] uppercase tracking-wider font-bold text-stone-500">
        <span class="rounded-full bg-white/80 border border-dashed border-[#7D6E23]/30 px-3 py-2">Skeleton</span>
        <span class="rounded-full bg-white/80 border border-[#7D6E23]/20 px-3 py-2">{deluxe.length} deluxe stays</span>
        <span class="rounded-full bg-white/80 border border-[#7D6E23]/20 px-3 py-2">{upcomingDeluxe.length} upcoming</span>
      </div>
    </div>

    <section class="studio-panel rounded-3xl p-6 border-dashed border-[#F7BA1E]/40">
      <h2 class="font-display text-lg font-black text-[#111111]">Coming next</h2>
      <ul class="mt-3 grid sm:grid-cols-3 gap-3 text-sm text-stone-600">
        <li class="rounded-2xl bg-[#FAF7EE] border border-[#7D6E23]/15 p-4">
          <p class="font-bold text-[#111111] text-xs uppercase tracking-wider mb-1">Day routes</p>
          Cluster deluxe check-ins and check-outs into driveable loops from the depot.
        </li>
        <li class="rounded-2xl bg-[#FAF7EE] border border-[#7D6E23]/15 p-4">
          <p class="font-bold text-[#111111] text-xs uppercase tracking-wider mb-1">Fleet need</p>
          How many vans / trailers for the load sheets that day — tent sizes and kit volume.
        </li>
        <li class="rounded-2xl bg-[#FAF7EE] border border-[#7D6E23]/15 p-4">
          <p class="font-bold text-[#111111] text-xs uppercase tracking-wider mb-1">Drop + collect</p>
          Pair delivery and pickup stops so empty space on the return journey earns its keep.
        </li>
      </ul>
    </section>

    <div class="grid lg:grid-cols-[1fr_18rem] gap-6 items-start">
      <section class="studio-panel rounded-3xl p-6">
        <div class="flex items-end justify-between gap-3 mb-4">
          <div>
            <h2 class="font-display text-lg font-black text-[#111111]">Upcoming deluxe stops</h2>
            <p class="text-[11px] text-stone-500 mt-1">Seed list from bookings with delivery / pitching — optimiser not live yet.</p>
          </div>
        </div>

        {
          sampleStops.length === 0 ? (
            <p class="text-sm text-stone-500 py-6 text-center">No upcoming deluxe deliveries on file.</p>
          ) : (
            <div class="space-y-3">
              {sampleStops.map((booking, index) => (
                <a
                  href={`/studio/bookings/${encodeURIComponent(booking.bookingRef)}`}
                  class="flex items-start gap-4 rounded-2xl border border-[#7D6E23]/15 bg-white/70 p-4 hover:border-[#F7BA1E]/50 transition-colors"
                >
                  <span class="w-9 h-9 rounded-xl bg-[#F7BA1E] text-[#111111] flex items-center justify-center shrink-0 font-display font-black text-sm">
                    {index + 1}
                  </span>
                  <div class="min-w-0 flex-1">
                    <p class="font-display font-black text-[#111111] truncate">{booking.customerName}</p>
                    <p class="text-xs text-stone-500 mt-0.5 truncate">{booking.campsiteLocation}</p>
                    <p class="text-[11px] text-stone-600 mt-2">
                      Deliver {booking.checkinDate} · collect {booking.checkoutDate} · {booking.tentType}
                    </p>
                  </div>
                  <span class="text-[10px] uppercase tracking-wider font-bold text-[#7D6E23] shrink-0">Stop</span>
                </a>
              ))}
            </div>
          )
        }
      </section>

      <aside class="space-y-4">
        <div class="studio-panel rounded-3xl p-5">
          <p class="text-[10px] uppercase tracking-wider font-bold text-stone-500">Vehicles today</p>
          <p class="font-display text-4xl font-black text-[#111111] mt-2 tabular-nums">—</p>
          <p class="text-xs text-stone-500 mt-1">Optimiser will set van count from load + distance.</p>
        </div>
        <div class="studio-panel rounded-3xl p-5">
          <p class="text-[10px] uppercase tracking-wider font-bold text-stone-500">Route legs</p>
          <p class="font-display text-4xl font-black text-[#111111] mt-2 tabular-nums">—</p>
          <p class="text-xs text-stone-500 mt-1">Depot → pitches → depot, with pickups interleaved.</p>
        </div>
        <div class="studio-panel rounded-3xl p-5 border-dashed">
          <p class="text-[10px] uppercase tracking-wider font-bold text-[#7D6E23]">Depot</p>
          <p class="font-display font-black text-[#111111] mt-1">Falkirk container</p>
          <p class="text-xs text-stone-500 mt-1">Home base for deluxe load-outs.</p>
        </div>
      </aside>
    </div>
  </div>
</StudioLayout>
