---
import { buildKitManifest } from '../../../../lib/booking-kit';
import { getBookingByRef } from '../../../../lib/booking-store';

const { ref } = Astro.params;
const booking = ref ? await getBookingByRef(ref) : undefined;

if (!booking) {
  return Astro.redirect('/studio/bookings');
}

const kit = buildKitManifest(booking);
const autoPrint = Astro.url.searchParams.get('print') === '1';
---

<!DOCTYPE html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Pack list {booking.bookingRef}</title>
    <style>
      :root { color-scheme: light; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
        background: #f4f1ea;
        color: #111;
      }
      .sheet {
        max-width: 820px;
        margin: 24px auto;
        background: #fff;
        padding: 40px 44px;
        border: 1px solid #e7e5e4;
      }
      .kicker { color: #7d6e23; font-size: 11px; letter-spacing: 0.18em; font-weight: 800; text-transform: uppercase; margin: 0; }
      h1 { font-size: 28px; margin: 8px 0 4px; }
      .sub { color: #57534e; margin: 0 0 20px; }
      .meta { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 24px; font-size: 14px; margin-bottom: 24px; }
      .meta span { color: #78716c; display: block; font-size: 11px; text-transform: uppercase; letter-spacing: 0.08em; }
      .group { break-inside: avoid; margin: 0 0 18px; padding-bottom: 12px; border-bottom: 1px solid #f0eee6; }
      .group h2 { font-size: 13px; text-transform: uppercase; letter-spacing: 0.08em; color: #7d6e23; margin: 0 0 8px; }
      ul { list-style: none; margin: 0; padding: 0; }
      li { display: flex; justify-content: space-between; gap: 16px; padding: 6px 0; border-bottom: 1px dotted #e7e5e4; font-size: 14px; }
      .tick { width: 14px; height: 14px; border: 1.5px solid #111; margin-right: 10px; display: inline-block; vertical-align: -2px; }
      .qty { font-weight: 700; white-space: nowrap; }
      .notes { background: #faf7ee; padding: 12px 14px; font-size: 13px; }
      .sign { display: flex; gap: 24px; margin-top: 28px; font-size: 12px; color: #57534e; }
      .sign p { flex: 1; border-top: 1px solid #d6d3d1; padding-top: 8px; }
      .toolbar { max-width: 820px; margin: 16px auto 0; display: flex; gap: 8px; justify-content: flex-end; }
      .toolbar a, .toolbar button {
        border: 0; background: #f7ba1e; color: #111; font-weight: 800; font-size: 12px; letter-spacing: 0.06em;
        text-transform: uppercase; text-decoration: none; padding: 10px 16px; border-radius: 999px; cursor: pointer;
      }
      .toolbar .ghost { background: #111; color: #fff; }
      @media print {
        body { background: #fff; }
        .toolbar { display: none; }
        .sheet { margin: 0; border: 0; padding: 0; width: 100%; max-width: none; }
      }
    </style>
  </head>
  <body>
    <div class="toolbar">
      <a class="ghost" href={`/studio/bookings/${booking.bookingRef}`}>Back to booking</a>
      <a href={`/api/studio/bookings/${booking.bookingRef}/pack-list.pdf`}>Download PDF</a>
      <button type="button" id="print-btn">Print</button>
    </div>
    <article class="sheet">
      <p class="kicker">The Cosy Canvas Co.</p>
      <h1>Load sheet</h1>
      <p class="sub">{kit.loadVerb}</p>
      <div class="meta">
        <p><span>Booking</span>{booking.bookingRef}</p>
        <p><span>Guest</span>{booking.customerName} · {booking.guests} guests</p>
        <p><span>Dates</span>{booking.checkinDate} → {booking.checkoutDate} · {booking.nights} nights</p>
        <p><span>Pitch</span>{booking.campsiteLocation}</p>
        <p><span>Setup</span>{booking.fulfillment}</p>
        <p><span>Tent</span>{booking.tentType}</p>
      </div>
      {
        kit.groups.map((group) => (
          <section class="group">
            <h2>{group.title}</h2>
            <ul>
              {group.lines.map((line) => (
                <li>
                  <span><span class="tick"></span>{line.label}{line.detail ? ` · ${line.detail}` : ''}</span>
                  <span class="qty">{line.qty}</span>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
      {
        booking.specialRequests && (
          <p class="notes"><strong>Guest notes:</strong> {booking.specialRequests}</p>
        )
      }
      <div class="sign">
        <p>Packed by</p>
        <p>Checked by</p>
        <p>Van / run</p>
      </div>
    </article>
    <script define:vars={{ autoPrint }}>
      const printNow = () => window.print();
      document.getElementById('print-btn')?.addEventListener('click', printNow);
      if (autoPrint) {
        window.addEventListener('load', () => {
          setTimeout(printNow, 200);
        });
      }
    </script>
  </body>
</html>
