---
import StudioLayout from '../../../layouts/StudioLayout.astro';
import StudioNav from '../../../components/StudioNav.astro';
import { deriveBookingStatus, statusLabel } from '../../../lib/booking';
import {
  bookingLoadIcons,
  buildOpsCalendar,
  parseMonthParam,
} from '../../../lib/booking-ops-calendar';
import { getAllBookings } from '../../../lib/booking-store';

const bookings = await getAllBookings();
const dueCount = bookings.filter((b) => b.remainingBalance > 0).length;
const { year, month } = parseMonthParam(Astro.url.searchParams.get('month'));
const calendar = buildOpsCalendar(bookings, year, month);
const upcoming = [...bookings].sort((a, b) => a.checkinDate.localeCompare(b.checkinDate));
---

<StudioLayout title="Bookings · Cosy Studio">
  <StudioNav active="bookings" />
  <div class="max-w-7xl mx-auto px-4 py-10 space-y-10">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
      <div>
        <p class="text-[#F7BA1E] font-mono text-xs uppercase tracking-[0.25em]">Operations desk</p>
        <h1 class="font-display text-3xl md:text-4xl font-black mt-1">Bookings calendar</h1>
        <p class="text-stone-400 text-sm mt-2">
          {bookings.length} stays on file · {dueCount} with a balance due · peak kit sized for overlap, not raw totals
        </p>
      </div>
      <button id="remind-all" class="rounded-full border border-[#F7BA1E]/40 text-[#F7BA1E] font-display font-extrabold text-xs uppercase tracking-wider px-5 py-3 self-start">
        Run scheduled emails
      </button>
    </div>

    {
      bookings.length === 0 ? (
        <div class="rounded-3xl border border-dashed border-white/15 p-12 text-center text-stone-400">
          <p class="font-display text-xl font-black text-white mb-2">No bookings yet</p>
          <p class="text-sm">Paid checkouts appear here automatically, with confirmation, welcome pack, and DIY guide emails.</p>
        </div>
      ) : (
        <>
          <section>
            <div class="flex items-center justify-between gap-3 mb-4">
              <h2 class="font-display text-lg font-black">Fleet needed (peak concurrent)</h2>
              <p class="text-[11px] text-stone-500 max-w-md text-right hidden sm:block">
                Peak = most of that kit out on any one night. Stock to the peak; unit-nights show overall pressure.
              </p>
            </div>
            <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6 gap-3">
              {calendar.metrics.map((metric) => (
                <div class="rounded-3xl border border-white/10 bg-gradient-to-br from-white/[0.07] to-white/[0.02] p-4 min-h-[7.5rem] flex flex-col">
                  <div class="flex items-center justify-between gap-2">
                    <span class="w-9 h-9 rounded-2xl bg-[#F7BA1E]/15 text-[#F7BA1E] flex items-center justify-center">
                      <i class={`fa-solid ${metric.icon}`}></i>
                    </span>
                    <span class="font-display text-2xl font-black text-white">{metric.peak}</span>
                  </div>
                  <p class="font-display font-bold text-sm text-white mt-3 leading-tight">{metric.label}</p>
                  <p class="text-[10px] uppercase tracking-wider text-stone-500 mt-auto pt-2">
                    {metric.bookings} stay{metric.bookings === 1 ? '' : 's'} · {metric.unitNights} unit-nights
                  </p>
                </div>
              ))}
            </div>
          </section>

          <section class="rounded-3xl border border-white/10 bg-white/[0.03] overflow-hidden">
            <div class="flex items-center justify-between gap-3 px-5 py-4 border-b border-white/10">
              <a
                href={`/studio/bookings?month=${calendar.prev}`}
                class="w-9 h-9 rounded-full border border-white/15 text-stone-300 hover:text-white hover:border-[#F7BA1E]/50 flex items-center justify-center"
                aria-label="Previous month"
              >
                <i class="fa-solid fa-chevron-left text-xs"></i>
              </a>
              <div class="text-center">
                <h2 class="font-display text-xl font-black">{calendar.label}</h2>
                <p class="text-[11px] text-stone-500">{calendar.stayCount} stay{calendar.stayCount === 1 ? '' : 's'} this month</p>
              </div>
              <a
                href={`/studio/bookings?month=${calendar.next}`}
                class="w-9 h-9 rounded-full border border-white/15 text-stone-300 hover:text-white hover:border-[#F7BA1E]/50 flex items-center justify-center"
                aria-label="Next month"
              >
                <i class="fa-solid fa-chevron-right text-xs"></i>
              </a>
            </div>

            <div class="grid grid-cols-7 border-b border-white/10 text-[10px] uppercase tracking-widest text-stone-500">
              {['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'].map((d) => (
                <div class="px-2 py-2 text-center">{d}</div>
              ))}
            </div>

            <div class="grid grid-cols-7 auto-rows-fr">
              {calendar.days.map((day) => (
                <div
                  class:list={[
                    'min-h-[5.5rem] sm:min-h-[7rem] border-r border-b border-white/5 p-1.5 sm:p-2',
                    !day.inMonth && 'opacity-35',
                    day.stays.length > 0 && 'bg-[#F7BA1E]/[0.04]',
                  ]}
                >
                  <div class="flex items-center justify-between gap-1 mb-1">
                    <span class="text-[11px] font-bold text-stone-400">{day.day}</span>
                    {day.stays.length > 0 && (
                      <span class="text-[9px] font-mono text-[#F7BA1E]">{day.stays.length}</span>
                    )}
                  </div>
                  <div class="space-y-1">
                    {day.stays.slice(0, 3).map((stay) => (
                      <a
                        href={`/studio/bookings/${stay.ref}`}
                        class="block truncate rounded-md px-1.5 py-0.5 text-[10px] sm:text-[11px] font-bold text-[#111111]"
                        style={`background:${stay.color}`}
                        title={stay.name}
                      >
                        {stay.name}
                      </a>
                    ))}
                    {day.stays.length > 3 && (
                      <p class="text-[9px] text-stone-500 pl-1">+{day.stays.length - 3} more</p>
                    )}
                  </div>
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="font-display text-lg font-black mb-4">All stays</h2>
            <div class="grid md:grid-cols-2 gap-4">
              {upcoming.map((booking) => {
                const status = deriveBookingStatus(booking);
                const icons = bookingLoadIcons(booking);
                return (
                  <a
                    href={`/studio/bookings/${booking.bookingRef}`}
                    class="rounded-3xl border border-white/10 bg-white/[0.03] hover:border-[#F7BA1E]/40 hover:bg-white/[0.05] transition-colors p-5 block"
                  >
                    <div class="flex items-start justify-between gap-3">
                      <div>
                        <p class="font-display font-black text-lg text-white">{booking.customerName}</p>
                        <p class="text-stone-500 text-xs mt-1">{booking.bookingRef} · {booking.customerEmail}</p>
                      </div>
                      <span class:list={[
                        'text-[10px] uppercase tracking-wider font-bold px-2.5 py-1 rounded-full shrink-0',
                        status === 'paid_in_full' && 'bg-emerald-500/15 text-emerald-300',
                        status === 'balance_due' && 'bg-amber-500/15 text-amber-300',
                        status === 'refunded' && 'bg-red-500/15 text-red-300',
                        status === 'confirmed' && 'bg-white/10 text-stone-200',
                      ]}>
                        {statusLabel(status)}
                      </span>
                    </div>
                    <p class="text-sm text-stone-300 mt-3">
                      {booking.checkinDate} → {booking.checkoutDate}
                      <span class="text-stone-500"> · {booking.guests} guests</span>
                    </p>
                    <p class="text-xs text-stone-500 mt-1 truncate">{booking.campsiteLocation}</p>
                    <div class="flex flex-wrap gap-2 mt-4">
                      {icons.map((item) => (
                        <span class="inline-flex items-center gap-1.5 rounded-full bg-white/5 border border-white/10 px-2.5 py-1 text-[10px] text-stone-300">
                          <i class={`fa-solid ${item.icon} text-[#F7BA1E]`}></i>
                          {item.label}
                        </span>
                      ))}
                    </div>
                    {booking.remainingBalance > 0 && (
                      <p class="text-[11px] text-amber-300 mt-3">£{booking.remainingBalance.toFixed(2)} balance due</p>
                    )}
                  </a>
                );
              })}
            </div>
          </section>
        </>
      )
    }
    <p id="status" class="text-xs text-stone-500"></p>
  </div>
</StudioLayout>

<script>
  document.getElementById('remind-all')?.addEventListener('click', async () => {
    const status = document.getElementById('status');
    if (status) status.textContent = 'Sending…';
    const res = await fetch('/api/studio/bookings/reminders', { method: 'POST' });
    const json = await res.json();
    if (status) status.textContent = res.ok ? `Sent ${json.sent} scheduled email${json.sent === 1 ? '' : 's'}.` : (json.error || 'Failed');
  });
</script>
