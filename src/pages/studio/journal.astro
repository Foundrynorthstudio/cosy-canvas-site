---
import StudioLayout from '../../layouts/StudioLayout.astro';
import StudioNav from '../../components/StudioNav.astro';
import { getAllPosts } from '../../lib/journal-store';

const posts = await getAllPosts(true);
---

<StudioLayout title="Journal Studio">
  <StudioNav active="journal" />
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10">
      <div>
        <p class="text-[#7D6E23] font-mono text-xs uppercase tracking-[0.25em]">Publisher desk</p>
        <h1 class="font-display text-3xl font-black mt-1 text-[#111111]">Journal Studio</h1>
      </div>
      <div class="flex items-center gap-3">
        <a href="/studio/posts/new" class="rounded-full bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider px-5 py-3">
          New story
        </a>
      </div>
    </div>

    <div class="studio-panel rounded-3xl overflow-hidden">
      <table class="w-full text-left text-sm">
        <thead class="text-[11px] uppercase tracking-widest text-stone-500 border-b border-stone-200">
          <tr>
            <th class="px-5 py-4">Story</th>
            <th class="px-5 py-4 hidden md:table-cell">Category</th>
            <th class="px-5 py-4 hidden sm:table-cell">Status</th>
            <th class="px-5 py-4"></th>
          </tr>
        </thead>
        <tbody>
          {
            posts.map((post) => (
              <tr class="border-b border-stone-100 hover:bg-stone-50/80">
                <td class="px-5 py-4">
                  <p class="font-semibold text-[#111111]">{post.title}</p>
                  <p class="text-stone-500 text-xs mt-1">{post.date} · {post.readTime}</p>
                </td>
                <td class="px-5 py-4 hidden md:table-cell text-stone-600">{post.categoryName}</td>
                <td class="px-5 py-4 hidden sm:table-cell">
                  <span class:list={[
                    'text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-full',
                    post.status === 'published' ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800',
                  ]}>
                    {post.status}
                  </span>
                  {post.featured && (
                    <span class="ml-2 text-[10px] uppercase tracking-wider text-[#7D6E23]">Featured</span>
                  )}
                </td>
                <td class="px-5 py-4 text-right whitespace-nowrap">
                  {post.status === 'published' && (
                    <a href={`/journal/${post.slug}`} class="text-stone-500 hover:text-[#111111] text-xs mr-4" target="_blank">View</a>
                  )}
                  <a href={`/studio/posts/${post.slug}`} class="text-[#7D6E23] text-xs font-bold uppercase tracking-wider hover:text-[#F7BA1E]">Edit</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</StudioLayout>
