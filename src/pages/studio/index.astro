---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { getAllPosts } from '../../lib/journal-store';

const posts = await getAllPosts(true);
---

<StudioLayout title="Journal Studio">
  <div class="max-w-6xl mx-auto px-4 py-10">
    <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-10">
      <div>
        <p class="text-[#F7BA1E] font-mono text-xs uppercase tracking-[0.25em]">Publisher desk</p>
        <h1 class="font-display text-3xl font-black mt-1">Journal Studio</h1>
      </div>
      <div class="flex items-center gap-3">
        <a href="/studio/posts/new" class="rounded-full bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider px-5 py-3">
          New story
        </a>
        <form method="POST" action="/api/studio/logout">
          <button class="text-xs text-stone-400 hover:text-white uppercase tracking-wider">Sign out</button>
        </form>
      </div>
    </div>

    <div class="rounded-3xl border border-white/10 overflow-hidden bg-white/[0.03]">
      <table class="w-full text-left text-sm">
        <thead class="text-[11px] uppercase tracking-widest text-stone-500 border-b border-white/10">
          <tr>
            <th class="px-5 py-4">Story</th>
            <th class="px-5 py-4 hidden md:table-cell">Category</th>
            <th class="px-5 py-4 hidden sm:table-cell">Status</th>
            <th class="px-5 py-4"></th>
          </tr>
        </thead>
        <tbody>
          {
            posts.map((post) => (
              <tr class="border-b border-white/5 hover:bg-white/[0.04]">
                <td class="px-5 py-4">
                  <p class="font-semibold text-white">{post.title}</p>
                  <p class="text-stone-500 text-xs mt-1">{post.date} · {post.readTime}</p>
                </td>
                <td class="px-5 py-4 hidden md:table-cell text-stone-400">{post.categoryName}</td>
                <td class="px-5 py-4 hidden sm:table-cell">
                  <span class:list={[
                    'text-[10px] uppercase tracking-wider font-bold px-2 py-1 rounded-full',
                    post.status === 'published' ? 'bg-emerald-500/15 text-emerald-300' : 'bg-amber-500/15 text-amber-300',
                  ]}>
                    {post.status}
                  </span>
                  {post.featured && (
                    <span class="ml-2 text-[10px] uppercase tracking-wider text-[#F7BA1E]">Featured</span>
                  )}
                </td>
                <td class="px-5 py-4 text-right whitespace-nowrap">
                  {post.status === 'published' && (
                    <a href={`/journal/${post.slug}`} class="text-stone-400 hover:text-white text-xs mr-4" target="_blank">View</a>
                  )}
                  <a href={`/studio/posts/${post.slug}`} class="text-[#F7BA1E] text-xs font-bold uppercase tracking-wider">Edit</a>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</StudioLayout>
