---
import StudioLayout from '../../layouts/StudioLayout.astro';
import { studioPasswordConfigured } from '../../lib/journal-auth';

const error = Astro.url.searchParams.get('error');
const nextPath = Astro.url.searchParams.get('next') || '/studio';
const configured = studioPasswordConfigured();
---

<StudioLayout title="Journal Studio · Sign in">
  <div class="min-h-screen flex items-center justify-center px-4 py-16">
    <div class="w-full max-w-md">
      <div class="mb-8 text-center">
        <p class="text-[#F7BA1E] font-mono text-xs uppercase tracking-[0.25em] mb-3">The Cosy Canvas Co.</p>
        <h1 class="font-display text-3xl font-black">Journal Studio</h1>
        <p class="text-stone-400 text-sm mt-2">Sign in to write and publish stories.</p>
      </div>
      <form method="POST" action="/api/studio/login" class="rounded-3xl border border-white/10 bg-white/5 p-8 shadow-2xl backdrop-blur">
        <input type="hidden" name="next" value={nextPath} />
        <label class="block text-xs font-bold uppercase tracking-wider text-stone-400 mb-2" for="password">
          Publisher password
        </label>
        <input
          id="password"
          name="password"
          type="password"
          required
          autocomplete="current-password"
          class="w-full rounded-2xl bg-[#1a1a1a] border border-stone-700 px-4 py-3.5 text-sm text-white focus:border-[#F7BA1E] focus:outline-none"
        />
        {
          error === 'invalid' && (
            <p class="text-red-400 text-xs mt-3">That password does not match.</p>
          )
        }
        {
          error === 'config' || !configured ? (
            <p class="text-amber-400 text-xs mt-3">
              Set JOURNAL_ADMIN_PASSWORD and JOURNAL_SESSION_SECRET in your environment before signing in.
            </p>
          ) : null
        }
        <button
          type="submit"
          class="mt-6 w-full rounded-full bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider py-3.5 hover:bg-[#D4A51E]"
        >
          Enter studio
        </button>
      </form>
      <p class="text-center text-stone-500 text-xs mt-6">
        <a href="/journal" class="hover:text-[#F7BA1E]">Back to the journal</a>
      </p>
    </div>
  </div>
</StudioLayout>
