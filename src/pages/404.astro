---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Page not found | The Cosy Canvas Co."
  description="That page has packed up. Head home or book a Scottish bell tent stay."
  robots="noindex, follow"
>
  <section class="py-24 text-center relative z-20 px-4">
    <span class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest font-bold">404</span>
    <h1 class="font-display text-4xl md:text-5xl font-black mt-3 mb-4">This pitch is empty</h1>
    <p class="text-stone-500 mb-8 max-w-md mx-auto">The link may be from the old site. Try camping hire, Cosy Campsites, or book from Falkirk.</p>
    <div class="flex flex-wrap justify-center gap-3">
      <a href="/" class="inline-flex rounded-full bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3">Home</a>
      <a href="/camping-hire" class="inline-flex rounded-full border border-stone-300 text-stone-800 font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3">Camping Hire</a>
      <a href="/campsites" class="inline-flex rounded-full border border-stone-300 text-stone-800 font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3">Cosy Campsites</a>
    </div>
  </section>
</Layout>
