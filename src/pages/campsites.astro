<script define:vars={{ campsiteMapData: CAMPSITE_ROUTES }}>
  function applyJournalButtons(data, liveEl, soonEl, rowEl) {
    if (rowEl) {
      if (data.key === 'falkirk') {
        rowEl.classList.add('hidden');
        return;
      }
      rowEl.classList.remove('hidden');
    }
    if (data.journalSlug) {
      if (liveEl) {
        liveEl.href = `/journal/${data.journalSlug}`;
        liveEl.classList.remove('hidden');
        liveEl.classList.add('flex');
      }
      soonEl?.classList.add('hidden');
      soonEl?.classList.remove('flex');
    } else {
      liveEl?.classList.add('hidden');
      liveEl?.classList.remove('flex');
      soonEl?.classList.remove('hidden');
      soonEl?.classList.add('flex');
    }
  }

  function updateMapShowcase(pinKey) {
    const data = campsiteMapData[pinKey];
    if (!data) return;

    document.querySelectorAll('.pin-icon').forEach((p) => p.classList.remove('active-map-pin'));
    const activeBtn = document.querySelector(`[data-pin="${pinKey}"] .pin-icon`);
    if (activeBtn) activeBtn.classList.add('active-map-pin');

    document.getElementById('mapCardTag').innerText = data.tag;
    document.getElementById('mapCardDrive').innerText = data.drive;
    document.getElementById('mapCardImg').src = data.img;
    document.getElementById('mapCardElevation').innerText = data.elevation;
    document.getElementById('mapCardTitle').innerText = data.title;
    const holidays = document.getElementById('mapCardHolidays');
    if (holidays) {
      if (data.badge === 'Cosy Holidays') {
        holidays.classList.remove('hidden');
        holidays.classList.add('flex');
      } else {
        holidays.classList.add('hidden');
        holidays.classList.remove('flex');
      }
    }
    document.getElementById('mapCardRegion').innerText = data.region;
    document.getElementById('mapCardDesc').innerText = data.desc;
    document.getElementById('mapCardSuitability').innerText = data.suitability;
    document.getElementById('mapCardLink').href = data.website;
    applyJournalButtons(
      data,
      document.getElementById('mapCardJournal'),
      document.getElementById('mapCardJournalSoon'),
      document.getElementById('mapCardJournalRow'),
    );

    const btn = document.getElementById('mapCardBtn');
    if (btn) {
      btn.onclick = () => openModal(data);
    }
  }

  function openModal(data) {
    document.getElementById('modalTitle').innerText = data.title;
    document.getElementById('modalGridRef').innerText = data.tag;
    document.getElementById('modalRegion').innerText = data.region;
    document.getElementById('modalElevation').innerText = data.elevation;
    document.getElementById('modalSuitability').innerText = data.suitability;
    document.getElementById('modalWebsiteLink').href = data.website;
    document.getElementById('modalDistance').innerText = data.distance;
    document.getElementById('modalRouteDesc').innerText = data.routeDesc;
    document.getElementById('modalTerrain').innerText = data.terrain;
    document.getElementById('modalFuel').innerText = `${data.fuelOneWay} each way · ${data.fuelRoundTrip}`;
    document.getElementById('modalMapsLink').href = data.mapsUrl;
    applyJournalButtons(
      data,
      document.getElementById('modalJournalLink'),
      document.getElementById('modalJournalSoon'),
      document.getElementById('modalJournalRow'),
    );
    const embed = document.getElementById('modalMapEmbed');
    if (embed) embed.src = data.embedSrc;
    const note = document.getElementById('modalMapNote');
    if (note && data.key === 'durness') {
      note.innerText = 'Public road into Durness village only. The wild pitch is not shown.';
    } else if (note && data.key === 'falkirk') {
      note.innerText = 'Falkirk container. What3Words is on DIY booking confirmation.';
    } else if (note) {
      note.innerText = 'Google road route from the Falkirk container. Times are typical, not live traffic.';
    }

    const modal = document.getElementById('campsiteModal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeModal() {
    const modal = document.getElementById('campsiteModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('.map-pin-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-pin');
        if (key) updateMapShowcase(key);
      });
    });

    document.querySelectorAll('.open-dossier-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-site');
        const data = campsiteMapData[key];
        if (data) openModal(data);
      });
    });

    document.querySelectorAll('.filter-btn').forEach((btn) => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        document.querySelectorAll('.campsite-card').forEach((card) => {
          if (filter === 'all' || card.getAttribute('data-region') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
    document.getElementById('campsiteModal')?.addEventListener('click', (e) => {
      if (e.target === document.getElementById('campsiteModal')) closeModal();
    });

    updateMapShowcase('cobleland');
  });
</script>


<style is:global>
  .os-grid-badge {
    font-family: 'Courier New', Courier, monospace !important;
    letter-spacing: 0.08em !important;
