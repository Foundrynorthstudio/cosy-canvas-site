---
import Layout from '../layouts/Layout.astro';
import CampsiteBookButton from '../components/CampsiteBookButton.astro';
import CampsiteJournalButton from '../components/CampsiteJournalButton.astro';
import { CAMPSITE_ROUTES, cosyConciergeMailto } from '../lib/campsites';
import { DEPOT } from '../lib/depot';

const cobleland = CAMPSITE_ROUTES.cobleland;
const fidden = CAMPSITE_ROUTES.fidden;
const lochchon = CAMPSITE_ROUTES.lochchon;
const sallochy = CAMPSITE_ROUTES.sallochy;
const redsquirrel = CAMPSITE_ROUTES.redsquirrel;
---

<Layout 
  title="Recommended Scottish Campsites & Wild Spots | The Cosy Canvas Co." 
  description="Explore top recommended bell tent campsites across Loch Lomond, the Trossachs, Glencoe, Isle of Mull, and the NC500 with driving routes from our Falkirk container."
>
  <!-- Page Header Banner -->
  <div class="bg-[#111111] text-white py-12 md:py-16 border-b border-stone-800 relative z-30">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <span class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest block mb-2 font-bold">COSY HOLIDAYS</span>
      <h1 class="font-display text-3xl md:text-5xl font-black text-white">Recommended Scottish Campsites</h1>
      <p class="text-stone-400 text-sm md:text-base mt-2 max-w-3xl font-light leading-relaxed">
        Cosy Holidays is bookable setup with a partnered campsite — we pitch, they hold the field. Red Squirrel in Glen Coe is where we can do this well, about two hours from Glasgow. The absolute dream is the wild spot in Durness. Cobleland and Fidden Farm sit on the same list. Book the pitch with the campsite, send us the booking reference. Loch Chon and Sallochy are National Park pitches: DIY from the Falkirk container.
      </p>
    </div>
  </div>

  <section class="py-12 border-b border-stone-200/80 relative z-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">

      <div class="rounded-3xl border border-stone-200 bg-white p-6 sm:p-8 mb-12 max-w-4xl">
        <h2 class="font-display text-2xl font-black text-[#111111] mb-3 flex items-center gap-2.5">
          <img src="/favicon.svg" alt="" width="28" height="28" class="h-7 w-7 rounded-md border border-[#F7BA1E] shrink-0" />
          Cosy Holidays
        </h2>
        <p class="text-stone-600 text-sm leading-relaxed mb-3">
          Virtual check-in, from wherever you are. <strong>Cosy Concierge</strong> is Trystan — he holds the dates, talks to the campsite, and has the canvas waiting. You arrive to a cosy holiday, not a to-do list.
        </p>
        <p class="text-stone-600 text-sm leading-relaxed mb-4">
          If your preferred site is not on the map, let us know. Trystan stands ready, and he has not failed yet. Every campsite you ask us to book opens a door for others to follow.
        </p>
        <a
          href={cosyConciergeMailto()}
          class="inline-flex items-center gap-2 rounded-full bg-[#F7BA1E] hover:bg-[#D4A51E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3 transition-colors"
        >
          <i class="fa-solid fa-comments text-[11px]"></i>
          Cosy Concierge
        </a>
        <h3 class="font-display text-lg font-black text-[#111111] mb-2 mt-6 flex items-center gap-2">
          <img src="/favicon-diy.svg" alt="" width="22" height="22" class="h-[22px] w-[22px] rounded-[4px] border border-[#7D6E23] shrink-0" />
          DIY
        </h3>
        <p class="text-stone-600 text-sm leading-relaxed mb-4">
          Camping is awesome, and we actually enjoy the setup. If you do too, Scotland is a camper’s dream. Right to Roam across the country, and in summer the National Parks ask for a permit on their busiest lochshores. Come and meet the team for a cosy collection from Falkirk.
        </p>
        <a
          href="/booking?fulfillment=diy"
          class="inline-flex items-center gap-2 rounded-full bg-[#F7BA1E] hover:bg-[#D4A51E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3 transition-colors"
        >
          <i class="fa-solid fa-warehouse text-[11px]"></i>
          Book gear now
        </a>
      </div>
      
      <!-- Side-by-Side Flex Container (Inlined CSS for Guaranteed Desktop Grid) -->
      <div style="display: flex; flex-wrap: wrap; gap: 1.5rem; background-color: #ffffff; border-radius: 1.5rem; padding: 1.5rem; border: 1px solid rgba(229, 231, 235, 0.8); box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);" class="mb-12">
        
        <!-- Left Column: Scottish Contour Map (58% Width on Desktop) -->
        <div style="flex: 1 1 500px; min-width: 320px;" class="flex flex-col justify-between">
          <div class="flex items-center justify-between mb-3 pb-2 border-b border-stone-100">
            <div>
              <h2 class="font-display font-bold text-base text-[#111111] flex items-center gap-2">
                <i class="fa-solid fa-map-location-dot text-[#F7BA1E]"></i>
                <span>Interactive Scottish Contour Map</span>
              </h2>
              <p class="text-stone-500 text-[11px]">Click any pin for road time, fuel, and Google Maps from Falkirk</p>
            </div>
            <div class="hidden sm:flex items-center gap-3 text-[11px]">
              <span class="flex items-center gap-1"><span class="w-3 h-3 rounded-full bg-[#F7BA1E] border-2 border-[#111111]"></span> Falkirk container</span>
              <span class="flex items-center gap-1"><img src="/favicon.svg" alt="" width="14" height="14" class="h-3.5 w-3.5 rounded-[3px] border border-[#F7BA1E]" /> Cosy Holidays</span>
              <span class="flex items-center gap-1"><img src="/favicon-diy.svg" alt="" width="14" height="14" class="h-3.5 w-3.5 rounded-[3px] border border-[#7D6E23]" /> DIY</span>
            </div>
          </div>

          <!-- Map Container with High-Visibility Pins -->
          <div id="scotlandMap" class="relative w-full h-[420px] bg-[#FAF8F5] rounded-2xl border border-stone-200 overflow-hidden shadow-inner flex items-center justify-center p-2">
            <div class="relative h-full aspect-square max-w-full">
            <img src="/TCCC Map of Scotland.png" alt="The Cosy Canvas Co. Topographic Contour Map of Scotland" class="absolute inset-0 w-full h-full object-contain pointer-events-none select-none opacity-95" onerror="this.src='https://placehold.co/800x800/FAF7EE/7D6E23?text=TCCC+Scotland+Contour+Map'"/>

            <!-- PIN 1: Falkirk container (Star) -->
            <button type="button" data-pin="falkirk" id="pin-falkirk" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-40" style={`left: ${DEPOT.mapPinLeft}; top: ${DEPOT.mapPinTop};`} title="Falkirk container">
              <div class="pin-icon w-5 h-5 rounded-full bg-[#F7BA1E] border-2 border-[#111111] flex items-center justify-center text-[#111111] font-black text-[9px] shadow-2xl map-pin-pulse">
                <i class="fa-solid fa-star"></i>
              </div>
            </button>

            <!-- PIN 2: Cobleland Campsite -->
            <button type="button" data-pin="cobleland" id="pin-cobleland" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-30" style="left: 52.8%; top: 67.2%;" title="Cobleland · Cosy Holidays">
              <div class="pin-icon pin-icon--holidays w-5 h-5 rounded-full bg-[#111111] border-2 border-[#F7BA1E] overflow-hidden shadow-xl active-map-pin">
                <img src="/favicon.svg" alt="" width="32" height="32" class="w-full h-full pointer-events-none" />
              </div>
            </button>

            <!-- PIN 3: Loch Chon Campsite -->
            <button type="button" data-pin="lochchon" id="pin-lochchon" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-30" style="left: 50.6%; top: 65.4%;" title="Loch Chon · DIY">
              <div class="pin-icon pin-icon--diy w-5 h-5 rounded-full bg-[#111111] border-2 border-[#7D6E23] overflow-hidden shadow-xl">
                <img src="/favicon-diy.svg" alt="" width="32" height="32" class="w-full h-full pointer-events-none" />
              </div>
            </button>

            <!-- PIN 4: Sallochy Campsite -->
            <button type="button" data-pin="sallochy" id="pin-sallochy" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-30" style="left: 49.8%; top: 68%;" title="Sallochy · DIY">
              <div class="pin-icon pin-icon--diy w-5 h-5 rounded-full bg-[#111111] border-2 border-[#7D6E23] overflow-hidden shadow-xl">
                <img src="/favicon-diy.svg" alt="" width="32" height="32" class="w-full h-full pointer-events-none" />
              </div>
            </button>

            <!-- PIN 5: Luss Campsite -->
            <button type="button" data-pin="luss" id="pin-luss" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-30" style="left: 48.6%; top: 69%;" title="Luss · DIY">
              <div class="pin-icon pin-icon--diy w-5 h-5 rounded-full bg-[#111111] border-2 border-[#7D6E23] overflow-hidden shadow-xl">
                <img src="/favicon-diy.svg" alt="" width="32" height="32" class="w-full h-full pointer-events-none" />
              </div>
            </button>

            <!-- PIN 6: Fidden Farm Campsite (Mull) -->
            <button type="button" data-pin="fidden" id="pin-fidden" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-30" style="left: 33.8%; top: 57.8%;" title="Fidden Farm · Cosy Holidays">
              <div class="pin-icon pin-icon--holidays w-5 h-5 rounded-full bg-[#111111] border-2 border-[#F7BA1E] overflow-hidden shadow-xl">
                <img src="/favicon.svg" alt="" width="32" height="32" class="w-full h-full pointer-events-none" />
              </div>
            </button>

            <!-- PIN 7: Red Squirrel Campsite (Glencoe) -->
            <button type="button" data-pin="redsquirrel" id="pin-redsquirrel" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-30" style="left: 43.2%; top: 52.4%;" title="Red Squirrel · Cosy Holidays">
              <div class="pin-icon pin-icon--holidays w-5 h-5 rounded-full bg-[#111111] border-2 border-[#F7BA1E] overflow-hidden shadow-xl">
                <img src="/favicon.svg" alt="" width="32" height="32" class="w-full h-full pointer-events-none" />
              </div>
            </button>

            <!-- PIN 8: Durness Coastal Spot -->
            <button type="button" data-pin="durness" id="pin-durness" class="map-pin-btn absolute cursor-pointer transform -translate-x-1/2 -translate-y-1/2 z-30" style="left: 45.4%; top: 30.2%;" title="Durness · Cosy Holidays">
              <div class="pin-icon pin-icon--holidays w-5 h-5 rounded-full bg-[#111111] border-2 border-[#F7BA1E] overflow-hidden shadow-xl">
                <img src="/favicon.svg" alt="" width="32" height="32" class="w-full h-full pointer-events-none" />
              </div>
            </button>
            </div>
          </div>
        </div>

        <!-- Right Column: Featured Campsite Card (Fixed 380px Width on Desktop) -->
        <div style="flex: 1 1 380px; min-width: 300px; background-color: rgba(250, 247, 238, 0.9); padding: 1.25rem; border-radius: 1rem; border: 1px solid rgba(229, 231, 235, 0.8);" class="flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3">
              <span id="mapCardTag" class="os-grid-badge text-[10px] px-2.5 py-0.5 rounded uppercase font-bold">{cobleland.tag}</span>
              <span id="mapCardDrive" class="bg-[#F7BA1E] text-[#111111] font-mono text-[10px] font-bold px-2.5 py-0.5 rounded">{cobleland.drive}</span>
            </div>

            <div class="relative h-44 rounded-xl overflow-hidden mb-4 border border-stone-200">
              <img id="mapCardImg" src="/campsite_cobleland.jpg" alt="Selected campsite" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/600x400/FAF7EE/7D6E23?text=Campsite+View'"/>
              <span id="mapCardElevation" class="absolute top-2 right-2 bg-[#111111]/80 text-white text-[10px] font-bold px-2 py-0.5 rounded backdrop-blur-sm">
                25m ELEVATION
              </span>
            </div>

            <h3 id="mapCardTitle" class="font-display font-black text-2xl text-[#111111] mb-1">Cobleland Campsite</h3>
            <p id="mapCardHolidays" class="mb-2 flex items-center gap-2 bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-[10px] uppercase tracking-wider px-3 py-1.5 rounded-lg w-fit">
              <img src="/favicon.svg" alt="" width="16" height="16" class="h-4 w-4 rounded-[3px] shrink-0" />
              Cosy Holidays site
            </p>
            <p id="mapCardRegion" class="text-[#7D6E23] text-xs font-bold mb-3">Gartmore, Stirling • Queen Elizabeth Forest Park</p>
            <p id="mapCardDesc" class="text-stone-600 text-xs leading-relaxed mb-4">
              {cobleland.desc}
            </p>
          </div>

          <div class="pt-4 border-t border-stone-200/80 space-y-3">
            <div class="flex items-center justify-between text-xs text-stone-600">
              <span class="font-semibold">Pitch Suitability:</span>
              <span id="mapCardSuitability" class="font-bold text-[#111111]">{cobleland.suitability}</span>
            </div>

            <div id="mapCardJournalRow" class="pt-1">
              <a id="mapCardJournal" href="/journal/red-squirrel-campsite-glencoe" class="hidden w-full text-center bg-[#7D6E23] hover:bg-[#4F571A] text-white font-display font-bold text-xs uppercase tracking-wider py-3 rounded-xl transition-colors items-center justify-center gap-1.5">
                <i class="fa-solid fa-book-open text-[10px]"></i> Read the journal
              </a>
              <span id="mapCardJournalSoon" class="w-full text-center bg-stone-100 text-stone-400 font-display font-bold text-xs uppercase tracking-wider py-3 rounded-xl flex items-center justify-center gap-1.5">
                <i class="fa-regular fa-clock text-[10px]"></i> Journal coming
              </span>
            </div>
            <div class="flex gap-2 pt-1">
              <a id="mapCardLink" href="https://www.coblelandcampsite.co.uk/" target="_blank" rel="noopener" class="flex-1 text-center bg-stone-100 hover:bg-stone-200 text-stone-800 font-display font-bold text-xs uppercase tracking-wider py-3 rounded-xl transition-colors flex items-center justify-center gap-1">
                <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> Website
              </a>
              <button type="button" id="mapCardBtn" class="flex-1 text-center bg-[#F7BA1E] hover:bg-[#D4A51E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider py-3 rounded-xl transition-all shadow-sm">
                Drive from Falkirk &rarr;
              </button>
            </div>
          </div>
        </div>

      </div>

      <!-- Region Filter Tabs -->
      <div class="flex flex-wrap items-center gap-3 mb-10">
        <button type="button" data-filter="all" class="filter-btn px-4 py-2 rounded-lg bg-[#7D6E23] text-white font-semibold text-xs transition-all shadow-sm">All Locations</button>
        <button type="button" data-filter="loch" class="filter-btn px-4 py-2 rounded-lg bg-white text-stone-700 border border-stone-200 hover:bg-stone-50 font-semibold text-xs transition-all">Loch Lomond & Trossachs</button>
        <button type="button" data-filter="highlands" class="filter-btn px-4 py-2 rounded-lg bg-white text-stone-700 border border-stone-200 hover:bg-stone-50 font-semibold text-xs transition-all">Islands & Highlands</button>
        <button type="button" data-filter="wild" class="filter-btn px-4 py-2 rounded-lg bg-[#F7BA1E] text-[#111111] font-extrabold text-xs transition-all border border-[#D4A51E] shadow-xs flex items-center gap-1.5">
          <i class="fa-solid fa-compass"></i> Wild Camping Spots
        </button>
      </div>

      <!-- Campsite Cards Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        
        <!-- Campsite 1: Cobleland -->
        <div class="campsite-card bg-white rounded-xl overflow-hidden shadow-md flex flex-col border-2 border-[#F7BA1E] relative" data-region="loch">
          <div class="bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-[10px] uppercase tracking-wider px-3 py-1 flex items-center justify-between">
            <span class="flex items-center gap-1.5"><img src="/favicon.svg" alt="" width="14" height="14" class="h-3.5 w-3.5 rounded-[2px] shrink-0" /> {cobleland.badge}</span>
            <span class="text-[9px] bg-[#111111] text-[#F7BA1E] px-2 py-0.5 rounded font-mono">{cobleland.drive}</span>
          </div>
          <div class="relative h-48 overflow-hidden">
            <img src="/campsite_cobleland.jpg" alt="Cobleland Campsite" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/800x500/FAF7EE/7D6E23?text=Cobleland+Campsite'"/>
            <span class="absolute top-3 left-3 os-grid-badge text-xs px-2.5 py-1 rounded bg-white/90">OS GRID: NS 539 800</span>
            <span class="absolute top-3 right-3 bg-[#7D6E23] text-white text-[10px] font-bold px-2 py-1 rounded">ELEVATION: 25m</span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-1.5">
                <h3 class="font-display font-bold text-[#111111] text-lg">Cobleland Campsite</h3>
                <span class="text-[#7D6E23] text-xs font-semibold">Gartmore, Stirling</span>
              </div>
              <p class="text-stone-600 text-xs leading-relaxed mb-4">
                {cobleland.desc}
              </p>
            </div>
            <div class="pt-4 border-t border-stone-100 space-y-3">
              <CampsiteBookButton site={cobleland} />
              <CampsiteJournalButton slug={cobleland.journalSlug} />
              <div class="flex items-center justify-between text-xs">
                <a href="https://www.coblelandcampsite.co.uk/" target="_blank" rel="noopener" class="text-[#7D6E23] font-bold hover:underline flex items-center gap-1.5">
                  <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> Visit Website
                </a>
                <button type="button" class="open-dossier-btn text-xs text-stone-600 hover:text-[#111111] font-medium" data-site="cobleland">
                  Drive from Falkirk &rarr;
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Campsite 2: Red Squirrel, Glencoe -->
        <div class="campsite-card bg-white rounded-xl overflow-hidden border-2 border-[#F7BA1E] shadow-md flex flex-col" data-region="highlands">
          <div class="bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-[10px] uppercase tracking-wider px-3 py-1 flex items-center justify-between">
            <span class="flex items-center gap-1.5"><img src="/favicon.svg" alt="" width="14" height="14" class="h-3.5 w-3.5 rounded-[2px] shrink-0" /> {redsquirrel.badge}</span>
            <span class="text-[9px] bg-[#111111] text-[#F7BA1E] px-2 py-0.5 rounded font-mono">{redsquirrel.drive}</span>
          </div>
          <div class="relative h-48 overflow-hidden">
            <img src="/campsite_red_squirrel.jpg" alt="Two-person tent and stove at Red Squirrel Campsite, Glen Coe" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/800x500/FAF7EE/7D6E23?text=Red+Squirrel+Glencoe'"/>
            <span class="absolute top-3 left-3 os-grid-badge text-xs px-2.5 py-1 rounded bg-white/90">OS GRID: NN 105 577</span>
            <span class="absolute top-3 right-3 bg-[#7D6E23] text-white text-[10px] font-bold px-2 py-1 rounded">ELEVATION: 50m</span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-display font-bold text-[#111111] text-lg">Red Squirrel Campsite</h3>
                <span class="text-[#7D6E23] text-xs font-semibold">Glencoe</span>
              </div>
              <p class="text-stone-600 text-xs leading-relaxed mb-4">
                {redsquirrel.desc}
              </p>
            </div>
            <div class="pt-4 border-t border-stone-100 space-y-3">
              <CampsiteBookButton site={redsquirrel} />
              <CampsiteJournalButton slug={redsquirrel.journalSlug} />
              <div class="flex items-center justify-between text-xs">
                <a href="https://redsquirrelcampsite.co.uk/" target="_blank" rel="noopener" class="text-[#7D6E23] font-bold hover:underline flex items-center gap-1.5">
                  <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> Visit Website
                </a>
                <button type="button" class="open-dossier-btn text-xs text-stone-600 hover:text-[#111111] font-medium" data-site="redsquirrel">
                  Drive from Falkirk &rarr;
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Campsite 3: Fidden Farm -->
        <div class="campsite-card bg-white rounded-xl overflow-hidden border-2 border-[#F7BA1E] shadow-md flex flex-col" data-region="highlands">
          <div class="bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-[10px] uppercase tracking-wider px-3 py-1 flex items-center justify-between">
            <span class="flex items-center gap-1.5"><img src="/favicon.svg" alt="" width="14" height="14" class="h-3.5 w-3.5 rounded-[2px] shrink-0" /> {fidden.badge}</span>
            <span class="text-[9px] bg-[#111111] text-[#F7BA1E] px-2 py-0.5 rounded font-mono">{fidden.drive}</span>
          </div>
          <div class="relative h-48 overflow-hidden">
            <img src="/campsite_fidden_farm.jpg" alt="Fidden Farm Campsite" class="w-full h-full object-cover" onerror="this.src='https://placehold.co/800x500/FAF7EE/7D6E23?text=Fidden+Farm'"/>
            <span class="absolute top-3 left-3 os-grid-badge text-xs px-2.5 py-1 rounded bg-white/90">OS GRID: NM 301 214</span>
            <span class="absolute top-3 right-3 bg-[#7D6E23] text-white text-[10px] font-bold px-2 py-1 rounded">ELEVATION: 5m</span>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between mb-2">
                <h3 class="font-display font-bold text-[#111111] text-lg">Fidden Farm Campsite</h3>
                <span class="text-[#7D6E23] text-xs font-semibold">Isle of Mull</span>
              </div>
              <p class="text-stone-600 text-xs leading-relaxed mb-4">
                {fidden.desc}
              </p>
            </div>
            <div class="pt-4 border-t border-stone-100 space-y-3">
              <CampsiteBookButton site={fidden} />
              <CampsiteJournalButton slug={fidden.journalSlug} />
              <div class="flex items-center justify-between text-xs">
                <a href="https://fiddenfarm.co.uk/" target="_blank" rel="noopener" class="text-[#7D6E23] font-bold hover:underline flex items-center gap-1.5">
                  <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i> Visit Website
                </a>
                <button type="button" class="open-dossier-btn text-xs text-stone-600 hover:text-[#111111] font-medium" data-site="fidden">
                  Drive from Falkirk &rarr;
                </button>
              </div>
            </div>
          </div>
        </div>

        <!-- Campsite 4: Loch Chon -->
