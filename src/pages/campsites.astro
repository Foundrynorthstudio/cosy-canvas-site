  function updateMapShowcase(pinKey) {
    const data = campsiteMapData[pinKey];
    if (!data) return;

    document.querySelectorAll('.pin-icon').forEach(p => p.classList.remove('active-map-pin'));
    const activeBtn = document.querySelector(`[data-pin="${pinKey}"] .pin-icon`);
    if (activeBtn) activeBtn.classList.add('active-map-pin');

    document.getElementById('mapCardTag').innerText = data.tag;
    document.getElementById('mapCardDrive').innerText = data.drive;
    document.getElementById('mapCardImg').src = data.img;
    document.getElementById('mapCardElevation').innerText = data.elevation;
    document.getElementById('mapCardTitle').innerText = data.title;
    document.getElementById('mapCardRegion').innerText = data.region;
    document.getElementById('mapCardDesc').innerText = data.desc;
    document.getElementById('mapCardSuitability').innerText = data.suitability;
    document.getElementById('mapCardLink').href = data.website;

    const btn = document.getElementById('mapCardBtn');
    if (btn) {
      btn.onclick = () => openModal(data);
    }
  }

  function openModal(data) {
    document.getElementById('modalTitle').innerText = data.title;
    document.getElementById('modalGridRef').innerText = `OS GRID: ${data.gridRef}`;
    document.getElementById('modalRegion').innerText = data.region;
    document.getElementById('modalElevation').innerText = data.elevation;
    document.getElementById('modalSuitability').innerText = data.suitability;
    document.getElementById('modalWebsiteLink').href = data.website;
    document.getElementById('modalDistance').innerText = data.distance;
    document.getElementById('modalRouteDesc').innerText = data.routeDesc;
    document.getElementById('modalTerrain').innerText = data.terrain;
    document.getElementById('modalDestShort').innerText = data.title.split(' ')[0];

    const modal = document.getElementById('campsiteModal');
    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
    }
  }

  function closeModal() {
    const modal = document.getElementById('campsiteModal');
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    // Pin click listeners
    document.querySelectorAll('.map-pin-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-pin');
        if (key) updateMapShowcase(key);
      });
    });

    // Dossier button click listeners on grid cards
    document.querySelectorAll('.open-dossier-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const key = btn.getAttribute('data-site');
        const data = campsiteMapData[key];
        if (data) openModal(data);
      });
    });

    // Region tab filters
    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const filter = btn.getAttribute('data-filter');
        document.querySelectorAll('.campsite-card').forEach(card => {
          if (filter === 'all' || card.getAttribute('data-region') === filter) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });

    // Modal close handlers
    document.getElementById('closeModalBtn')?.addEventListener('click', closeModal);
    document.getElementById('campsiteModal')?.addEventListener('click', (e) => {
      if (e.target === document.getElementById('campsiteModal')) closeModal();
    });

    // Default to Cobleland
    updateMapShowcase('cobleland');
  });
</script>

