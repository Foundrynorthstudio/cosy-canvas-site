---
import Layout from '../../layouts/Layout.astro';
import { getAllBookings } from '../../lib/booking-store';
import {
  quoteRatRace,
  RAT_RACE_2027,
  RAT_RACE_CAMPING_PASS_NOTE,
  RAT_RACE_EVENT_URL,
  RAT_RACE_GROUP_CAP,
  RAT_RACE_PAYMENTS_ENABLED,
  RAT_RACE_PAYMENTS_PAUSED_MESSAGE,
  RAT_RACE_TENT_CAP,
  RAT_RACE_TENT_META,
  ratRaceInventoryFromBookings,
} from '../../lib/rat-race';
import { getStripePublishableKeyAsync } from '../../lib/stripe-client';

const publishableKey = await getStripePublishableKeyAsync();
const inventory = ratRaceInventoryFromBookings(await getAllBookings());
const initialQuote = quoteRatRace({
  tents: [{ kind: 'bell', guests: 2 }],
  inventory,
});
const siteUrl = Astro.site ? Astro.site.origin : 'https://cosycanvasco.com';
const bell = RAT_RACE_TENT_META.bell;
const group = RAT_RACE_TENT_META.group;
---

<Layout
  title="Rat Race Coast to Coast Glamping 2027 | 5M Bell & 6M Group | The Cosy Canvas Co."
  description={`Saturday-night 5M Bell tent (£${bell.basePrice}) and limited 6M Group tent (£${group.basePrice}) for Rat Race Coast to Coast, 11 September 2027. Morrisons Fort William concierge extra.`}
  image={RAT_RACE_2027.tile}
  keywords="rat race coast to coast camping, rat race glamping 2027, fort william bell tent hire, event camping scotland"
  breadcrumbItems={[
    { name: 'Home', url: siteUrl },
    { name: 'Events', url: `${siteUrl}/events` },
    { name: 'Rat Race', url: `${siteUrl}/events/rat-race` },
  ]}
>
  <div class="bg-[#111111] text-white py-10 md:py-14 border-b border-stone-800 relative z-30 overflow-hidden">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[1.1fr_0.9fr] gap-8 items-center">
      <div>
        <a
          href={RAT_RACE_EVENT_URL}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-block mb-4 hover:opacity-80 transition-opacity"
          aria-label="Rat Race official event page"
        >
          <img src={RAT_RACE_2027.logo} alt="Rat Race" class="h-10 md:h-12 w-auto" />
        </a>
        <span class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest block mb-2 font-bold">
          {RAT_RACE_PAYMENTS_ENABLED ? 'Event partner · bookable now' : 'Event partner · preview only'}
        </span>
        <h1 class="font-display text-3xl md:text-5xl font-black text-white leading-tight">
          Rat Race Coast to Coast
          <span class="block">Under Canvas</span>
        </h1>
        <p class="text-stone-300 text-sm md:text-base mt-3 max-w-xl font-light leading-relaxed">
          Event date: <strong class="text-white font-medium">{RAT_RACE_2027.eventDatesLabel}</strong>.
          You sleep <strong class="text-white font-medium">{RAT_RACE_2027.guestNightLabel}</strong>.
          {RAT_RACE_2027.opsLabel}. 5M Bell tent from £{bell.basePrice} · limited 6M Group £{group.basePrice}.
        </p>
        <div class="flex flex-wrap gap-3 mt-6">
          <a
            href="#book-rat-race"
            class="inline-flex items-center gap-2 rounded-full bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3"
          >
            {RAT_RACE_PAYMENTS_ENABLED ? 'Book Saturday night' : 'Preview packages & pricing'}
          </a>
          <a
            href={RAT_RACE_EVENT_URL}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/30 text-white font-display font-extrabold text-xs uppercase tracking-wider px-6 py-3 hover:bg-white/10"
          >
            Rat Race event page <i class="fa-solid fa-arrow-up-right-from-square text-[10px]"></i>
          </a>
        </div>
      </div>
      <div class="rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-stone-900">
        <img
          src={RAT_RACE_2027.photos.header}
          alt="Glen Coe wilderness under evening cloud, colour-graded for Rat Race 2027"
          class="w-full h-full object-cover aspect-[1200/630]"
        />
      </div>
    </div>
  </div>

  <div class="bg-[#111111]">
    <img
      src={RAT_RACE_2027.photos.deluxeFive}
      alt="5M bell tent ready on the event field"
      class="w-full max-h-56 md:max-h-72 object-cover object-center"
    />
  </div>

  <section class="py-14 border-b border-stone-200/80">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-2 gap-10 lg:items-stretch">
      <article class="flex flex-col h-full">
        <p class="text-[#7D6E23] font-mono text-[11px] uppercase tracking-widest font-bold mb-3">The night</p>
        <h2 class="font-display text-3xl font-black text-[#111111] mb-4">Saturday night under canvas</h2>
        <p class="text-stone-600 leading-relaxed mb-4">
          We pitch on the Glengarry Shinty Club field for Rat Race Coast to Coast. You check in Saturday; we are onsite Friday through Sunday.
        </p>
        <p class="text-stone-600 leading-relaxed mb-4">
          Photos below are from this year’s field. Optional Morrisons Fort William click &amp; collect can be waiting in the tent at check-in.
        </p>
        <ul class="text-sm text-stone-700 space-y-2 mb-6">
          <li class="flex gap-2"><i class="fa-solid fa-flag-checkered text-[#7D6E23] mt-0.5"></i> Enter the race on the <a class="underline font-semibold" href={RAT_RACE_EVENT_URL} target="_blank" rel="noopener noreferrer">official Rat Race page</a></li>
          <li class="flex gap-2"><i class="fa-solid fa-ticket text-[#7D6E23] mt-0.5"></i> {RAT_RACE_CAMPING_PASS_NOTE}</li>
          <li class="flex gap-2"><i class="fa-solid fa-clipboard-check text-[#7D6E23] mt-0.5"></i> Check-in on the field Saturday — we are onsite</li>
          <li class="flex gap-2"><i class="fa-solid fa-basket-shopping text-[#7D6E23] mt-0.5"></i> Optional Morrisons shop, at check-in when you arrive</li>
        </ul>
        <img
          src={RAT_RACE_2027.photos.deluxeBeds}
          alt="Bell tent interior ready for Saturday night"
          class="w-full rounded-3xl object-cover aspect-[4/3] lg:aspect-auto lg:flex-1 lg:min-h-[280px] border border-stone-200"
        />
      </article>
      <div class="flex flex-col gap-4 h-full">
        <article class="rounded-3xl bg-[#F7BA1E] border border-[#F7BA1E] p-6 shrink-0">
          <p class="text-[11px] uppercase tracking-wider font-bold text-[#111111]/60 mb-1">5M</p>
          <h3 class="font-display text-xl font-black text-[#111111] mb-2">Bell tent · £{bell.basePrice}</h3>
          <p class="text-sm text-[#111111]/80">{bell.summary}</p>
          <p class="text-xs text-[#111111]/70 mt-3">{bell.priceBlurb}</p>
        </article>
        <article class={`rounded-3xl bg-white border-2 border-[#F7BA1E] overflow-hidden flex flex-col flex-1 min-h-0 ${inventory.groupSoldOut ? 'opacity-70' : ''}`}>
          <img src={RAT_RACE_2027.photos.deluxeBedsClose} alt="Raised beds ready inside a Cosy Canvas tent" class="w-full h-40 lg:h-auto lg:flex-1 object-cover min-h-[160px]" />
          <div class="p-6">
            <div class="flex items-center justify-between gap-2 mb-1">
              <p class="text-[11px] uppercase tracking-wider font-bold text-[#D4A51E]">6M</p>
              <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full">Limited</span>
            </div>
            <h3 class="font-display text-xl font-black mb-2">Group tent · £{group.basePrice}</h3>
            <p class="text-sm text-stone-600">{group.summary}</p>
            <p class="text-xs text-stone-500 mt-3">
              {group.priceBlurb}
              {inventory.groupSoldOut ? ' Sold out.' : ` ${inventory.remainingGroup} of ${RAT_RACE_GROUP_CAP} left.`}
            </p>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section id="rr-layouts" class="py-16 border-b border-stone-200/80 bg-white">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-[#7D6E23] font-mono text-[11px] uppercase tracking-widest font-bold mb-2">Packages</p>
      <h2 class="font-display text-3xl font-black text-[#111111] mb-3">Choose your tent, then add guests</h2>
      <p class="text-stone-700 text-base md:text-lg leading-relaxed max-w-3xl mb-8 font-medium">
        Pick your tent, then add guests. Up to 4 people? Book a 5M tent. 4 to 6? Book a Group tent. Bigger group? Add another tent. Only {RAT_RACE_TENT_CAP} tents on the field, including up to {RAT_RACE_GROUP_CAP} Group tents.
      </p>

      <div class="grid md:grid-cols-2 gap-4">
        <article class={`rounded-3xl border border-stone-200 bg-[#FAF7EE] p-5 ${inventory.bellSoldOut ? 'opacity-70' : ''}`}>
          <p class="text-[11px] uppercase tracking-wider font-bold text-stone-500 mb-1">5M</p>
          <h3 class="font-display text-xl font-black text-[#111111]">Bell tent · £{bell.basePrice}</h3>
          <p class="text-sm text-stone-600 mt-2">{bell.summary}</p>
          <p class="text-xs text-stone-500 mt-3">
            {bell.priceBlurb}
            {inventory.bellSoldOut ? ' Sold out.' : ''}
          </p>
        </article>
        <article class={`rounded-3xl border p-5 ${inventory.groupSoldOut ? 'border-stone-200 bg-stone-100 opacity-70' : 'border-stone-200 bg-white'}`}>
          <div class="flex items-center justify-between gap-2 mb-1">
            <p class="text-[11px] uppercase tracking-wider font-bold text-stone-500">6M</p>
            <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-100 px-2 py-0.5 rounded-full">Limited</span>
          </div>
          <h3 class="font-display text-xl font-black text-[#111111]">Group tent · £{group.basePrice}</h3>
          <p class="text-sm text-stone-600 mt-2">{group.summary}</p>
          <p class="text-xs text-stone-500 mt-3">
            {group.priceBlurb}
            {inventory.groupSoldOut ? ' Sold out.' : ` ${inventory.remainingGroup} of ${RAT_RACE_GROUP_CAP} left.`}
          </p>
        </article>
      </div>
    </div>
  </section>

  <section id="book-rat-race" class="py-16 bg-[#FAF7EE]">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 grid lg:grid-cols-[0.95fr_1.05fr] gap-8 items-start">
      <div>
        <p class="text-[#7D6E23] font-mono text-[11px] uppercase tracking-widest font-bold mb-2">Booking</p>
        <h2 class="font-display text-3xl font-black text-[#111111] mb-3">Book your tent(s)</h2>
        <p class="text-stone-600 text-sm leading-relaxed mb-4">
          Choose a 5M Bell or 6M Group tent, set guests, and add more tents if you need them. Setup is included. Pay 50% now (balance the week before), or Pay Up — two months upfront, then six monthly payments. £200 refundable security deposit per tent is taken on a card reader at Saturday check-in.
        </p>
        <p class="text-sm text-stone-700 rounded-2xl border border-amber-200 bg-amber-50 p-4 mb-6">
          {RAT_RACE_CAMPING_PASS_NOTE}
        </p>
        <div class="rounded-3xl bg-white border border-stone-200 overflow-hidden text-sm text-stone-600">
          <img src={RAT_RACE_2027.photos.morrisons} alt="Morrisons Fort William shop" class="w-full h-44 object-cover" />
          <div class="p-6 space-y-3">
            <p class="font-display font-black text-[#111111]">Morrisons concierge</p>
            <p>
              Want food and drink waiting in the tent when you check in? Tick Morrisons on the booking and we’ll email how to build a click &amp; collect order at Morrisons in Fort William. Send the list back; we pay for it and charge you on a Stripe link — basket total plus 10% (capped at £15). Not included in the tent fee.
            </p>
          </div>
        </div>
      </div>

      <div
        class="rounded-3xl bg-white border border-stone-200 shadow-xl p-6 sm:p-8 space-y-6"
        id="rr-book-panel"
        data-tent-meta={JSON.stringify(RAT_RACE_TENT_META)}
        data-inventory={JSON.stringify(inventory)}
      >
        {inventory.soldOut ? (
          <div class="rounded-2xl border border-red-200 bg-red-50 p-4 text-sm text-red-900">
            <p class="font-display font-black">Sold out</p>
            <p>All {RAT_RACE_TENT_CAP} tents for Rat Race 2027 are booked.</p>
          </div>
        ) : (
          <p class="text-xs text-stone-500">
            {inventory.remainingTents} of {RAT_RACE_TENT_CAP} tents left
            {inventory.groupSoldOut ? ' · Group tents sold out' : ` · ${inventory.remainingGroup} of ${RAT_RACE_GROUP_CAP} Group left`}
          </p>
        )}

        <fieldset class="space-y-2">
          <legend class="text-xs font-display font-black uppercase tracking-wide text-stone-800 mb-2">Tent type</legend>
          <label class={`flex gap-3 rounded-2xl border-2 p-4 ${inventory.bellSoldOut ? 'border-stone-200 opacity-50 cursor-not-allowed' : 'border-[#F7BA1E] bg-[#FAF7EE] cursor-pointer has-[:checked]:border-[#F7BA1E]'}`}>
            <input type="radio" name="rr-package" value="bell" checked class="mt-1" disabled={inventory.bellSoldOut} />
            <span>
              <span class="block font-display font-black">5M Bell tent · £{bell.basePrice}{inventory.bellSoldOut ? ' · Sold out' : ''}</span>
              <span class="text-xs text-stone-500">{bell.priceBlurb}</span>
            </span>
          </label>
          <label class={`flex gap-3 rounded-2xl border-2 p-4 ${inventory.groupSoldOut ? 'border-stone-200 opacity-50 cursor-not-allowed' : 'border-stone-200 cursor-pointer has-[:checked]:border-[#F7BA1E] has-[:checked]:bg-[#FAF7EE]'}`}>
            <input type="radio" name="rr-package" value="group" class="mt-1" disabled={inventory.groupSoldOut} />
            <span>
              <span class="block font-display font-black">6M Group tent · £{group.basePrice} <span class="text-[10px] uppercase tracking-wider text-amber-800">Limited</span>{inventory.groupSoldOut ? ' · Sold out' : ''}</span>
              <span class="text-xs text-stone-500">{group.priceBlurb}{inventory.groupSoldOut ? '' : ` ${inventory.remainingGroup} of ${RAT_RACE_GROUP_CAP} left.`}</span>
            </span>
          </label>
        </fieldset>

        <div>
          <label class="block text-xs font-display font-black uppercase tracking-wide text-stone-800 mb-2" for="rr-guests">Guests in this tent</label>
          <div class="flex items-center gap-3">
            <button type="button" id="rr-guests-minus" class="w-11 h-11 rounded-2xl border border-stone-300 font-bold text-lg hover:bg-stone-50">−</button>
            <input id="rr-guests" type="number" min="1" max="4" value="2" class="w-full bg-stone-50 border border-stone-300 rounded-2xl p-3 text-center font-display font-black text-xl" />
            <button type="button" id="rr-guests-plus" class="w-11 h-11 rounded-2xl border border-stone-300 font-bold text-lg hover:bg-stone-50">+</button>
          </div>
          <p id="rr-guest-cap" class="text-[11px] text-stone-500 mt-2">£295 for up to 2 guests. Extra guests £50 each, sleeps up to 4.</p>
        </div>

        <button
          type="button"
          id="rr-add-tent"
          class="w-full rounded-full border-2 border-[#111111] text-[#111111] font-display font-extrabold text-xs uppercase tracking-wider py-3 hover:bg-[#111111] hover:text-[#F7BA1E]"
          disabled={inventory.soldOut}
        >
          Add tent to booking
        </button>

        <div>
          <p class="text-xs font-display font-black uppercase tracking-wide text-stone-800 mb-2">Your tents</p>
          <div id="rr-basket" class="space-y-2 text-sm"></div>
          <p id="rr-basket-empty" class="text-xs text-stone-500">No tents yet — add at least one to see the quote.</p>
        </div>

        <p class="text-sm text-stone-600 rounded-2xl bg-stone-50 border border-stone-200 p-4">
          <strong class="text-[#111111]">Saturday night only.</strong> Check-in Saturday 11 September, out Sunday 12. We are on the field Friday to Sunday.
        </p>

        <label class="flex gap-3 items-start text-sm text-stone-700">
          <input id="rr-concierge" type="checkbox" class="mt-1" />
          <span>Add Morrisons Fort William concierge. We’ll get in touch with order instructions.</span>
        </label>

        <div id="rr-quote" class="rounded-2xl bg-[#111111] text-white p-5 space-y-2 text-sm relative" data-initial={JSON.stringify(initialQuote)}>
          <p class="font-mono text-[10px] uppercase tracking-widest text-[#F7BA1E]">Quote</p>
          <p id="rr-quote-tents" class="font-display text-xl font-black">{initialQuote.tentType} · {initialQuote.guests} guests</p>
          <div id="rr-quote-lines" class="space-y-1 text-stone-300 text-xs">
            {initialQuote.lines.map((line) => (
              <div class="flex justify-between gap-3">
                <span>{line.title}</span>
                <span>{line.price === 0 ? 'Included' : `£${line.price.toFixed(2)}`}</span>
              </div>
            ))}
          </div>
          <div class="border-t border-white/10 pt-2 flex justify-between font-bold">
            <span>Saturday total</span>
            <span id="rr-quote-total">£{initialQuote.totalRentalPrice.toFixed(2)}</span>
          </div>
          <p class="text-xs text-stone-400" id="rr-quote-pay">
            Pay today: £{initialQuote.depositAmount.toFixed(2)} ({initialQuote.depositPercent}%)
          </p>
          <p class="text-xs text-stone-400" id="rr-quote-security">{initialQuote.securityCheckinNote}</p>
          <p id="rr-stock-error" class="hidden text-xs text-amber-300"></p>
        </div>

        {RAT_RACE_PAYMENTS_ENABLED ? (
          <fieldset class="space-y-2">
            <legend class="text-xs font-display font-black uppercase tracking-wide text-stone-800 mb-2">How you pay the stay</legend>
            <label class="flex gap-3 rounded-2xl border-2 border-[#F7BA1E] bg-[#FAF7EE] p-4 cursor-pointer">
              <input type="radio" name="rr-pay-plan" value="deposit" checked class="mt-1" />
              <span>
                <span class="block font-display font-black">Pay the stay</span>
                <span class="text-xs text-stone-500">50% to book. Balance collected the week before.</span>
              </span>
            </label>
            <label id="rr-pay-up-label" class="flex gap-3 rounded-2xl border-2 border-stone-200 p-4 cursor-pointer has-[:checked]:border-[#F7BA1E] has-[:checked]:bg-[#FAF7EE]">
              <input type="radio" name="rr-pay-plan" value="instalment" class="mt-1" id="rr-pay-instalment" />
              <span>
                <span class="block font-display font-black">Pay Up · 2 months now, 6 after</span>
                <span class="text-xs text-stone-500" id="rr-pay-up-copy">
                  Two months of the stay today, then six interest-free months on the same card. Stripe runs the subscription — Klarna energy, not Klarna.
                </span>
              </span>
            </label>
          </fieldset>
        ) : (
          <div class="rounded-2xl border border-amber-300 bg-amber-50 p-4 text-sm text-amber-950 space-y-1">
            <p class="font-display font-black text-[#111111]">Payments paused</p>
            <p>{RAT_RACE_PAYMENTS_PAUSED_MESSAGE}</p>
            <p class="text-xs text-amber-900/80">Click below to see the confirmation page guests will get once bookings open.</p>
          </div>
        )}

        <button
          type="button"
          id="rr-open-checkout"
          data-payments-enabled={RAT_RACE_PAYMENTS_ENABLED ? '1' : '0'}
          class="w-full rounded-full bg-[#F7BA1E] text-[#111111] font-display font-extrabold text-sm uppercase tracking-wider py-4"
        >
          {RAT_RACE_PAYMENTS_ENABLED ? 'Continue to payment' : 'Preview confirmation page'}
        </button>
      </div>
    </div>
  </section>

  <div
    id="rr-checkout-modal"
    class="fixed inset-0 z-50 hidden items-center justify-center p-4 sm:p-6 overflow-y-auto bg-black/75 backdrop-blur-xs"
    data-stripe-pk={publishableKey}
  >
    <div class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl border border-stone-200 overflow-hidden my-8">
      <div class="bg-[#111111] text-white p-6 border-b border-stone-800 flex justify-between items-center">
        <div>
          <span class="text-[#F7BA1E] font-mono text-[10px] uppercase tracking-widest font-bold block">Rat Race 2027</span>
          <h3 id="rr-modal-heading" class="text-xl font-display font-black text-white">Guest details</h3>
        </div>
        <button type="button" id="rr-close-modal" class="w-9 h-9 rounded-full bg-stone-800 text-stone-300" aria-label="Close">
          <i class="fa-solid fa-xmark"></i>
        </button>
      </div>
      <div class="bg-[#FAF7EE] border-b border-stone-200 px-6 py-3 text-xs font-bold" id="rr-modal-summary"></div>
      <div id="rr-modal-error" class="hidden mx-6 mt-4 bg-red-50 border border-red-200 text-red-800 text-xs rounded-xl p-3"></div>
      <div id="rr-modal-step-details" class="p-6 space-y-3">
        <form id="rr-guest-form" autocomplete="on" class="space-y-3">
        <input id="rr-name" name="name" autocomplete="name" placeholder="Lead guest name *" class="w-full rounded-2xl border border-stone-300 p-3 text-sm" />
        <input id="rr-email" name="email" type="email" autocomplete="email" placeholder="Email *" class="w-full rounded-2xl border border-stone-300 p-3 text-sm" />
        <input id="rr-phone" name="tel" type="tel" autocomplete="tel" placeholder="Phone *" class="w-full rounded-2xl border border-stone-300 p-3 text-sm" />
        <input id="rr-address-line1" name="address-line1" autocomplete="address-line1" placeholder="Address line 1" class="w-full rounded-2xl border border-stone-300 p-3 text-sm" />
        <input id="rr-address-line2" name="address-line2" autocomplete="address-line2" placeholder="Address line 2 (optional)" class="w-full rounded-2xl border border-stone-300 p-3 text-sm" />
        <div class="grid grid-cols-2 gap-3">
          <input id="rr-address-city" name="address-level2" autocomplete="address-level2" placeholder="Town / city" class="w-full rounded-2xl border border-stone-300 p-3 text-sm" />
          <input id="rr-address-postcode" name="postal-code" autocomplete="postal-code" placeholder="Postcode" class="w-full rounded-2xl border border-stone-300 p-3 text-sm uppercase" />
        </div>
        <textarea id="rr-notes" rows="3" autocomplete="off" placeholder="Crew notes, allergies, shopping-list timing" class="w-full rounded-2xl border border-stone-300 p-3 text-sm"></textarea>
        <button type="submit" id="rr-pay" class="w-full rounded-full bg-[#111111] text-[#F7BA1E] font-display font-extrabold text-xs uppercase tracking-wider py-3">
          Continue to Stripe
        </button>
        </form>
      </div>
      <div id="rr-modal-step-payment" class="hidden p-6">
        <div id="rr-stripe-loading" class="py-10 text-center text-sm">Connecting to Stripe…</div>
        <div id="rr-stripe-embedded-checkout" class="min-h-[350px]"></div>
        <div id="rr-stripe-placeholder" class="hidden bg-amber-50 border border-amber-300 rounded-2xl p-5 text-xs space-y-3">
          <p class="font-bold">Stripe keys not in this environment yet. Quote is ready.</p>
          <a href="/booking/success" class="inline-block bg-[#111111] text-[#F7BA1E] px-5 py-3 rounded-xl font-display font-bold text-xs uppercase">Preview confirmation</a>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script is:inline src="https://js.stripe.com/v3/"></script>
<script is:inline>
  const bookPanel = document.getElementById('rr-book-panel');
  const tentMeta = JSON.parse(bookPanel?.getAttribute('data-tent-meta') || '{}');
  const inventoryBoot = JSON.parse(bookPanel?.getAttribute('data-inventory') || '{}');
  const guestsInput = document.getElementById('rr-guests');
  const quoteEl = document.getElementById('rr-quote');
  const basketEl = document.getElementById('rr-basket');
  const basketEmpty = document.getElementById('rr-basket-empty');
  const stockError = document.getElementById('rr-stock-error');
  let quote = JSON.parse(quoteEl.getAttribute('data-initial') || '{}');
  let stripeCheckout = null;
  const BELL_GUEST_LIMIT_MESSAGE =
    'Up to 4 per 5M tent. Choose a Group tent for 4 to 6, or add another tent.';
  /** @type {{ kind: string, guests: number }[]} */
  let basket = [{ kind: 'bell', guests: 2 }];

  function packageKind() {
    return document.querySelector('input[name="rr-package"]:checked')?.value || 'bell';
  }
  function paymentPlan() {
    return document.querySelector('input[name="rr-pay-plan"]:checked')?.value || 'deposit';
  }
  function metaFor(kind) {
    return tentMeta[kind] || tentMeta.bell;
  }
  function clampGuests(kind, n) {
    const meta = metaFor(kind);
    const value = Math.round(Number(n) || meta.minGuests);
    return Math.min(meta.maxGuests, Math.max(meta.minGuests, value));
  }
  function syncGuestStepper(options = {}) {
    const kind = packageKind();
    const meta = metaFor(kind);
    const raw = Math.round(Number(guestsInput.value) || meta.minGuests);
    const guests = clampGuests(kind, raw);
    guestsInput.min = String(meta.minGuests);
    guestsInput.max = String(meta.maxGuests);
    guestsInput.value = String(guests);
    const cap = document.getElementById('rr-guest-cap');
    if (cap) {
      if (kind === 'bell' && options.overLimit) {
        cap.textContent = BELL_GUEST_LIMIT_MESSAGE;
        cap.classList.remove('text-stone-500');
        cap.classList.add('text-amber-800');
      } else {
        cap.textContent = meta.priceBlurb;
        cap.classList.add('text-stone-500');
        cap.classList.remove('text-amber-800');
      }
    }
  }
  function moneyLabel(price) {
    return Number(price) === 0 ? 'Included' : `£${Number(price).toFixed(2)}`;
  }
  function dueToday(q) {
    if (paymentPlan() === 'instalment' && q.payMonthly?.available) return Number(q.payMonthly.totalDueToday);
    return Number(q.totalDueToday);
  }
  function renderBasket() {
    if (!basket.length) {
      basketEl.innerHTML = '';
      basketEmpty.classList.remove('hidden');
      return;
    }
    basketEmpty.classList.add('hidden');
    basketEl.innerHTML = basket
      .map((line, index) => {
        const meta = metaFor(line.kind);
        return `<div class="flex items-center justify-between gap-3 rounded-2xl border border-stone-200 bg-stone-50 px-3 py-2">
          <span class="font-display font-bold text-[#111111]">${meta.sizeLabel} ${meta.label} · ${line.guests} guest${line.guests === 1 ? '' : 's'}</span>
          <button type="button" class="rr-remove-tent text-xs font-bold uppercase tracking-wider text-red-700" data-index="${index}">Remove</button>
        </div>`;
      })
      .join('');
    basketEl.querySelectorAll('.rr-remove-tent').forEach((btn) => {
      btn.addEventListener('click', () => {
        basket.splice(Number(btn.getAttribute('data-index')), 1);
        refreshQuote();
      });
    });
  }
  function renderPayCopy(q) {
    const payEl = document.getElementById('rr-quote-pay');
    const instalment = paymentPlan() === 'instalment' && q.payMonthly?.available;
    if (instalment) {
      const m = q.payMonthly;
      payEl.textContent =
        `Pay Up today: 2 months £${Number(m.upfrontAmount).toFixed(2)}. Then ${m.monthlyCount} × £${Number(m.monthlyAmount).toFixed(2)} (first ${m.firstMonthlyDate}, last ${m.lastMonthlyDate}).`;
    } else if (q.tentCount) {
      payEl.textContent = `Pay today: £${Number(q.depositAmount).toFixed(2)} (${q.depositPercent}%)`;
    } else {
      payEl.textContent = 'Add a tent to see what is due today.';
    }
    const securityEl = document.getElementById('rr-quote-security');
    if (securityEl) securityEl.textContent = q.securityCheckinNote || '';
    const copy = document.getElementById('rr-pay-up-copy');
    const radio = document.getElementById('rr-pay-instalment');
    if (radio && copy) {
      if (q.payMonthly?.available) {
        radio.disabled = false;
        copy.textContent =
          `Two months of the stay (£${Number(q.payMonthly.upfrontAmount).toFixed(2)}) today, then ${q.payMonthly.monthlyCount} × £${Number(q.payMonthly.monthlyAmount).toFixed(2)} on a Stripe subscription. Klarna energy, not Klarna.`;
      } else {
        if (paymentPlan() === 'instalment') {
          const depositRadio = document.querySelector('input[name="rr-pay-plan"][value="deposit"]');
          if (depositRadio) depositRadio.checked = true;
        }
        radio.disabled = true;
        copy.textContent = q.payMonthly?.reason || 'Pay Up is not available this close to the Saturday night.';
      }
    }
    const summary = document.getElementById('rr-modal-summary');
    if (summary && q.tentCount) {
      summary.textContent = `${q.tentType} · Saturday night · ${q.guests} guests · due today £${dueToday(q).toFixed(2)}`;
    }
    if (stockError) {
      if (q.stockOk === false) {
        stockError.textContent = q.stockError || 'Sold out.';
        stockError.classList.remove('hidden');
      } else {
        stockError.classList.add('hidden');
      }
    }
  }

  async function refreshQuote() {
    renderBasket();
    if (!basket.length) {
      document.getElementById('rr-quote-tents').textContent = 'No tents yet';
      document.getElementById('rr-quote-lines').innerHTML = '';
      document.getElementById('rr-quote-total').textContent = '£0.00';
      document.getElementById('rr-quote-pay').textContent = 'Add a tent to see what is due today.';
      document.getElementById('rr-quote-security').textContent = '';
      return;
    }
    const response = await fetch('/api/rat-race-quote', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ tents: basket }),
    });
    quote = await response.json();
    document.getElementById('rr-quote-tents').textContent = `${quote.tentType} · ${quote.guests} guests · Saturday`;
    document.getElementById('rr-quote-lines').innerHTML = quote.lines
      .map((line) => `<div class="flex justify-between gap-3"><span>${line.title}</span><span>${moneyLabel(line.price)}</span></div>`)
      .join('');
    document.getElementById('rr-quote-total').textContent = `£${Number(quote.totalRentalPrice).toFixed(2)}`;
    renderPayCopy(quote);
  }

  document.getElementById('rr-guests-minus').addEventListener('click', () => {
    guestsInput.value = String(clampGuests(packageKind(), Number(guestsInput.value) - 1));
    syncGuestStepper();
  });
  document.getElementById('rr-guests-plus').addEventListener('click', () => {
    const kind = packageKind();
    const meta = metaFor(kind);
    const next = Number(guestsInput.value) + 1;
    if (kind === 'bell' && next > meta.maxGuests) {
      syncGuestStepper({ overLimit: true });
      return;
    }
    guestsInput.value = String(clampGuests(kind, next));
    syncGuestStepper();
  });
  guestsInput.addEventListener('change', () => {
    const kind = packageKind();
    const meta = metaFor(kind);
    const raw = Math.round(Number(guestsInput.value) || meta.minGuests);
    syncGuestStepper({ overLimit: kind === 'bell' && raw > meta.maxGuests });
  });
  document.querySelectorAll('input[name="rr-package"]').forEach((el) => {
    el.addEventListener('change', () => syncGuestStepper());
  });
  document.querySelectorAll('input[name="rr-pay-plan"]').forEach((el) => {
    el.addEventListener('change', () => renderPayCopy(quote));
  });
  document.getElementById('rr-add-tent').addEventListener('click', () => {
    if (inventoryBoot.soldOut) return;
    const kind = packageKind();
    if (kind === 'bell' && inventoryBoot.bellSoldOut) return;
    if (kind === 'group' && inventoryBoot.groupSoldOut) return;
    basket.push({ kind, guests: clampGuests(kind, guestsInput.value) });
    refreshQuote();
  });

  const modal = document.getElementById('rr-checkout-modal');
  function openModal() {
    refreshQuote();
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    document.body.style.overflow = 'hidden';
  }
  function closeModal() {
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.body.style.overflow = 'auto';
  }
  document.getElementById('rr-open-checkout').addEventListener('click', () => {
    if (!basket.length) {
      alert('Add at least one tent first.');
      return;
    }
    if (quote.stockOk === false) {
      alert(quote.stockError || 'Sold out.');
      return;
    }
    const btn = document.getElementById('rr-open-checkout');
    if (btn?.getAttribute('data-payments-enabled') !== '1') {
      const params = new URLSearchParams({
        preview: 'rat-race',
        tents: JSON.stringify(basket),
        plan: paymentPlan(),
      });
      if (document.getElementById('rr-concierge')?.checked) params.set('concierge', '1');
      window.location.href = `/booking/success?${params.toString()}`;
      return;
    }
    openModal();
  });
  document.getElementById('rr-close-modal').addEventListener('click', closeModal);

  document.getElementById('rr-guest-form').addEventListener('submit', async (event) => {
    event.preventDefault();
    const errorEl = document.getElementById('rr-modal-error');
    errorEl.classList.add('hidden');
    const name = document.getElementById('rr-name').value.trim();
    const email = document.getElementById('rr-email').value.trim();
    const phone = document.getElementById('rr-phone').value.trim();
    if (!name || !email || !phone) {
      errorEl.textContent = 'Name, email and phone are required.';
      errorEl.classList.remove('hidden');
      return;
    }
    const payBtn = document.getElementById('rr-pay');
    payBtn.disabled = true;
    try {
      const response = await fetch('/api/create-rat-race-checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          tents: basket,
          conciergeRequested: document.getElementById('rr-concierge').checked,
          customerName: name,
          customerEmail: email,
          customerPhone: phone,
          customerAddress: [
            document.getElementById('rr-address-line1').value.trim(),
            document.getElementById('rr-address-line2').value.trim(),
            document.getElementById('rr-address-city').value.trim(),
            document.getElementById('rr-address-postcode').value.trim().toUpperCase(),
          ].filter(Boolean).join(', '),
          specialRequests: document.getElementById('rr-notes').value.trim(),
          paymentPlan: paymentPlan(),
        }),
      });
      const data = await response.json();
      if (!response.ok && !data.isPlaceholderKey) {
        errorEl.textContent = data.error || 'Could not start payment.';
        errorEl.classList.remove('hidden');
        payBtn.disabled = false;
        return;
      }
      document.getElementById('rr-modal-step-details').classList.add('hidden');
      document.getElementById('rr-modal-step-payment').classList.remove('hidden');
      document.getElementById('rr-modal-heading').textContent = 'Secure payment';
      if (!response.ok || !data.clientSecret) {
        document.getElementById('rr-stripe-loading').classList.add('hidden');
        document.getElementById('rr-stripe-placeholder').classList.remove('hidden');
        return;
      }
      const pk = modal.getAttribute('data-stripe-pk') || '';
      const stripe = window.Stripe(pk);
      stripeCheckout = stripe.createEmbeddedCheckoutPage
        ? await stripe.createEmbeddedCheckoutPage({ clientSecret: data.clientSecret })
        : await stripe.initEmbeddedCheckout({ clientSecret: data.clientSecret });
      document.getElementById('rr-stripe-loading').classList.add('hidden');
      stripeCheckout.mount('#rr-stripe-embedded-checkout');
    } catch (err) {
      errorEl.textContent = err.message || 'Could not start payment.';
      errorEl.classList.remove('hidden');
      payBtn.disabled = false;
    }
  });

  syncGuestStepper();
  refreshQuote();
</script>
