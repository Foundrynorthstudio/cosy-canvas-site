---
import Layout from "../../layouts/Layout.astro";
import { capturePaidBooking } from "../../lib/booking-capture";
import { isDiyFulfillment } from "../../lib/booking";
import {
  DEPOT,
  depotMapsUrl,
  depotW3wLabel,
  depotW3wUrl,
  depotWhat3Words,
} from "../../lib/depot";
import { getStripe } from "../../lib/stripe-client";
import type { BookingDetails } from "../../lib/email";

const sessionId = Astro.url.searchParams.get("session_id");

let booking: BookingDetails | null = null;
let errorMsg = "";
const diyCollection = {
  hours: DEPOT.hoursShort,
  hoursNote: DEPOT.hoursNote,
  w3w: depotW3wLabel(),
  w3wUrl: depotW3wUrl(),
  mapsUrl: depotMapsUrl(),
  hasPin: Boolean(depotWhat3Words()),
};

if (sessionId) {
  const stripe = getStripe();
  if (stripe) {
    try {
      const session = await stripe.checkout.sessions.retrieve(sessionId, {
        expand: ['payment_intent'],
      });
      const captured = await capturePaidBooking(session, Astro.url.origin);
      if (captured) {
        booking = captured;
      }
    } catch (err: any) {
      console.error("Error retrieving Stripe session:", err);
      errorMsg = "Unable to retrieve real-time booking session details.";
    }
  } else {
    // In dev / demo mode
    booking = {
      bookingRef: `CC-${Math.floor(100000 + Math.random() * 900000)}`,
      customerName: "Alex Campbell",
      customerEmail: "alex@example.com",
      customerPhone: "+44 7700 900123",
      customerAddress: "14 Highland Way, Edinburgh, EH1 2NG",
      campsiteLocation: "Loch Lomond Holiday Park (Pitch 14)",
      specialRequests: "Arriving around 4pm after hillwalking.",
      checkinDate: "2026-06-12",
      checkoutDate: "2026-06-15",
      nights: 3,
      guests: 4,
      tentType: "5M Bell Tent",
      beddingTier: "Bedding: Cosy Camping Luxury",
      beddingPrice: 140,
      addons: [
        { title: "Cosy Kitchen Setup", price: 60 },
        { title: "Cosy Living Lounge", price: 65 },
      ],
      fulfillment: "Cosy Camping Deluxe Setup & Pitching",
      fulfillmentPrice: 225,
      totalRentalPrice: 665.75,
      depositPercent: 50,
      depositAmount: 332.88,
      securityDeposit: 200,
      totalPaidToday: 532.88,
      remainingBalance: 332.87,
      balanceDueDate: "15 May 2026",
    };
  }
}
---

<Layout
  title="Booking Confirmed | The Cosy Canvas Co."
  description="Thank you for booking with The Cosy Canvas Co. Your Scottish glamping stay is confirmed."
>
  <div class="bg-[#111111] text-white py-12 md:py-16 border-b border-stone-800 relative z-30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <div class="w-16 h-16 bg-[#F7BA1E] text-[#111111] rounded-full flex items-center justify-center text-3xl mx-auto mb-4 shadow-lg shadow-[#F7BA1E]/20 animate-bounce">
        <i class="fa-solid fa-check"></i>
      </div>
      <span class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest block mb-1 font-bold">PAYMENT & RESERVATION CONFIRMED</span>
      <h1 class="font-display text-3xl md:text-5xl font-black text-white">
        You're Going Glamping!
      </h1>
      <p class="text-stone-300 text-sm md:text-base mt-2 max-w-xl mx-auto font-light leading-relaxed">
        Thank you for your reservation. A confirmation email with receipt and arrival details has been sent to your inbox.
      </p>
    </div>
  </div>

  <section class="py-12 md:py-16 bg-stone-50 min-h-screen">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {booking ? (
        <div class="space-y-8">
          <!-- Reference & Status Header Card -->
          <div class="bg-white rounded-3xl p-6 md:p-8 shadow-md border border-stone-200 flex flex-wrap items-center justify-between gap-4">
            <div>
              <span class="text-xs uppercase tracking-wider font-bold text-stone-400 block mb-1">Booking Reference</span>
              <span class="text-2xl md:text-3xl font-display font-black text-[#111111] font-mono tracking-wide">{booking.bookingRef}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="bg-emerald-100 text-emerald-800 border border-emerald-300 text-xs font-display font-bold px-3.5 py-1.5 rounded-full flex items-center gap-1.5 uppercase tracking-wider">
                <i class="fa-solid fa-circle-check text-emerald-600"></i> Deposit Confirmed
              </span>
              <button
                type="button"
                onclick="window.print()"
                class="hidden sm:inline-flex items-center gap-1.5 text-xs font-display font-bold text-stone-700 bg-stone-100 hover:bg-stone-200 border border-stone-300 px-3.5 py-1.5 rounded-full transition cursor-pointer"
              >
                <i class="fa-solid fa-print"></i> Print Receipt
              </button>
            </div>
          </div>

          <!-- Main Details Grid -->
          <div class="grid md:grid-cols-2 gap-6">
            <!-- Left: Stay & Customer Information -->
            <div class="bg-white rounded-3xl p-6 md:p-8 shadow-md border border-stone-200 space-y-6">
              <div>
                <h2 class="text-lg font-display font-black text-[#111111] border-b border-stone-100 pb-3 flex items-center gap-2">
                  <i class="fa-solid fa-calendar-check text-[#7D6E23]"></i> Stay & Dates
                </h2>
                <div class="mt-4 space-y-3 text-xs">
                  <div class="flex justify-between py-1 border-b border-stone-100">
                    <span class="text-stone-500">Check-In:</span>
                    <span class="font-bold text-[#111111]">{booking.checkinDate} (From 3:00 PM)</span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-stone-100">
                    <span class="text-stone-500">Check-Out:</span>
                    <span class="font-bold text-[#111111]">{booking.checkoutDate} (By 11:00 AM)</span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-stone-100">
                    <span class="text-stone-500">Duration:</span>
                    <span class="font-bold text-[#111111]">{booking.nights} Nights</span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-stone-100">
                    <span class="text-stone-500">Guest Count:</span>
                    <span class="font-bold text-[#111111]">{booking.guests} Guests</span>
                  </div>
                </div>
              </div>

              <div>
                <h2 class="text-lg font-display font-black text-[#111111] border-b border-stone-100 pb-3 flex items-center gap-2">
                  <i class="fa-solid fa-map-pin text-[#7D6E23]"></i> Campsite & Delivery
                </h2>
                <div class="mt-4 space-y-3 text-xs">
                  <div>
                    <span class="text-stone-500 block mb-0.5">Destination Campsite / Pitch:</span>
                    <span class="font-bold text-[#111111] text-sm block">{booking.campsiteLocation}</span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-stone-100">
                    <span class="text-stone-500">Fulfillment Method:</span>
                    <span class="font-bold text-[#111111]">{booking.fulfillment}</span>
                  </div>
                  {booking.specialRequests && (
                    <div class="pt-2">
                      <span class="text-stone-500 block mb-0.5">Special Requests:</span>
                      <p class="text-stone-700 italic bg-stone-50 p-2.5 rounded-xl border border-stone-200">{booking.specialRequests}</p>
                    </div>
                  )}
                  {booking.specialRequests?.toLowerCase().includes('morrisons') && (
                    <div class="mt-4 rounded-2xl border border-[#F7BA1E] bg-[#FAF7EE] p-4 text-xs text-stone-700">
                      <p class="font-display font-black text-[#111111] mb-1">Morrisons Fort William concierge</p>
                      <p>Send your shopping list to hello@cosycanvasco.com. We click-and-collect in Fort William, then send a payment link for the basket plus 10%.</p>
                    </div>
                  )}
                </div>
              </div>

              <div>
                <h2 class="text-lg font-display font-black text-[#111111] border-b border-stone-100 pb-3 flex items-center gap-2">
                  <i class="fa-solid fa-user text-[#7D6E23]"></i> Lead Guest Contact
                </h2>
                <div class="mt-4 space-y-2 text-xs">
                  <div class="flex justify-between">
                    <span class="text-stone-500">Name:</span>
                    <span class="font-bold text-[#111111]">{booking.customerName}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-stone-500">Email:</span>
                    <span class="font-bold text-[#111111]">{booking.customerEmail}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-stone-500">Phone:</span>
                    <span class="font-bold text-[#111111]">{booking.customerPhone}</span>
                  </div>
                </div>
              </div>
            </div>

            <!-- Right: Equipment Breakdown & Financial Summary -->
            <div class="bg-white rounded-3xl p-6 md:p-8 shadow-md border border-stone-200 space-y-6">
              <div>
                <h2 class="text-lg font-display font-black text-[#111111] border-b border-stone-100 pb-3 flex items-center gap-2">
                  <i class="fa-solid fa-campground text-[#7D6E23]"></i> Selected Equipment
                </h2>
                <div class="mt-4 space-y-2 text-xs">
                  <div class="flex justify-between py-1 border-b border-stone-100">
                    <span class="font-bold text-[#111111]">{booking.tentType}</span>
                    <span class="text-stone-500">Included</span>
                  </div>
                  <div class="flex justify-between py-1 border-b border-stone-100">
                    <span class="text-stone-700">{booking.beddingTier}</span>
                    <span class="font-bold text-[#111111]">£{booking.beddingPrice.toFixed(2)}</span>
                  </div>
                  {booking.addons.map((a) => (
                    <div class="flex justify-between py-1 border-b border-stone-100">
                      <span class="text-stone-700">{a.title}</span>
                      <span class="font-bold text-[#111111]">£{a.price.toFixed(2)}</span>
                    </div>
                  ))}
                  {booking.addons.length === 0 && (
                    <div class="text-stone-400 italic py-1">No additional extras selected</div>
                  )}
                </div>
              </div>

              <div>
                <h2 class="text-lg font-display font-black text-[#111111] border-b border-stone-100 pb-3 flex items-center gap-2">
                  <i class="fa-solid fa-receipt text-[#7D6E23]"></i> Payment Summary
                </h2>
                <div class="mt-4 space-y-2.5 text-xs">
                  <div class="flex justify-between">
                    <span class="text-stone-500">Total Stay Package Value:</span>
                    <span class="font-bold text-[#111111]">£{booking.totalRentalPrice.toFixed(2)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-stone-500">Deposit Paid Today ({booking.depositPercent}%):</span>
                    <span class="font-bold text-[#111111]">£{booking.depositAmount.toFixed(2)}</span>
                  </div>
                  <div class="flex justify-between">
                    <span class="text-stone-500">Refundable Security Deposit:</span>
                    <span class="font-bold text-[#111111]">£{booking.securityDeposit.toFixed(2)}</span>
                  </div>

                  <!-- Grand Paid Box -->
                  <div class="bg-[#FAF7EE] p-4 rounded-2xl border border-stone-200 flex justify-between items-center my-3">
                    <span class="font-display font-extrabold text-sm text-[#111111]">Total Paid Today (Stripe)</span>
                    <span class="text-xl font-display font-black text-[#111111]">£{booking.totalPaidToday.toFixed(2)}</span>
                  </div>

                  {booking.remainingBalance > 0 && (
                    <div class="bg-amber-50 p-3.5 rounded-xl border border-amber-200 text-[#7D6E23] text-xs">
                      <div class="flex justify-between font-bold">
                        <span>Remaining 50% Balance:</span>
                        <span>£{booking.remainingBalance.toFixed(2)}</span>
                      </div>
                      <span class="text-[11px] text-stone-600 block mt-1">
                        Due 28 days prior to check-in ({booking.balanceDueDate || '28 days before arrival'}). An automated payment link will be sent to your email.
                      </span>
                    </div>
                  )}

                  <div class="text-[11px] text-stone-500 bg-stone-50 p-3 rounded-xl border border-stone-200 flex items-start gap-2">
                    <i class="fa-solid fa-shield-halved text-[#7D6E23] mt-0.5 shrink-0"></i>
                    <span>
                      The £200.00 security deposit will be released back to your payment card within 48 hours following checkout inspection.
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

          {
            booking && isDiyFulfillment(booking.fulfillment) && (
              <div class="bg-white rounded-3xl p-6 md:p-8 shadow-md border border-stone-200">
                <h2 class="text-lg font-display font-black text-[#111111] border-b border-stone-100 pb-3 flex items-center gap-2">
                  <i class="fa-solid fa-warehouse text-[#7D6E23]"></i> Collection — Falkirk container
                </h2>
                <div class="mt-4 space-y-3 text-sm">
                  <p class="text-stone-600 text-xs leading-relaxed">
                    Pickup and return: <strong class="text-[#111111]">{diyCollection.hours}</strong>. {diyCollection.hoursNote}
                  </p>
                  <div class="flex flex-wrap gap-2">
                    {diyCollection.hasPin ? (
                      <a
                        href={diyCollection.w3wUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center gap-2 rounded-full bg-[#FAF7EE] border border-[#7D6E23]/30 px-4 py-2 text-xs font-bold text-[#4F571A]"
                      >
                        <i class="fa-solid fa-location-dot"></i>
                        What3Words: {diyCollection.w3w}
                      </a>
                    ) : (
                      <span class="inline-flex items-center gap-2 rounded-full bg-stone-50 border border-stone-200 px-4 py-2 text-xs font-bold text-stone-600">
                        What3Words pin to follow by email
                      </span>
                    )}
                    <a
                      href={diyCollection.mapsUrl}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex items-center gap-2 rounded-full bg-[#111111] text-white px-4 py-2 text-xs font-bold"
                    >
                      <i class="fa-brands fa-google"></i>
                      Google Maps
                    </a>
                  </div>
                </div>
              </div>
            )
          }

          <!-- What Happens Next Section -->
          <div class="bg-white rounded-3xl p-6 md:p-8 shadow-md border border-stone-200">
            <h2 class="text-xl font-display font-black text-[#111111] mb-6 flex items-center gap-2">
              <i class="fa-solid fa-route text-[#7D6E23]"></i> What Happens Next?
            </h2>
            <div class="grid sm:grid-cols-3 gap-6">
              <div class="p-4 rounded-2xl bg-stone-50 border border-stone-100">
                <div class="w-8 h-8 rounded-full bg-[#111111] text-[#F7BA1E] flex items-center justify-center font-display font-black text-xs mb-3">1</div>
                <h3 class="font-display font-bold text-sm text-[#111111] mb-1">Check Your Email</h3>
                <p class="text-xs text-stone-500 leading-relaxed">
                  We've sent full booking confirmation and itemized VAT receipt to <strong>{booking.customerEmail}</strong>.
                </p>
              </div>

              <div class="p-4 rounded-2xl bg-stone-50 border border-stone-100">
                <div class="w-8 h-8 rounded-full bg-[#111111] text-[#F7BA1E] flex items-center justify-center font-display font-black text-xs mb-3">2</div>
                <h3 class="font-display font-bold text-sm text-[#111111] mb-1">Logistics & Gear Check</h3>
                <p class="text-xs text-stone-500 leading-relaxed">
                  Our team reserves and tests your {booking.tentType} canvas, bedding package, and requested accessories.
                </p>
              </div>

              <div class="p-4 rounded-2xl bg-stone-50 border border-stone-100">
                <div class="w-8 h-8 rounded-full bg-[#111111] text-[#F7BA1E] flex items-center justify-center font-display font-black text-xs mb-3">3</div>
                <h3 class="font-display font-bold text-sm text-[#111111] mb-1">48h Pitching Contact</h3>
                <p class="text-xs text-stone-500 leading-relaxed">
                  48 hours prior to arrival, our pitching crew will contact {booking.customerPhone} to coordinate pitch access and key handover.
                </p>
              </div>
            </div>

            <div class="mt-8 pt-6 border-t border-stone-100 flex flex-wrap justify-between items-center gap-4">
              <a
                href="/"
                class="inline-flex items-center gap-2 text-xs font-display font-extrabold uppercase tracking-wider text-stone-700 hover:text-stone-900 transition"
              >
                <i class="fa-solid fa-arrow-left"></i> Return to Homepage
              </a>

              <a
                href="/campsites"
                class="bg-[#111111] text-[#F7BA1E] px-6 py-3 rounded-xl font-display font-bold text-xs uppercase tracking-wider hover:bg-stone-800 transition inline-flex items-center gap-2"
              >
                <span>Explore Campsite Guides</span>
                <i class="fa-solid fa-arrow-right"></i>
              </a>
            </div>
          </div>
        </div>
      ) : (
        <div class="bg-white rounded-3xl p-8 shadow-md border border-stone-200 text-center max-w-lg mx-auto space-y-4">
          <i class="fa-solid fa-circle-question text-4xl text-stone-400"></i>
          <h2 class="text-xl font-display font-bold text-stone-800">No Active Booking Session Found</h2>
          <p class="text-xs text-stone-500 leading-relaxed">
            {errorMsg || "If you recently completed a booking, please check your email for your confirmation receipt."}
          </p>
          <div class="pt-4">
            <a
              href="/booking"
              class="bg-[#111111] text-[#F7BA1E] px-6 py-3 rounded-xl font-display font-bold text-xs uppercase tracking-wider hover:bg-stone-800 transition inline-block"
            >
              Go to Booking Configurator
            </a>
          </div>
        </div>
      )}
    </div>
  </section>
</Layout>
