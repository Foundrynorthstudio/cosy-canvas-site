---
import Layout from "../layouts/Layout.astro";
import { cosyHolidaysSites } from "../lib/campsites";
import { getAllBookings } from "../lib/booking-store";
import { takenDurnessMonthKeys, upcomingDurnessSlots } from "../lib/durness";

const publishableKey = import.meta.env.PUBLIC_STRIPE_PUBLISHABLE_KEY || "";
const holidaysSites = cosyHolidaysSites();
const durnessSlots = upcomingDurnessSlots(takenDurnessMonthKeys(await getAllBookings()));
---

<Layout
    title="Configure Your Stay & Book Online | The Cosy Canvas Co."
    description="Instantly configure your Scottish bell tent stay. Select guest capacity, rental dates, bedding tiers, and camp add-ons with real-time pricing."
>
    <!-- Header Banner -->
    <div
        class="bg-[#111111] text-white py-12 md:py-16 border-b border-stone-800 relative z-30"
    >
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <span
                class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest block mb-2 font-bold"
                >INSTANT ONLINE CONFIGURATOR</span
            >
            <h1 class="font-display text-3xl md:text-5xl font-black text-white">
                Configure Your Stay & Book
            </h1>
            <p
                class="text-stone-400 text-sm md:text-base mt-2 max-w-2xl font-light leading-relaxed"
            >
                Select your guests, rental dates, bedding, and camp extras below
                for instant pricing and date reservation.
            </p>
        </div>
    </div>

    <!-- Configurator Section -->
    <section class="py-12 md:py-20 border-b border-stone-200/80 relative z-20">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Side-by-Side Flex Wrapper -->
            <div
                style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: flex-start;"
            >
                <!-- Left Configurator Steps (58% Width on Desktop) -->
                <div
                    style="flex: 1 1 500px; min-width: 320px;"
                    class="space-y-8"
                >
                    <!-- STEP 1: Guests & Dates -->
                    <div
                        style="background-color: #ffffff;"
                        class="p-6 md:p-8 rounded-3xl shadow-md border border-stone-200"
                    >
                        <div
                            class="flex items-center justify-between mb-6 border-b border-stone-100 pb-4"
                        >
                            <h2
                                class="text-xl md:text-2xl font-display font-black text-[#111111] flex items-center"
                            >
                                <span
                                    class="w-8 h-8 rounded-full bg-[#F7BA1E] text-[#111111] text-sm flex items-center justify-center font-display font-black mr-3 shadow-xs"
                                    >1</span
                                >
                                Guests & Rental Dates
                            </h2>
                            <span
                                id="nights-badge"
                                class="bg-[#111111] text-[#F7BA1E] text-xs font-display font-bold px-3.5 py-1 rounded-full uppercase tracking-wider"
                            >
                                2 Nights Stay
                            </span>
                        </div>

                        <!-- 2027 Early Bird Offer Banner -->
                        <div
                            class="mb-5 bg-emerald-50 border border-[#7D6E23]/20 rounded-2xl p-3.5 text-xs text-[#4F571A] flex items-center justify-between gap-2"
                        >
                            <div class="flex items-center gap-2">
                                <i
                                    class="fa-solid fa-circle-check text-[#7D6E23] text-sm"
                                ></i>
                                <span
                                    ><strong>2027 Season Early Bird:</strong> Select
                                    any 2027 date for <strong>15% Off</strong> package
                                    rates!</span
                                >
                            </div>
                            <span
                                class="os-grid-badge text-[10px] px-2 py-0.5 rounded font-bold uppercase shrink-0"
                                >15% Off 2027</span
                            >
                        </div>

                        <div class="grid md:grid-cols-2 gap-6">
                            <!-- Guest Selector -->
                            <div class="flex flex-col justify-between">
                                <div>
                                    <label
                                        class="block text-xs font-display font-black uppercase tracking-wider mb-2 text-stone-700"
                                    >
                                        Number of Guests
                                    </label>
                                    <div
                                        class="flex items-center border-2 border-stone-200 rounded-2xl p-1.5 bg-stone-50"
                                    >
                                        <button
                                            type="button"
                                            id="btn-guest-minus"
                                            class="w-10 h-10 rounded-xl bg-white hover:bg-[#F7BA1E] transition font-bold text-stone-800 flex items-center justify-center text-base shadow-xs"
                                        >
                                            <i class="fa-solid fa-minus text-xs"
                                            ></i>
                                        </button>
                                        <div
                                            class="flex-1 text-center font-display font-black text-xl text-[#111111]"
                                            id="guest-count-display"
                                        >
                                            2 Guests
                                        </div>
                                        <button
                                            type="button"
                                            id="btn-guest-plus"
                                            class="w-10 h-10 rounded-xl bg-white hover:bg-[#F7BA1E] transition font-bold text-stone-800 flex items-center justify-center text-base shadow-xs"
                                        >
                                            <i class="fa-solid fa-plus text-xs"
                                            ></i>
                                        </button>
                                    </div>
                                </div>
                                <p
                                    class="text-[11px] text-stone-500 mt-3 flex items-center gap-1.5 font-medium"
                                >
                                    <i
                                        class="fa-solid fa-circle-info text-[#7D6E23]"
                                    ></i> 1–3: 4M (£50/n) | 4–6: 5M (£75/n) | 7–8:
                                    6M (£100/n)
                                </p>
                            </div>

                            <!-- Date Picker -->
                            <div>
                                <label
                                    class="block text-xs font-display font-black uppercase tracking-wider mb-2 text-stone-700"
                                >
                                    Rental Dates <span
                                        class="text-stone-400 font-normal"
                                        >(Min 2 Nights)</span
                                    >
                                </label>
                                <div class="grid grid-cols-2 gap-2">
                                    <div>
                                        <span
                                            class="text-[10px] uppercase font-bold text-stone-400 block mb-1"
                                            >Check-In</span
                                        >
                                        <input
                                            type="date"
                                            id="checkin-date"
                                            class="w-full bg-stone-50 border-2 border-stone-200 rounded-xl p-2.5 text-xs font-bold text-stone-800 focus:border-[#F7BA1E] focus:outline-none"
                                        />
                                    </div>
                                    <div>
                                        <span
                                            class="text-[10px] uppercase font-bold text-stone-400 block mb-1"
                                            >Check-Out</span
                                        >
                                        <input
                                            type="date"
                                            id="checkout-date"
                                            class="w-full bg-stone-50 border-2 border-stone-200 rounded-xl p-2.5 text-xs font-bold text-stone-800 focus:border-[#F7BA1E] focus:outline-none"
                                        />
                                    </div>
                                </div>
                                <div
                                    id="discount-banner"
                                    class="mt-2.5 text-[11px] font-bold text-[#7D6E23] flex items-center gap-1"
                                >
                                    <i class="fa-solid fa-tag"></i>
                                    <span id="discount-banner-text"
                                        >Standard 2-Night Rate (0% Discount)</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 2: Tent Allocation -->
                    <div
                        style="background-color: #ffffff;"
                        class="p-6 md:p-8 rounded-3xl shadow-md border border-stone-200"
                    >
                        <div
                            class="flex items-center justify-between mb-6 border-b border-stone-100 pb-4"
                        >
                            <h2
                                class="text-xl md:text-2xl font-display font-black text-[#111111] flex items-center"
                            >
                                <span
                                    class="w-8 h-8 rounded-full bg-[#F7BA1E] text-[#111111] text-sm flex items-center justify-center font-display font-black mr-3 shadow-xs"
                                    >2</span
                                >
                                Tent Allocation
                            </h2>
                            <span
                                class="text-xs text-[#7D6E23] font-display font-bold uppercase tracking-wider bg-[#7D6E23]/10 px-3 py-1 rounded-full"
                            >
                                Auto-selected for capacity
                            </span>
                        </div>

                        <div class="grid md:grid-cols-3 gap-4">
                            <div
                                id="tent-card-4m"
                                class="p-5 rounded-2xl border-2 border-stone-200 bg-white transition relative"
                            >
                                <div
                                    class="flex justify-between items-start mb-2"
                                >
                                    <div>
                                        <h3
                                            class="text-lg font-display font-bold text-[#111111]"
                                        >
                                            4M Bell Tent
                                        </h3>
                                        <span
                                            class="text-[11px] font-display font-bold uppercase tracking-wider text-[#7D6E23] block mt-0.5"
                                            >1 to 3 Guests</span
                                        >
                                    </div>
                                    <span
                                        class="font-display font-black text-xl text-[#111111]"
                                        >£50 <span
                                            class="text-xs text-stone-500 font-sans font-medium"
                                            >/n</span
                                        ></span
                                    >
                                </div>
                                <p
                                    class="text-xs text-stone-500 leading-relaxed mb-3"
                                >
                                    Compact & cozy waterproof canvas.
                                </p>
                                <div
                                    class="flex justify-between items-center pt-2 border-t border-stone-100"
                                >
                                    <span
                                        class="text-[11px] text-stone-400 font-medium"
                                        >Subtotal:</span
                                    >
                                    <span
                                        id="price-tent-4m-calc"
                                        class="font-display font-bold text-xs text-[#111111]"
                                        >£100</span
                                    >
                                </div>
                            </div>

                            <div
                                id="tent-card-5m"
                                class="p-5 rounded-2xl border-2 border-stone-200 bg-white transition relative"
                            >
                                <div
                                    class="flex justify-between items-start mb-2"
                                >
                                    <div>
                                        <h3
                                            class="text-lg font-display font-bold text-[#111111]"
                                        >
                                            5M Bell Tent
                                        </h3>
                                        <span
                                            class="text-[11px] font-display font-bold uppercase tracking-wider text-[#7D6E23] block mt-0.5"
                                            >4 to 6 Guests</span
                                        >
                                    </div>
                                    <span
                                        class="font-display font-black text-xl text-[#111111]"
                                        >£75 <span
                                            class="text-xs text-stone-500 font-sans font-medium"
                                            >/n</span
                                        ></span
                                    >
                                </div>
                                <p
                                    class="text-xs text-stone-500 leading-relaxed mb-3"
                                >
                                    Mid-sized glamping layout.
                                </p>
                                <div
                                    class="flex justify-between items-center pt-2 border-t border-stone-100"
                                >
                                    <span
                                        class="text-[11px] text-stone-400 font-medium"
                                        >Subtotal:</span
                                    >
                                    <span
                                        id="price-tent-5m-calc"
                                        class="font-display font-bold text-xs text-[#111111]"
                                        >£150</span
                                    >
                                </div>
                            </div>

                            <div
                                id="tent-card-6m"
                                class="p-5 rounded-2xl border-2 border-stone-200 bg-white transition relative"
                            >
                                <div
                                    class="flex justify-between items-start mb-2"
                                >
                                    <div>
                                        <h3
                                            class="text-lg font-display font-bold text-[#111111]"
                                        >
                                            6M Cathedral
                                        </h3>
                                        <span
                                            class="text-[11px] font-display font-bold uppercase tracking-wider text-[#7D6E23] block mt-0.5"
                                            >7 to 8 Guests</span
                                        >
                                    </div>
                                    <span
                                        class="font-display font-black text-xl text-[#111111]"
                                        >£100 <span
                                            class="text-xs text-stone-500 font-sans font-medium"
                                            >/n</span
                                        ></span
                                    >
                                </div>
                                <p
                                    class="text-xs text-stone-500 leading-relaxed mb-3"
                                >
                                    Ultra-spacious canvas palace.
                                </p>
                                <div
                                    class="flex justify-between items-center pt-2 border-t border-stone-100"
                                >
                                    <span
                                        class="text-[11px] text-stone-400 font-medium"
                                        >Subtotal:</span
                                    >
                                    <span
                                        id="price-tent-6m-calc"
                                        class="font-display font-bold text-xs text-[#111111]"
                                        >£200</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 3: Bedding Options -->
                    <div
                        style="background-color: #ffffff;"
                        class="p-6 md:p-8 rounded-3xl shadow-md border border-stone-200"
                    >
                        <div
                            class="flex items-center justify-between mb-6 border-b border-stone-100 pb-4"
                        >
                            <h2
                                class="text-xl md:text-2xl font-display font-black text-[#111111] flex items-center"
                            >
                                <span
                                    class="w-8 h-8 rounded-full bg-[#F7BA1E] text-[#111111] text-sm flex items-center justify-center font-display font-black mr-3 shadow-xs"
                                    >3</span
                                >
                                Bedding & Comfort Setup
                            </h2>
                            <span
                                class="text-xs text-stone-500 font-display font-bold uppercase tracking-wider"
                                >Flat Fee Per Guest</span
                            >
                        </div>

                        <div class="grid md:grid-cols-3 gap-4">
                            <div
                                data-bedding="none"
                                id="bedding-none"
                                class="bedding-card cursor-pointer p-5 rounded-2xl border-2 border-stone-200 bg-stone-50 hover:border-[#F7BA1E] transition text-left flex flex-col justify-between"
                            >
                                <div>
                                    <span
                                        class="block text-xs font-display font-extrabold uppercase text-stone-400 mb-1"
                                        >DIY Sleeping</span
                                    >
                                    <h3
                                        class="text-base font-display font-bold text-[#111111] mb-2"
                                    >
                                        No Bedding
                                    </h3>
                                    <p
                                        class="text-xs text-stone-500 leading-relaxed"
                                    >
                                        Bring your own sleeping bags & mats.
                                    </p>
                                </div>
                                <div
                                    class="mt-4 pt-3 border-t border-stone-200/60 flex justify-between items-center"
                                >
                                    <span
                                        class="font-display font-extrabold text-[#111111]"
                                        >Free</span
                                    >
                                    <span
                                        class="text-[10px] text-stone-400 uppercase font-bold"
                                        >£0</span
                                    >
                                </div>
                            </div>

                            <div
                                data-bedding="essentials"
                                id="bedding-essentials"
                                class="bedding-card cursor-pointer p-5 rounded-2xl border-2 border-stone-200 bg-stone-50 hover:border-[#F7BA1E] transition text-left flex flex-col justify-between"
                            >
                                <div>
                                    <span
                                        class="block text-xs font-display font-extrabold uppercase text-[#7D6E23] mb-1"
                                        >Comfort Starter</span
                                    >
                                    <h3
                                        class="text-base font-display font-bold text-[#111111] mb-2"
                                    >
                                        Essentials
                                    </h3>
                                    <p
                                        class="text-xs text-stone-500 leading-relaxed"
                                    >
                                        Raised air frame mattresses.
                                    </p>
                                </div>
                                <div
                                    class="mt-4 pt-3 border-t border-stone-200/60 flex justify-between items-center"
                                >
                                    <span
                                        class="font-display font-extrabold text-[#111111]"
                                        >£25 <span
                                            class="text-[10px] font-sans font-normal text-stone-500"
                                            >/guest</span
                                        ></span
                                    >
                                    <span
                                        id="calc-bedding-essentials"
                                        class="text-xs font-display font-bold text-[#7D6E23]"
                                        >£50 Total</span
                                    >
                                </div>
                            </div>

                            <div
                                data-bedding="cosy"
                                id="bedding-cosy"
                                class="bedding-card cursor-pointer p-5 rounded-2xl border-2 border-[#F7BA1E] bg-amber-50/50 hover:border-[#F7BA1E] transition text-left flex flex-col justify-between"
                            >
                                <div>
                                    <span
                                        class="block text-xs font-display font-extrabold uppercase text-[#7D6E23] mb-1"
                                        >Full Luxury</span
                                    >
                                    <h3
                                        class="text-base font-display font-bold text-[#111111] mb-2"
                                    >
                                        Cosy Camping
                                    </h3>
                                    <p
                                        class="text-xs text-stone-500 leading-relaxed"
                                    >
                                        Air frames + hotel duvets & fresh
                                        linens.
                                    </p>
                                </div>
                                <div
                                    class="mt-4 pt-3 border-t border-stone-200/60 flex justify-between items-center"
                                >
                                    <span
                                        class="font-display font-extrabold text-[#111111]"
                                        >£35 <span
                                            class="text-[10px] font-sans font-normal text-stone-500"
                                            >/guest</span
                                        ></span
                                    >
                                    <span
                                        id="calc-bedding-cosy"
                                        class="text-xs font-display font-bold text-[#7D6E23]"
                                        >£70 Total</span
                                    >
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- STEP 4: All 8 Camp Add-ons -->
                    <div
                        style="background-color: #ffffff;"
                        class="p-6 md:p-8 rounded-3xl shadow-md border border-stone-200"
                    >
                        <div
                            class="flex items-center justify-between mb-6 border-b border-stone-100 pb-4"
                        >
                            <h2
                                class="text-xl md:text-2xl font-display font-black text-[#111111] flex items-center"
                            >
                                <span
                                    class="w-8 h-8 rounded-full bg-[#F7BA1E] text-[#111111] text-sm flex items-center justify-center font-display font-black mr-3 shadow-xs"
                                    >4</span
                                >
                                Camp Add-ons & Gear
                            </h2>
                            <span
                                class="text-xs text-stone-500 font-display font-bold uppercase tracking-wider"
                                >Select Extras</span
                            >
                        </div>

                        <div class="grid md:grid-cols-2 gap-4">
                            <label
                                id="addon-label-kitchen"
                                class="addon-box flex items-start p-4 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white cursor-pointer transition"
                            >
                                <input
                                    type="checkbox"
                                    id="addon-kitchen"
                                    class="mt-1 w-5 h-5 accent-[#F7BA1E] rounded"
                                />
                                <div class="ml-3 flex-1">
                                    <div
                                        class="flex justify-between items-center mb-1"
                                    >
                                        <span
                                            class="font-display font-bold text-sm text-[#111111]"
                                            >Cosy Kitchen Setup</span
                                        >
                                        <span
                                            class="text-xs font-display font-extrabold text-[#7D6E23]"
                                            >£40 + £5/g</span
                                        >
                                    </div>
                                    <p class="text-xs text-stone-500">
                                        Gas stove, cookware, kettle, tableware &
                                        coolbox for <span
                                            class="guest-label font-bold text-stone-700"
                                            >2</span
                                        > guests.
                                    </p>
                                </div>
                            </label>

                            <label
                                id="addon-label-living"
                                class="addon-box flex items-start p-4 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white cursor-pointer transition"
                            >
                                <input
                                    type="checkbox"
                                    id="addon-living"
                                    class="mt-1 w-5 h-5 accent-[#F7BA1E] rounded"
                                />
                                <div class="ml-3 flex-1">
                                    <div
                                        class="flex justify-between items-center mb-1"
                                    >
                                        <span
                                            class="font-display font-bold text-sm text-[#111111]"
                                            >Cosy Living Lounge</span
                                        >
                                        <span
                                            class="text-xs font-display font-extrabold text-[#7D6E23]"
                                            >£65 flat</span
                                        >
                                    </div>
                                    <p class="text-xs text-stone-500">
                                        Power system, cinema projector,
                                        Bluetooth speaker, LED & fairy lights.
                                    </p>
                                </div>
                            </label>

                            <label
                                id="addon-label-woodburner"
                                class="addon-box flex items-start p-4 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white cursor-pointer transition"
                            >
                                <input
                                    type="checkbox"
                                    id="addon-woodburner"
                                    class="mt-1 w-5 h-5 accent-[#F7BA1E] rounded"
                                />
                                <div class="ml-3 flex-1">
                                    <div
                                        class="flex justify-between items-center mb-1"
                                    >
                                        <span
                                            class="font-display font-bold text-sm text-[#111111]"
                                            >Indoor Wood Burner</span
                                        >
                                        <span
                                            class="text-xs font-display font-extrabold text-[#7D6E23]"
                                            >£40 flat</span
                                        >
                                    </div>
                                    <p class="text-xs text-stone-500">
                                        Wood-burning tent stove with chimney
                                        flue, hearth mat & starter basket.
                                    </p>
                                </div>
                            </label>

                            <label
                                id="addon-label-awning"
                                class="addon-box flex items-start p-4 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white cursor-pointer transition"
                            >
                                <input
                                    type="checkbox"
                                    id="addon-awning"
                                    class="mt-1 w-5 h-5 accent-[#F7BA1E] rounded"
                                />
                                <div class="ml-3 flex-1">
                                    <div
                                        class="flex justify-between items-center mb-1"
                                    >
                                        <span
                                            class="font-display font-bold text-sm text-[#111111]"
                                            >Outdoor Awning Porch</span
                                        >
                                        <span
                                            class="text-xs font-display font-extrabold text-[#7D6E23]"
                                            >£30 flat</span
                                        >
                                    </div>
                                    <p class="text-xs text-stone-500">
                                        Sheltered entrance awning for boots,
                                        gear & rain-protected lounging.
                                    </p>
                                </div>
                            </label>

                            <label
                                id="addon-label-chairs"
                                class="addon-box flex items-start p-4 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white cursor-pointer transition"
                            >
                                <input
                                    type="checkbox"
                                    id="addon-chairs"
                                    class="mt-1 w-5 h-5 accent-[#F7BA1E] rounded"
                                />
                                <div class="ml-3 flex-1">
                                    <div
                                        class="flex justify-between items-center mb-1"
                                    >
                                        <span
                                            class="font-display font-bold text-sm text-[#111111]"
                                            >Indoor & Outdoor Chairs</span
                                        >
                                        <span
                                            class="text-xs font-display font-extrabold text-[#7D6E23]"
                                            >£10 / guest</span
                                        >
                                    </div>
                                    <p class="text-xs text-stone-500">
                                        Cozy indoor floor lounge cushions and
                                        campfire folding chairs per guest.
                                    </p>
                                </div>
                            </label>

                            <label
                                id="addon-label-firecooking"
                                class="addon-box flex items-start p-4 rounded-2xl border border-stone-200 bg-stone-50 hover:bg-white cursor-pointer transition"
                            >
                                <input
                                    type="checkbox"
                                    id="addon-firecooking"
                                    class="mt-1 w-5 h-5 accent-[#F7BA1E] rounded"
                                />
                                <div class="ml-3 flex-1">
                                    <div
                                        class="flex justify-between items-center mb-1"
                                    >
                                        <span
                                            class="font-display font-bold text-sm text-[#111111]"
                                            >Fire Cooking Equipment</span
                                        >
                                        <span
                                            class="text-xs font-display font-extrabold text-[#7D6E23]"
                                            >£25 flat</span
                                        >
                                    </div>
                                    <p class="text-xs text-stone-500">
                                        Dutch oven, tripod fire grate, skewers &
                                        heat-resistant gloves.
                                    </p>
                                </div>
                            </label>

