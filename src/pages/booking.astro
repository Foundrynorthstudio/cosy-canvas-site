                        id="cust-requests"
                        rows="2"
                        placeholder="Estimated arrival time, bedding layout preferences, or specific pitch access notes..."
                        class="w-full bg-stone-50 border-2 border-stone-200 rounded-xl p-3 text-xs font-medium text-stone-900 focus:border-[#F7BA1E] focus:outline-none"
                    ></textarea>
                </div>

                <div id="modal-error-banner" class="hidden bg-red-50 border border-red-200 text-red-700 p-3.5 rounded-xl text-xs font-medium"></div>

                <div class="pt-2">
                    <button
                        type="submit"
                        id="btn-proceed-to-payment"
                        class="w-full bg-[#111111] text-[#F7BA1E] py-4 rounded-2xl font-display font-extrabold hover:bg-stone-800 transition uppercase tracking-wider text-xs sm:text-sm shadow-xl flex items-center justify-center gap-2 group cursor-pointer"
                    >
                        <i class="fa-solid fa-lock text-xs"></i>
                        <span>Proceed to Secure Payment</span>
                        <i class="fa-solid fa-arrow-right group-hover:translate-x-1 transition-transform"></i>
                    </button>
                </div>
                </form>
            </div>

            <!-- STEP 2: Stripe Embedded Checkout -->
            <div id="modal-step-payment" class="hidden p-6 md:p-8 space-y-4">
                <div class="flex justify-between items-center pb-3 border-b border-stone-100">
                    <button
                        type="button"
                        id="btn-back-to-details"
                        class="text-xs font-display font-bold text-stone-600 hover:text-stone-900 flex items-center gap-1.5 transition cursor-pointer"
                    >
                        <i class="fa-solid fa-arrow-left"></i> Edit Guest Details
                    </button>
                    <div class="flex items-center gap-1.5 text-xs text-emerald-700 font-bold bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200">
                        <i class="fa-solid fa-shield-halved"></i> 256-Bit Encrypted
                    </div>
                </div>

                <!-- Loading Spinner -->
                <div id="stripe-loading" class="py-12 text-center space-y-3">
                    <i class="fa-solid fa-spinner fa-spin text-3xl text-[#F7BA1E]"></i>
                    <p class="text-xs font-bold text-stone-700">Connecting to Stripe Secure Gateway...</p>
                </div>

                <!-- Stripe Checkout Mount Point -->
                <div id="stripe-embedded-checkout" class="min-h-[350px]"></div>

                <!-- Development / Fallback Notice -->
                <div id="stripe-placeholder-notice" class="hidden bg-amber-50 border border-amber-300 rounded-2xl p-5 text-xs text-[#7D6E23] space-y-3">
                    <div class="flex items-center gap-2 font-display font-bold text-sm text-[#111111]">
                        <i class="fa-solid fa-circle-info text-[#F7BA1E]"></i>
                        <span>Stripe Setup Ready</span>
                    </div>
                    <p class="text-stone-700 leading-relaxed">
                        Your booking and deposit calculations are verified! To accept live or test card payments, add your <code>STRIPE_SECRET_KEY</code> and <code>PUBLIC_STRIPE_PUBLISHABLE_KEY</code> to your <code>.env</code> file.
                    </p>
                    <div class="pt-2">
                        <a
                            id="btn-test-success"
                            href="/booking/success"
                            class="inline-block bg-[#111111] text-[#F7BA1E] px-5 py-3 rounded-xl font-display font-bold text-xs uppercase tracking-wider hover:bg-stone-800 transition"
                        >
                            Preview Booking Confirmation Page <i class="fa-solid fa-arrow-right ml-1"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<!-- Load Stripe.js for Embedded Checkout -->
<script is:inline src="https://js.stripe.com/v3/"></script>

<script is:inline>
    let bookingState = {
        guests: 2,
        nights: 2,
        checkin: "",
        checkout: "",
        tentType: "4M",
        tentPricePerNight: 50,
        bedding: "cosy",
        addons: {
            kitchen: false,
            living: false,
            woodburner: false,
            awning: false,
            chairs: false,
            firecooking: false,
            starlink: false,
            beachtoys: false,
        },
        fulfillment: "deluxe",
        partnerSiteKey: "",
        durnessSlotKey: "",
        depositPercent: 50,
        depositAmount: 0,
        securityDeposit: 200,
        totalRentalPrice: 0,
        totalDueToday: 0,
        remainingBalance: 0,
        balanceDueDate: "",
    };

    let stripeEmbeddedCheckoutInstance = null;

    function partnerSiteTitle(key) {
        const option = document.querySelector(`#partner-site option[value="${key}"]`);
        return option?.getAttribute("data-title") || option?.textContent || "";
    }

    function addDaysIso(iso, days) {
        const d = new Date(`${iso}T12:00:00`);
        d.setDate(d.getDate() + days);
        return d.toISOString().split("T")[0];
    }

    function setDateWindow(min, max) {
        const checkinEl = document.getElementById("checkin-date");
        const checkoutEl = document.getElementById("checkout-date");
        if (!checkinEl || !checkoutEl) return;
        checkinEl.min = min || "";
        checkinEl.max = max || "";
        checkoutEl.min = min ? addDaysIso(min, 2) : "";
        checkoutEl.max = max ? addDaysIso(max, 2) : "";
    }

    function renderDurnessSlots() {
        const list = document.getElementById("durness-slot-list");
        const empty = document.getElementById("durness-slot-empty");
        if (!list) return;
        const slots = JSON.parse(list.getAttribute("data-slots") || "[]");
        list.innerHTML = "";
        if (!slots.length) {
            empty?.classList.remove("hidden");
            return;
        }
        empty?.classList.add("hidden");
        slots.forEach((slot) => {
            const btn = document.createElement("button");
            btn.type = "button";
            btn.setAttribute("data-slot", slot.key);
            btn.className = slot.available
                ? "rounded-xl border-2 border-stone-200 bg-white px-3 py-2 text-left hover:border-[#F7BA1E] transition"
                : "rounded-xl border-2 border-stone-100 bg-stone-50 px-3 py-2 text-left opacity-60 cursor-not-allowed";
            btn.disabled = !slot.available;
            btn.innerHTML = slot.available
                ? `<span class="block font-display font-extrabold text-[11px] uppercase tracking-wider text-[#111111]">${slot.label}</span><span class="block text-[10px] text-stone-500 mt-0.5">Open</span>`
                : `<span class="block font-display font-extrabold text-[11px] uppercase tracking-wider text-stone-500">${slot.label}</span><span class="block text-[10px] text-stone-400 mt-0.5">Gone</span>`;
            if (slot.available) {
                btn.addEventListener("click", () => applyDurnessSlot(slot));
            }
            list.appendChild(btn);
        });
    }

    function highlightDurnessSlot(key) {
        document.querySelectorAll("#durness-slot-list [data-slot]").forEach((btn) => {
            const active = btn.getAttribute("data-slot") === key && !btn.disabled;
            btn.classList.toggle("border-[#F7BA1E]", active);
            btn.classList.toggle("bg-amber-50", active);
        });
    }

    function applyDurnessSlot(slot) {
        bookingState.durnessSlotKey = slot.key;
        setDateWindow(slot.min, slot.max);
        const checkinEl = document.getElementById("checkin-date");
        const checkoutEl = document.getElementById("checkout-date");
        if (checkinEl) checkinEl.value = slot.min;
        if (checkoutEl) checkoutEl.value = addDaysIso(slot.min, 2);
        highlightDurnessSlot(slot.key);
        updateDates();
    }

    function applyPartnerSite(key) {
        bookingState.partnerSiteKey = key || "";
        bookingState.durnessSlotKey = "";
        const conciergeRow = document.getElementById("partner-concierge-row");
        const durnessWrap = document.getElementById("durness-slot-wrap");
        const campsiteInput = document.getElementById("cust-campsite");
        if (key) {
            conciergeRow?.classList.remove("hidden");
            selectFulfillment("deluxe");
            if (campsiteInput && !campsiteInput.value.trim()) {
                campsiteInput.value = partnerSiteTitle(key);
            } else if (campsiteInput) {
                campsiteInput.value = partnerSiteTitle(key);
            }
        } else {
            conciergeRow?.classList.add("hidden");
        }
        if (key === "durness") {
            durnessWrap?.classList.remove("hidden");
            renderDurnessSlots();
        } else {
            durnessWrap?.classList.add("hidden");
            setDateWindow("", "");
        }
    }

    function changeGuests(delta) {
        let newCount = bookingState.guests + delta;
        if (newCount < 1) newCount = 1;
        if (newCount > 8) newCount = 8;
        bookingState.guests = newCount;

        document.getElementById("guest-count-display").innerText =
            `${newCount} ${newCount === 1 ? "Guest" : "Guests"}`;
        document
            .querySelectorAll(".guest-label")
            .forEach((el) => (el.innerText = newCount));

        if (newCount <= 3) {
            bookingState.tentType = "4M";
            bookingState.tentPricePerNight = 50;
        } else if (newCount <= 6) {
            bookingState.tentType = "5M";
            bookingState.tentPricePerNight = 75;
        } else {
            bookingState.tentType = "6M";
            bookingState.tentPricePerNight = 100;
        }

        updateTentCards();
        calcTotal();
    }

    function updateTentCards() {
        ["4m", "5m", "6m"].forEach((t) => {
            const card = document.getElementById(`tent-card-${t}`);
            if (card) {
                card.style.border = "2px solid #e5e7eb";
                card.style.backgroundColor = "#ffffff";
            }
        });
        const active = document.getElementById(
            `tent-card-${bookingState.tentType.toLowerCase()}`,
        );
        if (active) {
            active.style.border = "2px solid #F7BA1E";
            active.style.backgroundColor = "rgba(254, 243, 199, 0.4)";
        }
    }

    function updateDates() {
        const checkinVal = document.getElementById("checkin-date").value;
        const checkoutVal = document.getElementById("checkout-date").value;

        if (checkinVal && checkoutVal) {
            const d1 = new Date(checkinVal);
            const d2 = new Date(checkoutVal);
            let diffDays = Math.ceil((d2 - d1) / (1000 * 60 * 60 * 24));

            if (diffDays < 2) {
                diffDays = 2;
                const newCheckout = new Date(d1);
                newCheckout.setDate(newCheckout.getDate() + 2);
                document.getElementById("checkout-date").value = newCheckout
                    .toISOString()
                    .split("T")[0];
            }

            bookingState.nights = diffDays;
            bookingState.checkin = checkinVal;
            bookingState.checkout =
                document.getElementById("checkout-date").value;

            document.getElementById("nights-badge").innerText =
                `${diffDays} Nights Stay`;
            calcTotal();
        }
    }

    function selectBedding(tier) {
        bookingState.bedding = tier;
        document.querySelectorAll(".bedding-card").forEach((c) => {
            c.style.border = "2px solid #e5e7eb";
            c.style.backgroundColor = "#f9fafb";
        });
        const active = document.getElementById(`bedding-${tier}`);
        if (active) {
            active.style.border = "2px solid #F7BA1E";
            active.style.backgroundColor = "rgba(254, 243, 199, 0.5)";
        }
        calcTotal();
    }

    function selectFulfillment(method) {
        bookingState.fulfillment = method;
        document.querySelectorAll(".fulfillment-card").forEach((c) => {
            c.style.border = "2px solid #e5e7eb";
            c.style.backgroundColor = "#f9fafb";
        });
        const active = document.getElementById(`fulfillment-${method}`);
        if (active) {
            active.style.border = "2px solid #F7BA1E";
            active.style.backgroundColor = "rgba(254, 243, 199, 0.5)";
        }
        calcTotal();
    }

    function toggleAddon(key) {
        const cb = document.getElementById(`addon-${key}`);
        const label = document.getElementById(`addon-label-${key}`);
        if (cb && label) {
            bookingState.addons[key] = cb.checked;
            if (cb.checked) {
                label.style.border = "2px solid #F7BA1E";
                label.style.backgroundColor = "rgba(254, 243, 199, 0.4)";
            } else {
                label.style.border = "1px solid #e5e7eb";
                label.style.backgroundColor = "#f9fafb";
            }
            calcTotal();
        }
    }

    function calcTotal() {
        const nights = bookingState.nights;
        const guests = bookingState.guests;

        let baseTentPrice = bookingState.tentPricePerNight * nights;
        document.getElementById("summary-tent-title").innerText =
            `${bookingState.tentType} Bell Tent`;
        document.getElementById("summary-guest-detail").innerText =
            `${guests} Guests × ${nights} Nights (£${bookingState.tentPricePerNight}/n)`;
        document.getElementById("summary-tent-price").innerText =
            `£${baseTentPrice}`;

        let discountRate = 0;
        if (nights === 3) discountRate = 0.05;
        else if (nights === 4) discountRate = 0.1;
        else if (nights === 5) discountRate = 0.15;
        else if (nights >= 6) discountRate = 0.25;

        const checkinVal = document.getElementById("checkin-date").value;
        if (checkinVal && checkinVal.startsWith("2027")) {
            if (discountRate < 0.15) discountRate = 0.15;
        }

        let discountAmount = baseTentPrice * discountRate;
        let discountedTentPrice = baseTentPrice - discountAmount;

        const discRow = document.getElementById("summary-discount-row");
        if (discountRate > 0) {
            discRow.classList.remove("hidden");
            document.getElementById("summary-discount-amount").innerText =
                `-£${discountAmount.toFixed(2)}`;
            document.getElementById("discount-banner-text").innerText =
                `${discountRate * 100}% Discount Applied!`;
        } else {
            discRow.classList.add("hidden");
            document.getElementById("discount-banner-text").innerText =
                `Standard ${nights}-Night Rate (0% Discount)`;
        }

        let beddingTotal = 0;
        let beddingTitle = "DIY Sleeping (Free)";
        if (bookingState.bedding === "essentials") {
            beddingTotal = 25 * guests;
            beddingTitle = "Bedding: Essentials (£25/g)";
        } else if (bookingState.bedding === "cosy") {
            beddingTotal = 35 * guests;
            beddingTitle = "Bedding: Cosy Camping (£35/g)";
        }
        document.getElementById("summary-bedding-title").innerText =
            beddingTitle;
        document.getElementById("summary-bedding-detail").innerText =
            `${guests} Guests × flat fee`;
        document.getElementById("summary-bedding-price").innerText =
            `£${beddingTotal}`;

        let addonsTotal = 0;
        const addonsContainer = document.getElementById("summary-addons-list");
        addonsContainer.innerHTML =
            '<div class="text-[11px] font-display font-bold text-stone-400 uppercase tracking-wider">Camp Add-ons:</div>';

        const addonPrices = {
            kitchen: 40 + 5 * guests,
            living: 65,
            woodburner: 40,
            awning: 30,
            chairs: 10 * guests,
            firecooking: 25,
            starlink: 10 * nights,
            beachtoys: 20,
        };

        const addonTitles = {
            kitchen: "Cosy Kitchen Setup",
            living: "Cosy Living Lounge",
            woodburner: "Indoor Wood Burner",
            awning: "Outdoor Awning Porch",
            chairs: "Indoor & Outdoor Chairs",
            firecooking: "Fire Cooking Gear",
            starlink: "Starlink Wi-Fi",
            beachtoys: "Beach & Adventure Kit",
        };

        let hasAddons = false;
        for (let k in bookingState.addons) {
            if (bookingState.addons[k]) {
                hasAddons = true;
                let price = addonPrices[k];
                addonsTotal += price;
                addonsContainer.innerHTML += `
          <div class="flex justify-between items-center py-1">
            <span class="text-stone-700 font-medium">${addonTitles[k]}</span>
            <span class="font-bold text-stone-900">£${price}</span>
          </div>
        `;
            }
        }
        if (!hasAddons) {
            addonsContainer.innerHTML +=
                '<div class="text-stone-400 italic">No add-ons selected</div>';
        }

        let fulfillmentPrice = bookingState.fulfillment === "deluxe" ? 225 : 0;
        document.getElementById("summary-fulfillment-title").innerText =
            bookingState.fulfillment === "deluxe"
                ? "Cosy Camping Deluxe Setup"
                : "DIY Pickup (Falkirk container)";
        document.getElementById("summary-fulfillment-detail").innerText =
            bookingState.fulfillment === "deluxe"
                ? "Flat £225.00 fee for entire stay"
                : "Free depot pickup & return";
        document.getElementById("summary-fulfillment-price").innerText =
            `£${fulfillmentPrice}`;

        let totalRentalPrice =
            discountedTentPrice + beddingTotal + addonsTotal + fulfillmentPrice;
        bookingState.totalRentalPrice = totalRentalPrice;
        document.getElementById("summary-grand-total").innerText =
            `£${totalRentalPrice.toFixed(2)}`;

        // Calculate Deposit (50% if check-in >= 28 days away, 100% if < 28 days)
        const checkinDate = new Date(document.getElementById("checkin-date").value);
        const today = new Date();
        today.setHours(0, 0, 0, 0);
        const daysUntilCheckin = Math.ceil((checkinDate - today) / (1000 * 60 * 60 * 24));

        const isFiftyPercent = daysUntilCheckin >= 28;
        bookingState.depositPercent = isFiftyPercent ? 50 : 100;
        const depositAmount = isFiftyPercent ? (totalRentalPrice * 0.5) : totalRentalPrice;
        bookingState.depositAmount = depositAmount;

        const securityDeposit = 200;
        bookingState.securityDeposit = securityDeposit;

        const totalDueToday = depositAmount + securityDeposit;
        bookingState.totalDueToday = totalDueToday;

        const remainingBalance = isFiftyPercent ? (totalRentalPrice - depositAmount) : 0;
        bookingState.remainingBalance = remainingBalance;

        // Due date format
        if (isFiftyPercent) {
            const dueDate = new Date(checkinDate);
            dueDate.setDate(dueDate.getDate() - 28);
            bookingState.balanceDueDate = dueDate.toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
        } else {
            bookingState.balanceDueDate = "";
        }

        // Update UI
        document.getElementById("summary-deposit-label").innerText = `Booking Deposit (${bookingState.depositPercent}%)`;
        document.getElementById("summary-deposit-badge").innerText = isFiftyPercent ? `Booking ≥28 days in advance` : `Booking <28 days to arrival`;
        document.getElementById("summary-deposit-amount").innerText = `£${depositAmount.toFixed(2)}`;
        document.getElementById("summary-total-due-today").innerText = `£${totalDueToday.toFixed(2)}`;

        let perPersonToday = totalDueToday / guests;
        document.getElementById("summary-per-person").innerText = `Just £${perPersonToday.toFixed(2)}/guest today`;

        const remainingBox = document.getElementById("summary-remaining-box");
        const remainingText = document.getElementById("summary-remaining-text");
        if (isFiftyPercent && remainingBalance > 0) {
            remainingBox.classList.remove("hidden");
            remainingText.innerText = `Remaining 50% balance (£${remainingBalance.toFixed(2)}) due 28 days prior to check-in (${bookingState.balanceDueDate}).`;
        } else {
            remainingBox.classList.add("hidden");
        }

        document.getElementById("calc-bedding-essentials").innerText =
            `£${25 * guests} Total`;
        document.getElementById("calc-bedding-cosy").innerText =
            `£${35 * guests} Total`;
        document.getElementById("summary-stay-badge").innerText =
            `${nights} Nights`;
    }

    // Modal and Stripe Checkout Logic
    function openCheckoutModal() {
        if (bookingState.partnerSiteKey === "durness" && !bookingState.durnessSlotKey) {
            alert("Pick an open Durness month first. One stay a month, and once it is gone, it is gone.");
            return;
        }
        const campsiteInput = document.getElementById("cust-campsite");
        if (bookingState.partnerSiteKey && campsiteInput && !campsiteInput.value.trim()) {
            campsiteInput.value = partnerSiteTitle(bookingState.partnerSiteKey);
        }
        const modal = document.getElementById("checkout-modal");
        const checkin = document.getElementById("checkin-date").value;
        const checkout = document.getElementById("checkout-date").value;

        document.getElementById("modal-trip-summary").innerText =
            `${bookingState.tentType} Bell Tent | ${bookingState.nights} Nights (${checkin} to ${checkout}) | ${bookingState.guests} Guests`;
        document.getElementById("modal-due-summary").innerText =
            `£${bookingState.totalDueToday.toFixed(2)}`;

        // Reset steps
        document.getElementById("modal-step-details").classList.remove("hidden");
        document.getElementById("modal-step-payment").classList.add("hidden");
        document.getElementById("modal-error-banner").classList.add("hidden");
        document.getElementById("modal-heading").innerText = "Guest & Campsite Details";

        modal.classList.remove("hidden");
        modal.classList.add("flex");
        document.body.style.overflow = "hidden";
    }

    function closeCheckoutModal() {
        const modal = document.getElementById("checkout-modal");
        modal.classList.add("hidden");
        modal.classList.remove("flex");
        document.body.style.overflow = "auto";
    }

    async function handleProceedToPayment() {
        const errorBanner = document.getElementById("modal-error-banner");
        errorBanner.classList.add("hidden");

        const name = document.getElementById("cust-name").value.trim();
        const email = document.getElementById("cust-email").value.trim();
        const phone = document.getElementById("cust-phone").value.trim();
        const address = [
            document.getElementById("cust-address-line1").value.trim(),
            document.getElementById("cust-address-line2").value.trim(),
            document.getElementById("cust-address-city").value.trim(),
            document.getElementById("cust-address-postcode").value.trim().toUpperCase(),
            document.getElementById("cust-address-country").value === "GB"
                ? "United Kingdom"
                : document.getElementById("cust-address-country").selectedOptions[0]?.text || "",
        ].filter(Boolean).join(", ");
        const campsiteInput = document.getElementById("cust-campsite");
        if (bookingState.partnerSiteKey && campsiteInput && !campsiteInput.value.trim()) {
            campsiteInput.value = partnerSiteTitle(bookingState.partnerSiteKey);
        }
        const campsite = campsiteInput.value.trim();
        const requests = document.getElementById("cust-requests").value.trim();

        if (bookingState.partnerSiteKey === "durness" && !bookingState.durnessSlotKey) {
            errorBanner.innerText = "Pick an open Durness month in the booking summary. One stay a month — once it is gone, it is gone.";
            errorBanner.classList.remove("hidden");
            return;
        }

        if (!name || !email || !phone || !campsite) {
            errorBanner.innerText = "Please fill in all required fields (Name, Email, Phone, and Destination Campsite).";
            errorBanner.classList.remove("hidden");
            return;
        }

        const proceedBtn = document.getElementById("btn-proceed-to-payment");
        proceedBtn.disabled = true;
        proceedBtn.innerHTML = `<i class="fa-solid fa-spinner fa-spin mr-1"></i> Initializing Payment...`;

        try {
            const payload = {
                checkinDate: document.getElementById("checkin-date").value,
                checkoutDate: document.getElementById("checkout-date").value,
                guests: bookingState.guests,
                bedding: bookingState.bedding,
                fulfillment: bookingState.fulfillment,
                addons: bookingState.addons,
                customerName: name,
                customerEmail: email,
                customerPhone: phone,
                customerAddress: address,
                campsiteLocation: campsite,
                specialRequests: requests,
                partnerSiteKey: bookingState.partnerSiteKey || "",
                conciergeRequested: Boolean(bookingState.partnerSiteKey),
            };

            const response = await fetch("/api/create-checkout-session", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });

            const data = await response.json();

            if (!response.ok || !data.clientSecret) {
                if (data.isPlaceholderKey) {
                    // Show developer helper banner
                    document.getElementById("modal-step-details").classList.add("hidden");
                    document.getElementById("modal-step-payment").classList.remove("hidden");
                    document.getElementById("stripe-loading").classList.add("hidden");
                    document.getElementById("stripe-placeholder-notice").classList.remove("hidden");
                    document.getElementById("modal-heading").innerText = "Stripe Payment Preview";
                    return;
                }
                throw new Error(data.error || "Failed to initialize payment session.");
            }

            // Step 2: Mount Stripe Embedded Checkout
            document.getElementById("modal-step-details").classList.add("hidden");
            document.getElementById("modal-step-payment").classList.remove("hidden");
            document.getElementById("modal-heading").innerText = "Secure Payment";
            document.getElementById("stripe-loading").classList.remove("hidden");

            const modalEl = document.getElementById("checkout-modal");
            const pk = modalEl.getAttribute("data-stripe-pk") || "";

            if (typeof window.Stripe === "function" && pk && !pk.startsWith("pk_test_placeholder")) {
                const stripe = window.Stripe(pk);
                const checkout = stripe.createEmbeddedCheckoutPage
                    ? await stripe.createEmbeddedCheckoutPage({ clientSecret: data.clientSecret })
                    : await stripe.initEmbeddedCheckout({ clientSecret: data.clientSecret });
                document.getElementById("stripe-loading").classList.add("hidden");
                checkout.mount("#stripe-embedded-checkout");
                stripeEmbeddedCheckoutInstance = checkout;
            } else {
                document.getElementById("stripe-loading").classList.add("hidden");
                document.getElementById("stripe-placeholder-notice").classList.remove("hidden");
            }
        } catch (err) {
            console.error(err);
            errorBanner.innerText = err.message || "An unexpected error occurred. Please try again.";
            errorBanner.classList.remove("hidden");
        } finally {
            proceedBtn.disabled = false;
            proceedBtn.innerHTML = `<i class="fa-solid fa-lock text-xs mr-1"></i> Proceed to Secure Payment <i class="fa-solid fa-arrow-right ml-1"></i>`;
        }
    }

    document.addEventListener("DOMContentLoaded", () => {
        // Guest buttons
        document
            .getElementById("btn-guest-minus")
            ?.addEventListener("click", () => changeGuests(-1));
        document
            .getElementById("btn-guest-plus")
            ?.addEventListener("click", () => changeGuests(1));

        // Date inputs
        document
            .getElementById("checkin-date")
            ?.addEventListener("change", updateDates);
        document
            .getElementById("checkout-date")
            ?.addEventListener("change", updateDates);

        // Bedding cards
        document.querySelectorAll(".bedding-card").forEach((card) => {
            card.addEventListener("click", () => {
                const tier = card.getAttribute("data-bedding");
                if (tier) selectBedding(tier);
            });
        });

        // Fulfillment cards
        document.querySelectorAll(".fulfillment-card").forEach((card) => {
            card.addEventListener("click", () => {
                const method = card.getAttribute("data-fulfillment");
                if (method) selectFulfillment(method);
            });
        });

        // Addon checkboxes
        [
            "kitchen",
            "living",
            "woodburner",
            "awning",
            "chairs",
            "firecooking",
            "starlink",
            "beachtoys",
        ].forEach((key) => {
            document
                .getElementById(`addon-${key}`)
                ?.addEventListener("change", () => toggleAddon(key));
        });

        document.getElementById("partner-site")?.addEventListener("change", (event) => {
            applyPartnerSite(event.target.value);
        });

        // Book button -> Opens customer details modal
        document
            .getElementById("btn-book-now")
            ?.addEventListener("click", openCheckoutModal);

        // Modal close button & background click
        document
            .getElementById("btn-close-modal")
            ?.addEventListener("click", closeCheckoutModal);

        document
            .getElementById("checkout-modal")
            ?.addEventListener("click", (e) => {
                if (e.target.id === "checkout-modal") closeCheckoutModal();
            });

        // Proceed to Payment button inside modal
        document
            .getElementById("checkout-guest-form")
            ?.addEventListener("submit", (e) => {
                e.preventDefault();
                handleProceedToPayment();
            });

        // Back to details button inside modal
        document
            .getElementById("btn-back-to-details")
            ?.addEventListener("click", () => {
                document.getElementById("modal-step-payment").classList.add("hidden");
                document.getElementById("modal-step-details").classList.remove("hidden");
                document.getElementById("modal-heading").innerText = "Guest & Campsite Details";
            });

        // Initialize default dates
        const today = new Date();
        const tomorrow = new Date(today);
        tomorrow.setDate(tomorrow.getDate() + 1);
        const checkout = new Date(tomorrow);
        checkout.setDate(checkout.getDate() + 2);

        const checkinEl = document.getElementById("checkin-date");
        const checkoutEl = document.getElementById("checkout-date");
        if (checkinEl && checkoutEl) {
            checkinEl.value = tomorrow.toISOString().split("T")[0];
            checkoutEl.value = checkout.toISOString().split("T")[0];
        }

        updateDates();
        selectBedding("cosy");
        const params = new URLSearchParams(window.location.search);
        const fulfillment = params.get("fulfillment");
        const campsite = params.get("campsite");
        selectFulfillment(fulfillment === "diy" ? "diy" : "deluxe");
        if (campsite) {
            const campsiteInput = document.getElementById("cust-campsite");
            if (campsiteInput) campsiteInput.value = campsite;
            const match = [...document.querySelectorAll("#partner-site option")].find((option) => {
                if (!option.value) return false;
                const title = (option.getAttribute("data-title") || "").toLowerCase();
                const label = (option.textContent || "").trim().toLowerCase();
                const query = campsite.toLowerCase();
                return query === title || query === label || query.includes(label) || title.includes(query);
            });
            if (match) {
                document.getElementById("partner-site").value = match.value;
                applyPartnerSite(match.value);
            }
        }
    });
</script>

