---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="About Us & Polmont Base Depot | The Cosy Canvas Co."
  description="Discover the story behind The Cosy Canvas Co. — Scottish luxury bell tent specialists based in Polmont, Stirlingshire. Dedicated to effortless, all-weather glamping across Scotland."
  keywords="about the cosy canvas co, bell tent company scotland, polmont glamping hire, stirlingshire tent rental, scottish family camping business"
>
  <!-- Header Banner -->
  <div class="bg-[#111111] text-white py-12 md:py-16 border-b border-stone-800 relative z-30">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest block mb-2 font-bold">
        OUR STORY & SCOTTISH HERITAGE
      </span>
      <h1 class="font-display text-3xl md:text-5xl font-black text-white mb-3">
        About The Cosy Canvas Co.
      </h1>
      <p class="text-stone-300 text-sm md:text-base font-light max-w-xl mx-auto leading-relaxed">
        Born from a passion for Scotland's dramatic landscapes and a desire to make wilderness camping effortless, luxurious, and warm.
      </p>
    </div>
  </div>

  <section class="py-16 md:py-24 bg-stone-50/60 relative z-20">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
      <!-- Main Story Grid -->
      <div class="grid md:grid-cols-2 gap-12 items-center">
        <div class="space-y-6">
          <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-[#7D6E23]/10 border border-[#7D6E23]/20 text-[#4F571A] text-xs font-semibold tracking-wider uppercase">
            <span class="os-grid-badge px-2 py-0.5 rounded text-[10px]">POLMONT BASE: NS 931 785</span>
            <span>🌿 Central Scotland Hub</span>
          </div>

          <h2 class="text-3xl font-display font-black text-[#111111] leading-tight">
            Glamping Without the Hassle of Packing, Pitching, or Drying Canvas.
          </h2>

          <p class="text-sm text-stone-600 leading-relaxed">
            Scotland is home to some of the world's most breathtaking lochs, mountain glens, and coastal beaches. But traditional camping often involves hours of struggling with poles in the rain, cramming muddy gear into the car boot, and spending days drying wet tents in the living room.
          </p>

          <p class="text-sm text-stone-600 leading-relaxed">
            At <strong>The Cosy Canvas Co.</strong>, we changed all of that. We deliver, fully furnish, pitch, and collect our heavy-duty 4M, 5M, and 6M bell tents at your chosen campsite anywhere in Scotland. When your holiday is over, you simply pack your personal bags and head home — we take care of all the packdown and drying.
          </p>
        </div>

        <div class="rounded-3xl overflow-hidden shadow-2xl border border-stone-200">
          <img
            src="/cosy_canvas_hero_highland_valley_glow.jpg"
            alt="Cosy Canvas bell tent pitched in a Scottish highland glen"
            class="w-full h-auto object-cover"
            loading="lazy"
          />
        </div>
      </div>

      <!-- Core Pillars -->
      <div class="grid sm:grid-cols-3 gap-8 pt-8">
        <div class="bg-white p-8 rounded-3xl border border-stone-200 shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-[#FAF7EE] border border-[#F7BA1E]/40 text-[#7D6E23] flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-shield-halved"></i>
          </div>
          <h3 class="font-display font-bold text-lg text-[#111111]">320gsm Heavy Canvas</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            Our bell tents are made from 100% breathable, heavyweight cotton canvas, fully waterproofed and treated for fire resistance (BS 7837) against Scottish weather.
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-stone-200 shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-[#FAF7EE] border border-[#F7BA1E]/40 text-[#7D6E23] flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-truck-ramp-box"></i>
          </div>
          <h3 class="font-display font-bold text-lg text-[#111111]">Done-For-You Delivery</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            From Loch Lomond and the NC500 to garden sleepovers in Edinburgh and Glasgow, our logistics team handles all heavy lifting and setup.
          </p>
        </div>

        <div class="bg-white p-8 rounded-3xl border border-stone-200 shadow-sm space-y-3">
          <div class="w-12 h-12 rounded-2xl bg-[#FAF7EE] border border-[#F7BA1E]/40 text-[#7D6E23] flex items-center justify-center text-xl mb-4">
            <i class="fa-solid fa-leaf"></i>
          </div>
          <h3 class="font-display font-bold text-lg text-[#111111]">Leave No Trace Ethos</h3>
          <p class="text-xs text-stone-600 leading-relaxed">
            We are deeply committed to protecting Scotland's natural habitats and strictly adhere to the Scottish Outdoor Access Code and Leave No Trace principles.
          </p>
        </div>
      </div>

      <!-- Base Location Banner -->
      <div class="bg-[#111111] text-white p-8 md:p-12 rounded-3xl shadow-xl flex flex-col md:flex-row justify-between items-center gap-8">
        <div class="space-y-2 text-center md:text-left">
          <span class="text-[#F7BA1E] font-mono text-xs uppercase tracking-widest font-bold">Centrally Located</span>
          <h3 class="text-2xl md:text-3xl font-display font-black text-white">Visit Our Polmont Base Depot</h3>
          <p class="text-stone-400 text-xs sm:text-sm max-w-xl font-light">
            Conveniently situated right between Edinburgh and Glasgow in Stirlingshire, offering free DIY depot pickup or central dispatch across Scotland.
          </p>
        </div>
        <div class="shrink-0">
          <a
            href="/booking"
            class="bg-[#F7BA1E] text-[#111111] font-display font-bold text-xs uppercase tracking-wider px-8 py-4 rounded-full hover:bg-[#D4A51E] transition inline-flex items-center gap-2 shadow-lg"
          >
            <i class="fa-solid fa-tent"></i> Book Your Stay Today
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
