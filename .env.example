# Stripe API Keys (Get these from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_placeholder_key
PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder_key
STRIPE_WEBHOOK_SECRET=whsec_placeholder_secret

# Email API (Get free API key from https://resend.com)
RESEND_API_KEY=re_placeholder_key

# Business Notification Email
ADMIN_NOTIFICATION_EMAIL=bookings@cosycanvas.co.uk

# Journal & bookings studio (https://cosycanvasco.com/studio)
JOURNAL_ADMIN_PASSWORD=change-me-in-production
JOURNAL_SESSION_SECRET=change-this-session-secret
# Optional: first-time password for seeded cofounder accounts (defaults to JOURNAL_ADMIN_PASSWORD)
# STUDIO_STAFF_INITIAL_PASSWORD=
# Seeded full admins: jeremie@cosycanvasco.com, hello@cosycanvasco.com (Trystan)

# Optional: daily scheduled emails (POST /api/cron/booking-reminders with Bearer token)
# Sends any auto email whose rule is “days before check-in”
BOOKING_CRON_SECRET=

# Falkirk container What3Words (three words, e.g. filled.count.soap)
PUBLIC_DEPOT_W3W=

# Analytics (optional — defaults are already in the cookie banner)
# Swap the measurement ID in Netlify env after DNS cutover if you use a new GA4 property.
PUBLIC_GA4_MEASUREMENT_ID=G-BSY2KL4GVD
PUBLIC_META_PIXEL_ID=1255005696015025

# Google Reviews (Places API New — server only)
# 1. Google Cloud Console → enable Places API (New)
# 2. Create an API key restricted to Places API
# 3. Find Place ID: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
# Until both are set, the homepage shows the existing static guest quotes.
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACES_PLACE_ID=
